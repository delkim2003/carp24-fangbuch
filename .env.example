# ============================================================
# carp24.org — .env.example
# ALLE Werte sind PLATZHALTER — echte Secrets NUR in docs/secrets.md (nie committen!)
# Kopieren: cp .env.example .env  →  echte Werte eintragen
# ============================================================

# --- Supabase (self-hosted, Dev = Hauptserver) ---
SUPABASE_VERSION=v2.182.0          # Release-Tag pinnen (R6)
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_SUPER_SECRET   # openssl rand -base64 32
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME

# --- Auth (GoTrue) ---
GOTRUE_SITE_URL=http://localhost:8088
GOTRUE_ADDITIONAL_REDIRECT_URLS=
GOTRUE_JWT_EXPIRY=3600
GOTRUE_JWT_REFRESH_EXPIRY=604800
GOTRUE_RATE_LIMIT_EMAIL_SENT=5

# --- Storage / imgproxy (HEIC→WebP, EXIF-Strip) ---
IMGPROXY_STRIP_METADATA=true
IMGPROXY_ENABLE_WEBP_DETECTION=true

# --- Wetter (Open-Meteo, non-commercial Beta) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# --- KI (Mistral direkt, EU) ---
MISTRAL_API_KEY=CHANGE_ME
MISTRAL_MODEL=mistral-small-latest

# --- SMTP (MailerSend/Brevo Free) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@carp24.org

# --- Postgres / Session ---
PGTZ=Europe/Vienna
POSTGRES_DB=postgres

# --- Monitoring ---
PROMETHEUS_ENABLED=false
