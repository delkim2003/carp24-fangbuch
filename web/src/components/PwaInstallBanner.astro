---
/**
 * PWA Install Banner — Sofort sichtbar, plattformspezifisch.
 * - Android Chrome: beforeinstallprompt oder "Menü → App installieren"
 * - iOS Safari: "Share → Zum Home-Bildschirm"
 * - Desktop: "Menü → App installieren"
 */
---

<div id="pwa-install-banner" class="fixed bottom-0 left-0 right-0 z-50" role="dialog" aria-label="App installieren">
  <div class="max-w-lg mx-auto m-4 bg-surface-variant border border-primary/30 rounded-2xl p-5 shadow-2xl">
    <div class="flex items-center gap-4 mb-3">
      <div class="flex-shrink-0 w-12 h-12 bg-primary-container rounded-xl flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-primary-container" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </div>
      <div class="flex-grow min-w-0">
        <p class="font-headline-sm text-headline-sm text-on-surface">Carp24 installieren</p>
        <p class="text-body-sm text-on-surface-variant">Für schnellen Zugriff und Push-Benachrichtigungen</p>
      </div>
    </div>

    <!-- Anleitung (plattformspezifisch) -->
    <div id="pwa-instructions" class="bg-surface-container-low rounded-xl p-4 mb-4">
      <!-- Wird per JS befüllt -->
    </div>

    <div class="flex gap-3">
      <button id="pwa-install-btn" type="button"
        class="flex-1 bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase px-4 py-3 rounded-full hover:bg-primary hover:text-on-primary transition-colors min-h-11 whitespace-nowrap hidden">
        App installieren
      </button>
      <button id="pwa-install-dismiss" type="button"
        class="flex-1 border border-outline-variant text-on-surface font-label-sm text-label-sm uppercase px-4 py-3 rounded-full hover:bg-surface-tint transition-colors min-h-11">
        Später
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const banner = document.getElementById('pwa-install-banner');
  const instructions = document.getElementById('pwa-instructions');
  const installBtn = document.getElementById('pwa-install-btn');
  const dismissBtn = document.getElementById('pwa-install-dismiss');

  if (!banner || !instructions) return;

  // Bereits dismissed oder installiert?
  if (localStorage.getItem('pwa-install-dismissed') === 'true') {
    banner.classList.add('hidden');
    return;
  }
  if (window.matchMedia('(display-mode: standalone)').matches) {
    banner.classList.add('hidden');
    return;
  }

  const ua = navigator.userAgent;
  const isIOS = /iPad|iPhone|iPod/.test(ua) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isAndroid = /Android/.test(ua);
  const isChrome = /Chrome/.test(ua) && !/Edge/.test(ua);
  const isSafari = /Safari/.test(ua) && !/Chrome/.test(ua);

  // Plattformspezifische Anleitung
  if (isIOS && isSafari) {
    instructions.innerHTML = '<p class="text-body-sm text-on-surface mb-2"><strong>So installierst du Carp24:</strong></p>' +
      '<ol class="text-body-sm text-on-surface-variant space-y-2 list-decimal list-inside">' +
      '<li>Tippe unten auf das <strong>Teilen-Symbol</strong> <span style="font-size:18px">⬆️</span></li>' +
      '<li>Scrolle nach unten und wähle <strong>"Zum Home-Bildschirm"</strong></li>' +
      '<li>Tippe rechts oben auf <strong>"Hinzufügen"</strong></li>' +
      '</ol>';
  } else if (isAndroid && isChrome) {
    instructions.innerHTML = '<p class="text-body-sm text-on-surface mb-2"><strong>So installierst du Carp24:</strong></p>' +
      '<ol class="text-body-sm text-on-surface-variant space-y-2 list-decimal list-inside">' +
      '<li>Tippe auf das <strong>Menü (⋮)</strong> oben rechts</li>' +
      '<li>Wähle <strong>"App installieren"</strong> oder <strong>"Zum Startbildschirm hinzufügen"</strong></li>' +
      '<li>Bestätige mit <strong>"Installieren"</strong></li>' +
      '</ol>';
    // Chrome: versuche beforeinstallprompt
    installBtn.classList.remove('hidden');
    installBtn.textContent = 'Menü (⋮) → App installieren';
  } else {
    // Desktop / andere Browser
    instructions.innerHTML = '<p class="text-body-sm text-on-surface mb-2"><strong>So installierst du Carp24:</strong></p>' +
      '<ol class="text-body-sm text-on-surface-variant space-y-2 list-decimal list-inside">' +
      '<li>Klicke auf das <strong>Menü (⋮)</strong> oben rechts im Browser</li>' +
      '<li>Wähle <strong>"App installieren"</strong> oder <strong>"Zum Startbildschirm hinzufügen"</strong></li>' +
      '</ol>';
  }

  // beforeinstallprompt abfangen (Chrome/Edge)
  let deferredPrompt = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    installBtn.classList.remove('hidden');
    installBtn.textContent = 'Jetzt installieren';
  });

  installBtn.addEventListener('click', async () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === 'accepted') {
        banner.classList.add('hidden');
      }
      deferredPrompt = null;
    }
  });

  dismissBtn.addEventListener('click', () => {
    banner.classList.add('hidden');
    localStorage.setItem('pwa-install-dismissed', 'true');
  });

  window.addEventListener('appinstalled', () => {
    banner.classList.add('hidden');
    localStorage.removeItem('pwa-install-dismissed');
  });
})();
</script>
