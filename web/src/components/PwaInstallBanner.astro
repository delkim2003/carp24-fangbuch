---
/**
 * PWA Install Banner — 1-Klick-Install prominent, DSGVO-sicher.
 * - "Jetzt installieren" ist der primäre CTA (vor "Später").
 * - beforeinstallprompt (Chrome/Edge/Android): prompt() direkt auslösen.
 * - Ohne Prompt (iOS/Firefox): Button "So geht's" + kurze Anleitung.
 * - DSGVO: Modal erscheint erst nach Consent-Entscheidung (klaro-consent)
 *   bzw. erst nach erster Nutzerinteraktion — nie als Instant-Overlay.
 * - z-index (z-40) liegt UNTER dem Klaro-Consent-Banner (z-50).
 */
---

<div id="pwa-install-banner" class="fixed bottom-0 left-0 right-0 z-40 hidden" role="dialog" aria-label="App installieren">
  <div class="max-w-lg mx-auto m-4 bg-surface-variant border border-primary/30 rounded-2xl p-5 shadow-2xl">
    <div class="flex items-center gap-4 mb-3">
      <div class="flex-shrink-0 w-12 h-12 bg-primary-container rounded-xl flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-primary-container" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </div>
      <div class="flex-grow min-w-0">
        <p class="font-headline-sm text-headline-sm text-on-surface">Carp24 installieren</p>
        <p class="text-body-sm text-on-surface-variant">Für schnellen Zugriff und Push-Benachrichtigungen</p>
      </div>
    </div>

    <!-- Anleitung (plattformspezifisch, per JS befüllt) -->
    <div id="pwa-instructions" class="hidden bg-surface-container-low rounded-xl p-4 mb-4">
    </div>

    <div class="flex gap-3">
      <button id="pwa-install-btn" type="button"
        class="flex-1 bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase px-4 py-3 rounded-full hover:bg-primary hover:text-on-primary transition-colors min-h-11 whitespace-nowrap">
        Jetzt installieren
      </button>
      <button id="pwa-install-dismiss" type="button"
        class="flex-1 border border-outline-variant text-on-surface font-label-sm text-label-sm uppercase px-4 py-3 rounded-full hover:bg-surface-tint transition-colors min-h-11">
        Später
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const banner = document.getElementById('pwa-install-banner');
  const instructions = document.getElementById('pwa-instructions');
  const installBtn = document.getElementById('pwa-install-btn');
  const dismissBtn = document.getElementById('pwa-install-dismiss');

  if (!banner || !instructions || !installBtn || !dismissBtn) return;

  // Bereits dismissed oder installiert (Standalone)?
  try {
    if (localStorage.getItem('pwa-install-dismissed') === 'true') return;
  } catch (e) {}
  if (window.matchMedia('(display-mode: standalone)').matches) return;

  // Consent-Status aus der Klaro-Komponente übernehmen (DSGVO):
  // localStorage "klaro-consent" ist gesetzt, sobald der Nutzer entschieden hat.
  function consentDecided() {
    try {
      return !!localStorage.getItem('klaro-consent');
    } catch (e) {
      return false;
    }
  }

  const ua = navigator.userAgent;
  const isIOS = /iPad|iPhone|iPod/.test(ua) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  let shown = false;
  let deferredPrompt = null;

  function hideInstructions() {
    instructions.classList.add('hidden');
  }

  function showInstructions(html) {
    instructions.innerHTML = html;
    instructions.classList.remove('hidden');
  }

  // Kurzanleitung für Browser ohne Install-Prompt
  function renderManual() {
    installBtn.textContent = "So geht's";
    if (isIOS) {
      showInstructions(
        '<ol class="text-body-sm text-on-surface-variant space-y-2 list-decimal list-inside">' +
          '<li>Öffne das <strong>Teilen-Menü</strong> in der Browser-Leiste</li>' +
          '<li>Tippe auf <strong>"Zum Home-Bildschirm"</strong></li>' +
        '</ol>' +
        '<p class="text-body-sm text-on-surface-variant mt-2">Tipp: In Chrome/Edge erscheint das Install-Symbol direkt in der Adressleiste.</p>'
      );
    } else {
      showInstructions(
        '<ol class="text-body-sm text-on-surface-variant space-y-2 list-decimal list-inside">' +
          '<li>Öffne das <strong>Menü (⋮)</strong> oben rechts im Browser</li>' +
          '<li>Wähle <strong>"App installieren"</strong></li>' +
        '</ol>' +
        '<p class="text-body-sm text-on-surface-variant mt-2">Tipp: In Chrome/Edge erscheint das Install-Symbol direkt in der Adressleiste.</p>'
      );
    }
  }

  function renderDefault() {
    if (deferredPrompt) {
      // 1-Klick: Install-Prompt verfügbar
      hideInstructions();
      installBtn.textContent = 'Jetzt installieren';
    } else {
      renderManual();
    }
  }

  function showBanner() {
    if (shown) return;
    shown = true;
    banner.classList.remove('hidden');
    renderDefault();
  }

  // beforeinstallprompt abfangen (Chrome/Edge)
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    if (!deferredPrompt) {
      deferredPrompt = e;
      if (shown) renderDefault();
    }
  });

  installBtn.addEventListener('click', () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then(({ outcome }) => {
        if (outcome === 'accepted') {
          banner.classList.add('hidden');
        }
        deferredPrompt = null;
      });
      return;
    }
    // Kein Prompt (iOS/Firefox): Anleitung ein-/ausblenden
    if (instructions.classList.contains('hidden')) {
      renderManual();
    } else {
      hideInstructions();
    }
  });

  dismissBtn.addEventListener('click', () => {
    banner.classList.add('hidden');
    try {
      localStorage.setItem('pwa-install-dismissed', 'true');
    } catch (e) {}
  });

  window.addEventListener('appinstalled', () => {
    banner.classList.add('hidden');
    try {
      localStorage.removeItem('pwa-install-dismissed');
    } catch (e) {}
  });

  // DSGVO: Modal erst nach Consent-Entscheidung anzeigen ...
  if (consentDecided()) {
    showBanner();
    return;
  }

  // ... sonst erst nach erster Nutzerinteraktion (Klick/Scroll/Taste):
  // kein Instant-Overlay über dem Klaro-Consent-Banner.
  const interactions = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
  function onFirstInteraction() {
    interactions.forEach((type) => window.removeEventListener(type, onFirstInteraction));
    showBanner();
  }
  interactions.forEach((type) =>
    window.addEventListener(type, onFirstInteraction, { once: true, passive: true })
  );
})();
</script>