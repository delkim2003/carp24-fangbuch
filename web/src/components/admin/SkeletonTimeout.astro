---
// SkeletonTimeout.astro — Remove all skeleton loaders after 8 seconds
---
<script>
  setTimeout(() => {
    document.querySelectorAll('[aria-hidden="true"]').forEach(el => {
      if (el.querySelector('[class*="skeleton"], [style*="skeleton-shimmer"]')) {
        el.style.display = 'none';
      }
    });
  }, 8000);
</script>
