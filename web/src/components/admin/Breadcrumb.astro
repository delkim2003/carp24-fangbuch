---
export interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;
---

<nav class="flex items-center gap-2 text-body-sm text-on-surface-variant mb-lg" aria-label="Breadcrumb">
  {
    items.map((item, i) => (
      i < items.length - 1 ? (
        <>
          {item.href
            ? <a href={item.href} class="hover:text-primary transition-colors">{item.label}</a>
            : <span>{item.label}</span>
          }
          <svg class="w-4 h-4 text-on-surface-variant/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </>
      ) : (
        <span class="text-on-surface font-medium" aria-current="page">{item.label}</span>
      )
    ))
  }
</nav>