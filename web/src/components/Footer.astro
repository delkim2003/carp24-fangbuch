---
<footer class="w-full mt-xl border-t border-outline/20 bg-surface">
  <div class="flex flex-col md:flex-row justify-between items-center py-lg px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto gap-lg">
    <a href="/" class="flex items-center gap-2 mr-auto" aria-label="Carp24 Startseite">
      <img src="/assets/logo_carp24_badge.webp" alt="Carp24 Logo" class="h-8 w-auto" />
      <span class="font-headline-md text-headline-md text-primary hidden md:block">Carp24</span>
    </a>
    <nav class="flex flex-wrap justify-center gap-6" aria-label="Footer Navigation">
      <a class="nav-label font-label-sm text-label-sm text-on-surface-variant hover:text-primary underline decoration-primary/30 transition-all opacity-90 hover:opacity-100 uppercase" href="/impressum" data-de="Impressum" data-en="Legal">Impressum</a>
      <a class="nav-label font-label-sm text-label-sm text-on-surface-variant hover:text-primary underline decoration-primary/30 transition-all opacity-90 hover:opacity-100 uppercase" href="/datenschutz" data-de="Datenschutz" data-en="Privacy">Datenschutz</a>
    </nav>
    <span class="nav-label font-label-sm text-label-sm text-secondary md:ml-auto" data-de="© 2026 Carp24. All rights reserved." data-en="© 2026 Carp24. All rights reserved.">© 2026 Carp24. All rights reserved.</span>
  </div>
</footer>

<script is:inline>
(function () {
  var lang = localStorage.getItem("carp24-lang") || "de";
  document.querySelectorAll("footer .nav-label").forEach(function (el) {
    var txt = el.getAttribute("data-" + lang);
    if (txt) el.textContent = txt;
  });
})();
</script>
