---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KlaroBanner from "../components/KlaroBanner.astro";
import SyncIndicator from "../components/SyncIndicator.astro";

interface Props {
  title?: string;
  description?: string;
  active?: "fangbuch" | "statistik" | "preis" | "profil";
  bare?: boolean;
}

const {
  title = "Carp24 – Dein digitales Fangbuch",
  description = "Das digitale Fangbuch für Karpfenangler. Fänge erfassen, Statistiken, Community.",
  active,
  bare = false,
} = Astro.props;

// Env-Zentrale: data-Attribute am <body> (is:inline-Scripts lesen sie per dataset — Bundler-Problem umgangen)
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo_carp24_badge.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; connect-src 'self' http://100.93.250.103:8055 https:; font-src 'self' data:;" />
    <title>{title}</title>
    <!-- Matomo on-Premise (DSGVO: requireConsent blockiert bis Consent) -->
    <script>
      var _paq = (window._paq = window._paq || []);
      _paq.push(["requireConsent"]);
      _paq.push(["trackPageView"]);
      _paq.push(["enableLinkTracking"]);
      (function () {
        var u = "https://matomo.einfach-online.dev/";
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "4"]);
        var d = document,
          g = d.createElement("script"),
          s = d.getElementsByTagName("script")[0];
        g.async = true;
        g.src = u + "matomo.js";
        s.parentNode.insertBefore(g, s);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-on-surface font-body-md antialiased selection:bg-primary-container selection:text-on-primary-container" data-supabase-url={SUPABASE_URL} data-supabase-anon-key={SUPABASE_ANON_KEY}>
    {!bare && <Header active={active} />}
    <SyncIndicator />
    <main class="flex-grow flex flex-col">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <KlaroBanner />}
    <script>
      import { supabase } from "../lib/supabase-client";
      import { initErrorTracker } from "../lib/error-tracker";
      initErrorTracker(supabase);

      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
  </body>
</html>
