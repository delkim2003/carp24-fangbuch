---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Carp24 – Dein digitales Fangbuch",
  description = "Das digitale Fangbuch für Karpfenangler. Fänge erfassen, Statistiken, Community.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo_carp24_badge.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-on-surface font-body-md antialiased">
    <slot />
  </body>
</html>
