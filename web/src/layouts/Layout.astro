---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KlaroBanner from "../components/KlaroBanner.astro";
import SyncIndicator from "../components/SyncIndicator.astro";
import { getLang } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  active?: "fangbuch" | "statistik" | "rueckblick" | "trips" | "preis" | "profil" | "board" | "forum" | "chat";
  bare?: boolean;
  noindex?: boolean;
}

const {
  title = "Carp24 – Dein digitales Fangbuch",
  description = "Das digitale Fangbuch für Karpfenangler. Fänge erfassen, Statistiken, Community.",
  active,
  bare = false,
  noindex = false,
} = Astro.props;

// Env-Zentrale: data-Attribute am <body> (is:inline-Scripts lesen sie per dataset — Bundler-Problem umgangen)
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// i18n: Serverseitig "de" als Default, Client korrigiert via localStorage
const lang = getLang();
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      (function () {
        var t = localStorage.getItem("carp24-theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo_carp24_badge.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Open Graph (Social Sharing) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://carp24.org${Astro.url.pathname}`} />
    <meta property="og:image" content="https://carp24.org/assets/logo_carp24_badge.svg" />
    <meta property="og:site_name" content="Carp24" />
    <meta name="twitter:card" content="summary" />
    <!-- Canonical -->
    <link rel="canonical" href={`https://carp24.org${Astro.url.pathname}`} />
    <!-- JSON-LD: Organization + WebSite (SEO Rich Results) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Carp24",
          "url": "https://carp24.org",
          "logo": "https://carp24.org/assets/logo_carp24_badge.svg",
          "contactPoint": { "@type": "ContactPoint", "email": "info@einfach-online.dev", "contactType": "customer support" }
        },
        {
          "@type": "WebSite",
          "name": "Carp24",
          "url": "https://carp24.org",
          "description": "Das digitale Fangbuch für Karpfenangler. Fänge erfassen, Statistiken, Community.",
          "inLanguage": "de"
        }
      ]
    })} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://matomo.einfach-online.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src 'self' http://100.93.250.103:8055 https://matomo.einfach-online.dev https:; font-src 'self' data:;" />
    <title>{title}</title>
    <!-- Matomo on-Premise (DSGVO: requireConsent blockiert bis Consent) -->
    <script>
      var _paq = (window._paq = window._paq || []);
      _paq.push(["requireConsent"]);
      _paq.push(["trackPageView"]);
      _paq.push(["enableLinkTracking"]);
      (function () {
        var u = "https://matomo.einfach-online.dev/";
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "4"]);
        var d = document,
          g = d.createElement("script"),
          s = d.getElementsByTagName("script")[0];
        g.async = true;
        g.src = u + "matomo.js";
        s.parentNode.insertBefore(g, s);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-on-surface font-body-md antialiased selection:bg-primary-container selection:text-on-primary-container" data-supabase-url={SUPABASE_URL} data-supabase-anon-key={SUPABASE_ANON_KEY}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-6 focus:py-3 focus:rounded-full font-nav-item text-nav-item uppercase tracking-widest">Zum Inhalt springen</a>
    {!bare && <Header active={active} />}
    <SyncIndicator />
    <div id="main-content" tabindex="-1" class="flex-grow flex flex-col">
      <slot />
    </div>
    {!bare && <Footer />}
    {!bare && <KlaroBanner />}
    <script>
      import { supabase } from "../lib/supabase-client";
      import { createBrowserClient } from "@supabase/ssr";
      import { initErrorTracker } from "../lib/error-tracker";
      window.supabase = { createClient: createBrowserClient };
      initErrorTracker(supabase);

      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
    <script is:inline>
      (function () {
        function toggleTheme() {
          var html = document.documentElement;
          var dark = html.getAttribute("data-theme") === "dark";
          if (dark) {
            html.removeAttribute("data-theme");
          } else {
            html.setAttribute("data-theme", "dark");
          }
          localStorage.setItem("carp24-theme", dark ? "light" : "dark");
        }
        var themeBtn = document.getElementById("theme-toggle");
        var mobileThemeBtn = document.getElementById("mobile-theme-toggle");
        if (themeBtn) themeBtn.addEventListener("click", toggleTheme);
        if (mobileThemeBtn) mobileThemeBtn.addEventListener("click", toggleTheme);
      })();
    </script>
  </body>
</html>
