---
import Layout from "../layouts/Layout.astro";
import { getMaintenance } from "../lib/settings";
import { createServerClient } from "@supabase/ssr";
import { t } from "../lib/i18n";

export const prerender = false;

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const header = Astro.request.headers.get("cookie");
        if (!header) return [];
        return header
          .split(";")
          .map((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return null;
            return { name: pair.slice(0, idx).trim(), value: pair.slice(idx + 1).trim() };
          })
          .filter(Boolean) as { name: string; value: string }[];
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          Astro.cookies.set(name, value, options);
        });
      },
    },
  }
);

const maintenance = await getMaintenance(supabase);
const customMessage = maintenance.message && maintenance.message.trim().length > 0 ? maintenance.message : null;

Astro.response.status = 503;
---

<Layout title="Carp24 – Wartungsarbeiten" noindex>
  <main class="flex-grow flex flex-col items-center justify-center px-margin-mobile md:px-margin-desktop py-xl min-h-[60vh]">
    <div class="max-w-lg w-full bg-white rounded-2xl p-xl border border-outline/20 text-center">
      <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">PASSION. FISHING. COMMUNITY.</p>
      <h1 class="text-headline-lg text-on-surface mb-lg i18n" data-de={t("wartung.titel", "de")} data-en={t("wartung.titel", "en")}>{t("wartung.titel")}</h1>
      <p class="text-body-md text-on-surface-variant mb-lg i18n" data-de={t("wartung.text", "de")} data-en={t("wartung.text", "en")}>{t("wartung.text")}</p>
      {customMessage && (
        <div class="bg-primary-container text-on-primary-container rounded-xl p-lg mb-lg text-body-md">
          {customMessage}
        </div>
      )}
      <div class="flex justify-center gap-lg text-body-sm text-on-surface-variant mt-xl">
        <a href="/impressum" class="underline decoration-primary/30 hover:text-primary transition-colors i18n" data-de={t("footer.impressum", "de")} data-en={t("footer.impressum", "en")}>{t("footer.impressum")}</a>
        <a href="/datenschutz" class="underline decoration-primary/30 hover:text-primary transition-colors i18n" data-de={t("footer.datenschutz", "de")} data-en={t("footer.datenschutz", "en")}>{t("footer.datenschutz")}</a>
      </div>
    </div>
  </main>
</Layout>
