async function fetchAllMyData() {
  const { data: userData, error: userErr } = await supabase.auth.getUser();
  const user = userData?.user;

  const { data: profile, error: profileErr } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", user?.id)
    .single();

  const { data: catches, error: catchesErr } = await supabase
    .from("catches")
    .select("*")
    .order("catch_ts", { ascending: false });

  // DSGVO P0-1: Generische Sammlung aller User-Tabellen (graceful skip bei fehlender Tabelle)
  const related_data: Record<string, any[]> = {};
  const relatedTables: [string, string][] = [
    ["trips", "user_id"],
    ["user_badges", "user_id"],
    ["forum_threads", "user_id"],
    ["forum_posts", "user_id"],
    ["chat_messages", "user_id"],
    ["marketplace_items", "user_id"],
    ["push_subscriptions", "user_id"],
    ["content_reports", "reporter_id"],
  ];
  for (const [t, col] of relatedTables) {
    try {
      const { data, error } = await supabase.from(t).select("*").eq(col, user?.id);
      if (!error && data) related_data[t] = data;
    } catch {}
  }

  return {
    exported_at: new Date().toISOString(),
    user: user ? {
      id: user.id,
      email: user.email,
      created_at: user.created_at,
      user_metadata: user.user_metadata,
    } : null,
    profile: profile ?? null,
    catches: catches ?? [],
    related_data,
    errors: { user: userErr?.message ?? null, profile: profileErr?.message ?? null, catches: catchesErr?.message ?? null },
  };
}

function downloadBlob(filename: string, content: string, mime: string) {
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

function escapeCsvField(val: unknown): string {
  if (val === null || val === undefined) return "";
  const s = String(val);
  if (s.includes(";") || s.includes('"') || s.includes("\n")) {
    return '"' + s.replace(/"/g, '""') + '"';
  }
  return s;
}

function fmtDateVienna(ts: string | null | undefined): string {
  if (!ts) return "";
  const d = new Date(ts);
  return d.toLocaleString("de-AT", {
    timeZone: "Europe/Vienna",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

exportJsonBtn.addEventListener("click", async () => {
  showExportStatus("Export wird erstellt…");
  try {
    const data = await fetchAllMyData();
    const json = JSON.stringify(data, null, 2);
    const today = new Date().toISOString().slice(0, 10);
    downloadBlob(`carp24-datenexport-${today}.json`, json, "application/json");
    showExportStatus("✓ Export bereit — Download gestartet");
  } catch (err: any) {
    showExportStatus("Fehler: " + (err?.message || "Unbekannter Fehler"));
  }
});

exportCsvBtn.addEventListener("click", async () => {
  showExportStatus("Export wird erstellt…");
  try {
    const data = await fetchAllMyData();
    const header = "Datum;Gewicht_kg;Fischart;Gewaesser;Laenge_cm;Koeder;Methode;Notizen;Lat;Lng;Wetter;Foto_URLs";
    const rows = (data.catches as any[]).map((c) => {
      return [
        escapeCsvField(fmtDateVienna(c.catch_ts)),
        escapeCsvField(c.weight_kg),
        escapeCsvField(c.species),
        escapeCsvField(c.water_name),
        escapeCsvField(c.length_cm),
        escapeCsvField(c.bait),
        escapeCsvField(c.method),
        escapeCsvField(c.notes),
        escapeCsvField(c.lat),
        escapeCsvField(c.lng),
        escapeCsvField(c.weather),
        escapeCsvField(Array.isArray(c.photo_urls) ? c.photo_urls.join(" | ") : c.photo_urls),
      ].join(";");
    });
    const csv = [header, ...rows].join("\n");
    const bom = "\uFEFF";
    const today = new Date().toISOString().slice(0, 10);
    downloadBlob(`carp24-faenge-${today}.csv`, bom + csv, "text/csv;charset=utf-8");
    showExportStatus("✓ Export bereit — Download gestartet");
  } catch (err: any) {
    showExportStatus("Fehler: " + (err?.message || "Unbekannter Fehler"));
  }
});

