---
import Layout from "../layouts/Layout.astro";
import { createServerClient } from "@supabase/ssr";

export const prerender = false;

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const header = Astro.request.headers.get("cookie");
        if (!header) return [];
        return header
          .split(";")
          .map((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return null;
            return {
              name: pair.slice(0, idx).trim(),
              value: pair.slice(idx + 1).trim(),
            };
          })
          .filter(Boolean) as { name: string; value: string }[];
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          Astro.cookies.set(name, value, options);
        });
      },
    },
  }
);

const { data: { session } } = await supabase.auth.getSession();

if (!session) {
  return Astro.redirect("/login/");
}
---
<Layout title="Carp24 – KI-Assistent" active="assistent">
  <main class="flex-grow w-full max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop py-xl flex flex-col gap-xl">
    <div>
      <p class="font-kicker text-kicker uppercase tracking-widest text-secondary mb-2">CARP24</p>
      <h1 class="text-display-lg text-on-surface mb-2 i18n" data-de="KI-ANGELASSISTENT" data-en="AI FISHING ASSISTANT">KI-ANGELASSISTENT</h1>
    </div>

    <div id="chat-messages" class="flex flex-col gap-sm max-h-[60vh] overflow-y-auto bg-surface-container-high rounded-xl border border-primary/40 p-lg">
      <div class="flex items-start">
        <div class="max-w-[80%] rounded-xl px-4 py-3 text-body-md bg-surface-container-lowest text-on-surface">
          <span class="block break-words i18n" data-de="Frag mich nach deinen Fängen — z.B. 'Was war mein größter Fang?'" data-en="Ask me about your catches — e.g. 'What was my biggest catch?'">Frag mich nach deinen Fängen — z.B. 'Was war mein größter Fang?'</span>
        </div>
      </div>
    </div>

    <div class="flex gap-sm items-stretch">
      <textarea
        id="ai-input"
        maxlength="500"
        rows="1"
        data-de="Deine Frage…"
        data-en="Your question…"
        placeholder="Deine Frage…"
        class="flex-1 bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-3 px-4 min-h-11 resize-none"
        autocomplete="off"
      ></textarea>
      <button
        id="ai-send"
        type="button"
        class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm min-h-11 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed i18n"
        data-de="SENDEN"
        data-en="SEND"
      >
        SENDEN
      </button>
    </div>
    <div id="ai-error" class="hidden text-body-md text-error"></div>
    <p class="text-body-sm text-on-surface-variant i18n" data-de="Antworten werden von einer KI generiert und können Fehler enthalten." data-en="Answers are generated by AI and may contain errors.">Antworten werden von einer KI generiert und können Fehler enthalten.</p>
  </main>
</Layout>

<script is:inline>
(function () {
  var container = document.getElementById('chat-messages');
  var input = document.getElementById('ai-input');
  var sendBtn = document.getElementById('ai-send');
  var errorDiv = document.getElementById('ai-error');

  function addBubble(text, isUser) {
    var wrapper = document.createElement('div');
    wrapper.className = 'flex ' + (isUser ? 'justify-end' : 'items-start');

    var bubble = document.createElement('div');
    bubble.className = 'max-w-[80%] rounded-xl px-4 py-3 text-body-md ' +
      (isUser
        ? 'bg-primary-container text-on-primary-container'
        : 'bg-surface-container-lowest text-on-surface');

    var span = document.createElement('span');
    span.className = 'block break-words';
    span.textContent = text;
    bubble.appendChild(span);
    wrapper.appendChild(bubble);
    container.appendChild(wrapper);
    container.scrollTop = container.scrollHeight;
    return wrapper;
  }

  function showError(msg) {
    errorDiv.textContent = msg;
    errorDiv.classList.remove('hidden');
    setTimeout(function () { errorDiv.classList.add('hidden'); }, 5000);
  }

  function sendMessage() {
    var msg = input.value.trim();
    if (!msg) return;
    if (msg.length > 500) {
      showError('Maximal 500 Zeichen.');
      return;
    }

    addBubble(msg, true);
    input.value = '';
    sendBtn.disabled = true;
    errorDiv.classList.add('hidden');

    fetch('/api/ai/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg }),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          if (res.status === 503) {
            showError(data.error || 'KI ist noch nicht konfiguriert.');
          } else if (res.status === 429) {
            showError(data.error || 'Bitte kurz warten.');
          } else if (res.ok && data.answer) {
            addBubble(data.answer, false);
          } else {
            showError(data.error || 'Fehler bei der Anfrage.');
          }
        });
      })
      .catch(function () {
        showError('KI-Dienst nicht erreichbar.');
      })
      .finally(function () {
        sendBtn.disabled = false;
      });
  }

  if (sendBtn) sendBtn.addEventListener('click', sendMessage);
  if (input) input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });
})();
</script>
