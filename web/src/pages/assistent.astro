---
import Layout from "../layouts/Layout.astro";
import PremiumLock from "../components/PremiumLock.astro";

export const prerender = false;

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect("/login/");
}

let isPro = false;
let isAdmin = false;

import { createClient } from "@supabase/supabase-js";

if (session) {
  const supabaseAdmin = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY
  );
  const { data: profile } = await supabaseAdmin
    .from("profiles")
    .select("is_pro, role")
    .eq("id", session.user.id)
    .single();

  isPro = profile?.is_pro ?? false;
  isAdmin = (profile?.role ?? "") == "ADMIN";
}

const isPaid = isPro || isAdmin;
---
{!isPaid ? (
  <PremiumLock
    kicker="CARP24"
    title="KI-ASSISTENT"
    description="Der KI-Assistent ist ein Premium-Feature."
    active="assistent"
  />
) : (
  <Layout title="Carp24 – KI-Assistent" active="assistent">
    <main class="flex-grow w-full max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop py-xl flex flex-col gap-xl">
    <div>
      <p class="font-label-sm text-label-sm uppercase text-primary tracking-[0.2em] mb-2">CARP24</p>
      <h1 class="text-display-lg text-on-surface mb-2 i18n" data-de="KI-ANGELASSISTENT" data-en="AI FISHING ASSISTANT">KI-ANGELASSISTENT</h1>
    </div>

    <div class="flex flex-col gap-md mb-xl">
      <div class="flex gap-sm">
        <button
          id="best-conditions-btn"
          type="button"
          class="flex-1 bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm h-[52px] flex items-center justify-center gap-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          <span>Beste Bedingungen</span>
        </button>
        <button
          id="forecast-btn"
          type="button"
          class="flex-1 bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm h-[52px] flex items-center justify-center gap-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          <span>Fangprognose</span>
        </button>
      </div>
      
      <div id="ai-usage-counter" class="text-body-sm text-on-surface-variant opacity-70 text-center"></div>

      <div id="location-input-container" class="hidden">
        <div class="flex gap-sm items-center relative">
          <input
            id="location-input"
            type="text"
            placeholder="Standort eingeben (z.B. Budapest, Siófok, Balaton)"
            class="flex-1 bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-3 px-4 min-h-11"
            autocomplete="off"
          />
          <div id="location-suggestions" class="absolute top-full left-0 right-0 z-50 bg-surface-container-high border border-outline-variant rounded-lg shadow-lg max-h-48 overflow-y-auto hidden"></div>
          <button
            id="forecast-send-btn"
            type="button"
            class="bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm h-[52px] flex items-center gap-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
              <path d="M5.5 16.5 7.5 11 17.5 5 20 8 15 5 11 14.5Z M5.5 15.5 18.5 5.5"></path>
            </svg>
            <span>Prognose</span>
          </button>
        </div>
      </div>
    </div>

    <div id="chat-messages" class="flex flex-col gap-sm max-h-[60vh] overflow-y-auto bg-surface-container-high rounded-xl border border-primary/40 p-lg">
      <div class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-lg bg-surface-variant border border-primary/10 text-primary flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]" aria-hidden="true">
            <path d="M12 5v-2.2"></path>
            <circle cx="12" cy="2.6" r="1.4"></circle>
            <rect x="4.5" y="5" width="15" height="12.5" rx="3.5"></rect>
            <rect x="8.5" y="9.5" width="4" height="4" rx="1.2"></rect>
            <rect x="13.5" y="9.5" width="4" height="4" rx="1.2"></rect>
            <path d="M10 15.8h5"></path>
          </svg>
        </div>
        <div class="max-w-[80%] bg-surface-variant rounded-2xl rounded-tl-sm px-5 py-4 text-body-md text-on-surface border border-primary/10 shadow-sm">
          <span class="block break-words i18n" data-de="Frag mich nach deinen Fängen — z.B. 'Was war mein größter Fang?'" data-en="Ask me about your catches — e.g. 'What was my biggest catch?'">Frag mich nach deinen Fängen — z.B. 'Was war mein größter Fang?'</span>
        </div>
      </div>
    </div>

    <div class="flex gap-sm items-stretch">
      <textarea
        id="ai-input"
        maxlength="500"
        rows="1"
        data-i18n-placeholder-de="Deine Frage…"
        data-i18n-placeholder-en="Your question…"
        placeholder="Deine Frage…"
        class="flex-1 bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-3 px-4 min-h-11 resize-none"
        autocomplete="off"
      ></textarea>
      <button
        id="ai-send"
        type="button"
        class="bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm h-[52px] flex items-center gap-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
          <path d="M5.5 16.5 7.5 11 17.5 5 20 8 15 5 11 14.5Z M5.5 15.5 18.5 5.5"></path>
        </svg>
        <span class="i18n" data-de="SENDEN" data-en="SEND">SENDEN</span>
      </button>
    </div>
    <div id="ai-error" class="hidden text-body-md text-error"></div>
    <p class="text-body-sm text-on-surface-variant i18n" data-de="Antworten werden von einer KI generiert und können Fehler enthalten." data-en="Answers are generated by AI and may contain errors.">Antworten werden von einer KI generiert und können Fehler enthalten.</p>
  </main>
</Layout>
)}

<script is:inline>
(function () {
  var container = document.getElementById('chat-messages');
  var input = document.getElementById('ai-input');
  var sendBtn = document.getElementById('ai-send');
  var errorDiv = document.getElementById('ai-error');
  var bestConditionsBtn = document.getElementById('best-conditions-btn');
  var forecastBtn = document.getElementById('forecast-btn');
  var locationInputContainer = document.getElementById('location-input-container');
  var locationInput = document.getElementById('location-input');
  var forecastSendBtn = document.getElementById('forecast-send-btn');

  function getLang() {
    return localStorage.getItem('carp24-lang') || 'de';
  }

  var i18nErrors = {
    max_chars: { de: 'Maximal 500 Zeichen.', en: 'Maximum 500 characters.' },
    not_configured: { de: 'KI-Assistent ist nicht konfiguriert. Bitte den Admin kontaktieren.', en: 'AI assistant is not configured. Please contact the admin.' },
    rate_limit: { de: 'Bitte kurz warten.', en: 'Please wait a moment.' },
    request_error: { de: 'Fehler bei der Anfrage.', en: 'Request error.' },
    unreachable: { de: 'KI-Dienst nicht erreichbar.', en: 'AI service unreachable.' },
    location_required: { de: 'Bitte Standort eingeben.', en: 'Please enter a location.' }
  };

  function addBubble(text, isUser) {
    var wrapper = document.createElement('div');
    wrapper.className = 'flex ' + (isUser ? 'justify-end' : 'items-start');

    var bubble = document.createElement('div');
    bubble.className = 'max-w-[80%] rounded-xl px-4 py-3 text-body-md ' +
      (isUser
        ? 'bg-primary-container text-on-primary-container'
        : 'bg-surface-container-lowest text-on-surface');

    var span = document.createElement('span');
    span.className = 'block break-words';
    span.textContent = text;
    bubble.appendChild(span);
    wrapper.appendChild(bubble);
    container.appendChild(wrapper);
    container.scrollTop = container.scrollHeight;
    return wrapper;
  }

  function addConfidenceBubble(confidence, catchesTotal, catchesWithWeather) {
    var wrapper = document.createElement('div');
    wrapper.className = 'flex items-start';
    var bubble = document.createElement('div');
    bubble.className = 'max-w-[80%] rounded-xl px-4 py-3 text-body-md bg-surface-container-low border border-primary/20';
    var color = confidence >= 70 ? 'text-primary' : confidence >= 40 ? 'text-yellow-600' : 'text-error';
    var icon = confidence >= 70 ? '🎯' : confidence >= 40 ? '⚠️' : '❗';
    var html = '<div class="flex items-center gap-2 mb-1">' +
      '<span class="text-display-md ' + color + '">' + confidence + '%</span>' +
      '<span class="text-body-sm text-on-surface-variant">Genauigkeit</span></div>' +
      '<div class="text-body-sm text-on-surface-variant">Basierend auf ' + catchesWithWeather + ' Fängen mit Wetterdaten (' + catchesTotal + ' gesamt)</div>';
    if (confidence < 40) {
      html += '<div class="text-body-sm text-error mt-1">💡 Gib mehr Fänge mit Wetterdaten ein für eine genauere Analyse.</div>';
    }
    bubble.innerHTML = html;
    wrapper.appendChild(bubble);
    container.appendChild(wrapper);
    container.scrollTop = container.scrollHeight;
  }

  function showError(msg) {
    errorDiv.textContent = msg;
    errorDiv.classList.remove('hidden');
    setTimeout(function () { errorDiv.classList.add('hidden'); }, 5000);
  }

  function sendMessage() {
    var msg = input.value.trim();
    if (!msg) return;
    if (msg.length > 500) {
      showError(i18nErrors.max_chars[getLang()] || i18nErrors.max_chars.de);
      return;
    }

    addBubble(msg, true);
    input.value = '';
    sendBtn.disabled = true;
    errorDiv.classList.add('hidden');

    fetch('/api/ai/chat', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg }),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          var lang = getLang();
          if (res.status === 503) {
            showError(data.error || i18nErrors.not_configured[lang] || i18nErrors.not_configured.de);
          } else if (res.status === 429) {
            showError(data.error || i18nErrors.rate_limit[lang] || i18nErrors.rate_limit.de);
          } else if (res.ok && data.answer) {
            addBubble(data.answer, false);
          } else {
            showError(data.error || i18nErrors.request_error[lang] || i18nErrors.request_error.de);
          }
        });
      })
      .catch(function () {
        var lang = getLang();
        showError(i18nErrors.unreachable[lang] || i18nErrors.unreachable.de);
      })
      .finally(function () {
        sendBtn.disabled = false;
      });
  }

  function showBestConditions() {
    addBubble('Analysiere deine besten Angelbedingungen...', true);
    errorDiv.classList.add('hidden');

    fetch('/api/ai/analyze', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mode: 'best-conditions' }),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          var lang = getLang();
          if (res.status === 503) {
            showError(data.error || i18nErrors.not_configured[lang] || i18nErrors.not_configured.de);
          } else if (res.status === 429) {
            showError(data.error || i18nErrors.rate_limit[lang] || i18nErrors.rate_limit.de);
          } else if (res.ok && data.answer) {
            if (data.confidence !== undefined) addConfidenceBubble(data.confidence, data.catchesTotal || 0, data.catchesWithWeather || 0);
            addBubble(data.answer, false);
          } else {
            showError(data.error || i18nErrors.request_error[lang] || i18nErrors.request_error.de);
          }
        });
      })
      .catch(function () {
        var lang = getLang();
        showError(i18nErrors.unreachable[lang] || i18nErrors.unreachable.de);
      });
  }

  function showForecast() {
    locationInputContainer.classList.remove('hidden');
    locationInput.focus();
    forecastBtn.disabled = true;
    bestConditionsBtn.disabled = true;
  }

  function sendForecast() {
    var location = locationInput.value.trim();
    var lat = locationInput.dataset.lat;
    var lon = locationInput.dataset.lon;
    
    if (!location) {
      showError(i18nErrors.location_required[getLang()] || i18nErrors.location_required.de);
      return;
    }

    addBubble('Erstelle Fangprognose für: ' + location, true);
    locationInput.value = '';
    locationInputContainer.classList.add('hidden');
    forecastBtn.disabled = false;
    bestConditionsBtn.disabled = false;
    errorDiv.classList.add('hidden');

    var requestBody = {
      mode: 'forecast',
      location: location
    };
    
    if (lat && lon) {
      requestBody.lat = parseFloat(lat);
      requestBody.lon = parseFloat(lon);
    }

    fetch('/api/ai/analyze', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(requestBody),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          var lang = getLang();
          if (res.status === 503) {
            showError(data.error || i18nErrors.not_configured[lang] || i18nErrors.not_configured.de);
          } else if (res.status === 429) {
            showError(data.error || i18nErrors.rate_limit[lang] || i18nErrors.rate_limit.de);
          } else if (res.ok && data.answer) {
            if (data.confidence !== undefined) addConfidenceBubble(data.confidence, data.catchesTotal || 0, data.catchesWithWeather || 0);
            addBubble(data.answer, false);
          } else {
            showError(data.error || i18nErrors.request_error[lang] || i18nErrors.request_error.de);
          }
        });
      })
      .catch(function () {
        var lang = getLang();
        showError(i18nErrors.unreachable[lang] || i18nErrors.unreachable.de);
      });
  }

  if (sendBtn) sendBtn.addEventListener('click', sendMessage);
  if (input) input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  if (bestConditionsBtn) bestConditionsBtn.addEventListener('click', showBestConditions);
  if (forecastBtn) forecastBtn.addEventListener('click', showForecast);
  if (forecastSendBtn) forecastSendBtn.addEventListener('click', sendForecast);
  if (locationInput) locationInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      sendForecast();
    }
  });

  // Location autocomplete
  var suggestionsEl = document.getElementById('location-suggestions');
  var debounceTimer = null;
  if (locationInput && suggestionsEl) {
    locationInput.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      var q = locationInput.value.trim();
      if (q.length < 2) { suggestionsEl.classList.add('hidden'); return; }
      debounceTimer = setTimeout(function () {
        fetch('https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(q) + '&count=5&language=de')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.results || !data.results.length) { suggestionsEl.classList.add('hidden'); return; }
            suggestionsEl.innerHTML = data.results.map(function(r) {
              var label = r.name + (r.admin1 ? ', ' + r.admin1 : '') + (r.country ? ' (' + r.country + ')' : '');
              return '<div class="px-4 py-2 hover:bg-surface-variant cursor-pointer text-body-md" data-lat="' + r.latitude + '" data-lon="' + r.longitude + '" data-name="' + r.name + '">' + label + '</div>';
            }).join('');
            suggestionsEl.classList.remove('hidden');
            suggestionsEl.querySelectorAll('div').forEach(function(item) {
              item.addEventListener('click', function() {
                locationInput.value = item.dataset.name;
                locationInput.dataset.lat = item.dataset.lat;
                locationInput.dataset.lon = item.dataset.lon;
                suggestionsEl.classList.add('hidden');
              });
            });
          })
          .catch(function() { suggestionsEl.classList.add('hidden'); });
      }, 300);
    });
    document.addEventListener('click', function(e) {
      if (!locationInput.contains(e.target) && !suggestionsEl.contains(e.target)) suggestionsEl.classList.add('hidden');
    });
  }

  // AI usage counter
  var counterEl = document.getElementById('ai-usage-counter');
  if (counterEl) {
    fetch('/api/ai/chat', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ _check: true }) })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.remaining !== undefined && data.remaining < 999) {
          counterEl.textContent = data.remaining + ' von 50 Anfragen diesen Monat verbleibend';
        }
      })
      .catch(function() {});
  }
})();
</script>
