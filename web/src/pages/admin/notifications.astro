---
import Layout from "../../layouts/Layout.astro";
import { getSessionAndProfile } from "../../lib/admin";

const { session, isAdmin } = await getSessionAndProfile(Astro);
if (!session) return Astro.redirect("/login/");
if (!isAdmin) return Astro.redirect("/");
---

<Layout title="Carp24 – Admin – Benachrichtigungen" noindex>
<main class="flex-grow flex flex-col items-center px-margin-mobile md:px-margin-desktop py-xl max-w-7xl mx-auto w-full">
    <div class="w-full mb-xl">
      <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">PASSION. FISHING. COMMUNITY.</p>
      <h1 class="text-headline-lg text-on-surface" data-de="ADMIN-BENACHRICHTIGUNGEN" data-en="ADMIN NOTIFICATIONS">ADMIN-BENACHRICHTIGUNGEN</h1>
    </div>

    <nav class="flex gap-4 mb-xl flex-wrap">
      <a href="/admin/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Übersicht" data-en="Overview">Übersicht</a>
      <a href="/admin/reports/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Reports" data-en="Reports">Reports</a>
      <a href="/admin/users/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Nutzer" data-en="Users">Nutzer</a>
      <a href="/admin/content/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Inhalte" data-en="Content">Inhalte</a>
      <a href="/admin/revenue/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Revenue" data-en="Revenue">Revenue</a>
      <a href="/admin/audit/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Audit" data-en="Audit">Audit</a>
      <a href="/admin/notifications/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Benachrichtigungen" data-en="Notifications">Benachrichtigungen</a>
      <a href="/admin/settings/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Einstellungen" data-en="Settings">Einstellungen</a>
    </nav>

    <div class="w-full max-w-2xl">
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <h2 class="text-headline-md text-on-surface mb-lg" data-de="Push-Benachrichtigung senden" data-en="Send Push Notification">Push-Benachrichtigung senden</h2>

        <form id="notify-form" class="flex flex-col gap-lg">
          <!-- Title -->
          <div>
            <label for="title" class="font-label-sm text-label-sm text-on-surface block mb-xs" data-de="Titel" data-en="Title">Titel</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              maxlength="128"
              class="w-full px-4 py-3 rounded-xl bg-surface-container-highest text-on-surface border border-outline/20 focus:outline-none focus:border-primary placeholder:text-on-surface-variant"
              placeholder="z. B. Wartungsarbeiten"
              data-de="z. B. Wartungsarbeiten"
              data-en="e.g. Maintenance"
            />
          </div>

          <!-- Body -->
          <div>
            <label for="body" class="font-label-sm text-label-sm text-on-surface block mb-xs" data-de="Nachricht" data-en="Message">Nachricht</label>
            <textarea
              id="body"
              name="body"
              required
              maxlength="500"
              rows="4"
              class="w-full px-4 py-3 rounded-xl bg-surface-container-highest text-on-surface border border-outline/20 focus:outline-none focus:border-primary placeholder:text-on-surface-variant resize-none"
              placeholder="z. B. Die App ist heute Abend von 22:00–23:00 Uhr wegen Wartungsarbeiten nicht erreichbar."
              data-de="z. B. Die App ist heute Abend von 22:00–23:00 Uhr wegen Wartungsarbeiten nicht erreichbar."
              data-en="e.g. The app is unavailable tonight from 10:00 PM to 11:00 PM due to maintenance."
            ></textarea>
          </div>

          <!-- Filter: Role -->
          <div>
            <label for="role-filter" class="font-label-sm text-label-sm text-on-surface block mb-xs" data-de="Empfänger-Rolle (optional)" data-en="Recipient Role (optional)">Empfänger-Rolle (optional)</label>
            <select
              id="role-filter"
              name="role-filter"
              class="w-full px-4 py-3 rounded-xl bg-surface-container-highest text-on-surface border border-outline/20 focus:outline-none focus:border-primary"
            >
              <option value="" data-de="Alle Rollen" data-en="All Roles">Alle Rollen</option>
              <option value="USER" data-de="Nur USER" data-en="USER only">Nur USER</option>
              <option value="MODERATOR" data-de="Nur MODERATOR" data-en="MODERATOR only">Nur MODERATOR</option>
              <option value="ADMIN" data-de="Nur ADMIN" data-en="ADMIN only">Nur ADMIN</option>
            </select>
          </div>

          <!-- Filter: is_pro -->
          <div class="flex items-center justify-between">
            <div>
              <p class="font-label-sm text-label-sm text-on-surface" data-de="Nur Pro-Benutzer" data-en="Pro Users only">Nur Pro-Benutzer</p>
              <p class="text-body-sm text-on-surface-variant" data-de="Beschränkt auf Premium-Mitglieder" data-en="Limited to Premium Members">Beschränkt auf Premium-Mitglieder</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="pro-filter" class="sr-only peer" />
              <div class="w-11 h-6 rounded-full peer bg-surface-container-highest border border-outline/20 peer-checked:bg-primary peer-checked:border-primary transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border after:border-outline/20 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></div>
            </label>
          </div>

          <!-- Submit -->
          <div class="flex items-center gap-md pt-sm border-t border-outline/20">
            <button
              type="submit"
              id="send-btn"
              class="font-nav-item text-nav-item uppercase tracking-widest px-8 py-3 rounded-full min-h-11 transition-colors bg-primary text-on-primary hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed"
              data-de="SENDEN"
              data-en="SEND"
            >
              SENDEN
            </button>
            <span id="feedback" class="text-body-sm text-on-surface-variant hidden"></span>
          </div>
        </form>
      </div>

      <!-- History -->
      <div class="mt-xl">
        <h2 class="text-headline-md text-on-surface mb-lg" data-de="Verlauf" data-en="History">Verlauf</h2>
        <div id="history-loading"><div style="padding:16px;background:linear-gradient(90deg,rgba(128,128,128,0.06) 25%,rgba(128,128,128,0.12) 50%,rgba(128,128,128,0.06) 75%);background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:12px;display:flex;flex-direction:column;gap:10px"><div style="height:12px;width:30%;background:inherit;background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:4px;margin-bottom:4px"></div><div style="height:16px;width:60%;background:inherit;background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:4px"></div><div style="height:14px;width:40%;background:inherit;background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:4px;margin-top:8px"></div></div><div style="padding:16px;background:linear-gradient(90deg,rgba(128,128,128,0.06) 25%,rgba(128,128,128,0.12) 50%,rgba(128,128,128,0.06) 75%);background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:12px;display:flex;flex-direction:column;gap:10px;margin-top:12px"><div style="height:12px;width:25%;background:inherit;background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:4px;margin-bottom:4px"></div><div style="height:16px;width:70%;background:inherit;background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:4px"></div><div style="height:14px;width:50%;background:inherit;background-size:468px 100%;animation:skeleton-shimmer 1.5s ease-in-out infinite;border-radius:4px;margin-top:8px"></div></div></div>
        <div id="history-list" class="hidden space-y-md"></div>
        <div id="history-empty" class="hidden text-body-md text-on-surface-variant" data-de="Noch keine Benachrichtigungen gesendet." data-en="No notifications sent yet.">Noch keine Benachrichtigungen gesendet.</div>
      </div>
    </div>
  </main>
<style>100%{background-position:468px 0}}</style>

  <script>
    // Auto-reload on SW update
    if ('serviceWorker' in navigator) {
      let reloading = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (reloading) return;
        reloading = true;
        window.location.reload();
      });
    }

    import { escHtml } from "../../lib/escape";
    import AdminKeyboardShortcuts from "../../components/admin/keyboard-shortcuts.js";

    AdminKeyboardShortcuts.init({
      shortcuts: [
        { key: 'g 0', desc: 'Zur Übersicht', handler: function () { window.location.href = '/admin/'; } },
        { key: 'g r', desc: 'Zu Reports', handler: function () { window.location.href = '/admin/reports/'; } },
        { key: 'g u', desc: 'Zu Nutzer', handler: function () { window.location.href = '/admin/users/'; } },
        { key: 'g c', desc: 'Zu Inhalten', handler: function () { window.location.href = '/admin/content/'; } },
        { key: 'g v', desc: 'Zu Revenue', handler: function () { window.location.href = '/admin/revenue/'; } },
        { key: 'g a', desc: 'Zu Audit', handler: function () { window.location.href = '/admin/audit/'; } },
        { key: 'g s', desc: 'Zu Einstellungen', handler: function () { window.location.href = '/admin/settings/'; } },
      ]
    });

    document.addEventListener("DOMContentLoaded", async () => {
      const form = document.getElementById("notify-form")!;
      const titleInput = document.getElementById("title") as HTMLInputElement;
      const bodyInput = document.getElementById("body") as HTMLTextAreaElement;
      const roleSelect = document.getElementById("role-filter") as HTMLSelectElement;
      const proCheckbox = document.getElementById("pro-filter") as HTMLInputElement;
      const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
      const feedbackEl = document.getElementById("feedback")!;

      // ── Send ──────────────────────────────────────
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        sendBtn.disabled = true;
        sendBtn.textContent = "SENDE…";
        feedbackEl.classList.add("hidden");

        const filter: { role?: string; is_pro?: boolean } = {};
        if (roleSelect.value) filter.role = roleSelect.value;
        if (proCheckbox.checked) filter.is_pro = true;
        const filterPayload = Object.keys(filter).length > 0 ? filter : null;

        try {
          const res = await fetch("/api/admin/notifications", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              title: titleInput.value.trim(),
              body: bodyInput.value.trim(),
              filter: filterPayload,
            }),
          });

          const data = await res.json();

          if (res.ok) {
            feedbackEl.textContent =
              "Gesendet (" + data.sent + " Push" + (data.expired ? ", " + data.expired + " abgelaufen" : "") + ")" +
              (data.warning ? " — " + data.warning : "");
            feedbackEl.className = "text-body-sm text-green-600";
            titleInput.value = "";
            bodyInput.value = "";
            roleSelect.value = "";
            proCheckbox.checked = false;
            loadHistory();
          } else {
            feedbackEl.textContent = "Fehler: " + (data.error || "Unbekannt");
            feedbackEl.className = "text-body-sm text-error";
          }
        } catch {
          feedbackEl.textContent = "Fehler beim Senden.";
          feedbackEl.className = "text-body-sm text-error";
        }

        feedbackEl.classList.remove("hidden");
        sendBtn.disabled = false;
        sendBtn.textContent = "SENDEN";
      });

      // ── History ────────────────────────────────────
      const historyLoading = document.getElementById("history-loading")!;
      const historyList = document.getElementById("history-list")!;
      const historyEmpty = document.getElementById("history-empty")!;

      async function loadHistory() {
        try {
          const res = await fetch("/api/admin/notifications?limit=20");
          if (!res.ok) {
            historyLoading.textContent = "Fehler beim Laden.";
            return;
          }
          const data = await res.json();
          renderHistory(data.notifications ?? []);
        } catch {
          historyLoading.textContent = "Fehler beim Laden.";
        }
      }

      function renderHistory(notifications: any[]) {
        historyLoading.classList.add("hidden");

        if (notifications.length === 0) {
          historyEmpty.classList.remove("hidden");
          historyList.classList.add("hidden");
          return;
        }

        historyEmpty.classList.add("hidden");
        historyList.classList.remove("hidden");

        historyList.innerHTML = notifications.map((n: any) => {
          const filterParts: string[] = [];
          if (n.filter?.role) filterParts.push("Rolle: " + n.filter.role);
          if (n.filter?.is_pro) filterParts.push("Pro");

          return (
            '<div class="bg-surface-container-lowest rounded-xl p-md border border-outline/20">' +
              '<div class="flex items-start justify-between gap-sm">' +
                '<div class="flex-1 min-w-0">' +
                  '<p class="font-label-sm text-label-sm text-on-surface truncate">' + escHtml(n.title) + '</p>' +
                  '<p class="text-body-sm text-on-surface-variant mt-xs line-clamp-2">' + escHtml(n.body) + '</p>' +
                '</div>' +
              '</div>' +
              '<div class="flex items-center gap-sm mt-xs">' +
                '<span class="text-caption text-on-surface-variant">' + formatDate(n.sent_at || n.created_at) + '</span>' +
                (filterParts.length > 0 ? '<span class="text-caption text-primary">' + filterParts.join(" · ") + '</span>' : '<span class="text-caption text-on-surface-variant">Alle</span>') +
              '</div>' +
            '</div>'
          );
        }).join("");
      }

      function formatDate(iso: string): string {
        if (!iso) return "";
        return new Date(iso).toLocaleString("de-DE", {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      }

      loadHistory();
    });
  </script>
</Layout>