          if (!email) {
            aiResetFeedback.textContent = "Bitte eine E-Mail eingeben.";
            aiResetFeedback.className = "text-body-sm text-error mt-sm";
            aiResetFeedback.classList.remove("hidden");
            return;
          }

          aiResetBtn.disabled = true;
          aiResetBtn.textContent = "RESETTE…";
          aiResetFeedback.classList.add("hidden");

          try {
            const res = await fetch("/api/admin/ai-usage", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email }),
            });

            if (res.ok) {
              const data = await res.json();
              aiResetFeedback.textContent = data.message || `KI-Nutzung für ${email} zurückgesetzt.`;
              aiResetFeedback.className = "text-body-sm text-green-600 mt-sm";
              aiResetFeedback.classList.remove("hidden");
              aiResetEmail.value = "";
              await loadAIUsage();
            } else {
              const err = await res.json();
              aiResetFeedback.textContent = "Fehler: " + (err.error || "Unbekannt");
              aiResetFeedback.className = "text-body-sm text-error mt-sm";
              aiResetFeedback.classList.remove("hidden");
            }
          } catch {
            aiResetFeedback.textContent = "Fehler beim Zurücksetzen.";
            aiResetFeedback.className = "text-body-sm text-error mt-sm";
            aiResetFeedback.classList.remove("hidden");
          }

          aiResetBtn.disabled = false;
          aiResetBtn.textContent = "RESET";
        });
      }

      loadAIUsage();

    });
  </script>
</Layout>