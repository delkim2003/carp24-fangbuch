---
import Layout from "../../layouts/Layout.astro";
import { getSessionAndProfile } from "../../lib/admin";

const { session, isAdmin } = await getSessionAndProfile(Astro);
if (!session) return Astro.redirect("/login/");
if (!isAdmin) return Astro.redirect("/");
---

<Layout title="Carp24 – Admin: Inhalte" noindex>
  <main class="flex-grow flex flex-col items-center px-margin-mobile md:px-margin-desktop py-xl max-w-7xl mx-auto w-full">
    <div class="w-full mb-xl">
      <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">PASSION. FISHING. COMMUNITY.</p>
      <h1 class="text-headline-lg text-on-surface">INHALTE</h1>
    </div>

    <nav class="flex gap-4 mb-xl flex-wrap">
      <a href="/admin/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Übersicht</a>
      <a href="/admin/reports/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Reports</a>
      <a href="/admin/users/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Nutzer</a>
      <a href="/admin/content/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-primary text-on-primary min-h-12 flex items-center">Inhalte</a>
    </nav>

    <div class="flex gap-3 mb-lg flex-wrap">
      <button id="tab-catch" type="button" data-type="catch" class="content-tab font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-primary text-on-primary min-h-11 flex items-center cursor-pointer">Fänge</button>
      <button id="tab-forum" type="button" data-type="forum" class="content-tab font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface min-h-11 flex items-center cursor-pointer">Forum</button>
      <button id="tab-chat" type="button" data-type="chat" class="content-tab font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface min-h-11 flex items-center cursor-pointer">Chat</button>
      <button id="tab-marketplace" type="button" data-type="marketplace" class="content-tab font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface min-h-11 flex items-center cursor-pointer">Marktplatz</button>
    </div>

    <div class="w-full mb-md">
      <input id="search-input" type="text" placeholder="Suche…" class="w-full max-w-md bg-surface-container-highest text-on-surface rounded-full px-4 py-3 text-body-md border border-outline/20 placeholder:text-on-surface-variant/60 min-h-12" />
    </div>

    <div id="content-container" class="w-full space-y-3">
      <p class="text-body-md text-on-surface-variant">Lade…</p>
    </div>
  </main>

  <script>
    let currentType = "catch";
    let searchTimeout: ReturnType<typeof setTimeout> | null = null;

    function renderCatch(item: any) {
      const date = new Date(item.created_at).toLocaleDateString("de-DE");
      const deleted = item.deleted_at ? ' <span class="text-error">(gelöscht)</span>' : "";
      return `<div class="bg-surface-container-lowest rounded-xl p-lg border border-outline/20" data-id="${item.id}" data-type="catch">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="text-body-md text-on-surface font-medium">${item.display_name || "–"}${deleted}</p>
            <p class="text-body-sm text-on-surface-variant">${item.species || "–"} · ${item.weight_kg ?? "–"} kg · ${item.water_name || "–"}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-body-sm text-on-surface-variant whitespace-nowrap">${date}</span>
            <button type="button" class="delete-content-btn font-label-sm text-label-sm uppercase tracking-widest px-3 py-1.5 rounded-full bg-error text-on-error min-h-11 flex items-center cursor-pointer hover:opacity-90 transition-colors">Löschen</button>
          </div>
        </div>
      </div>`;
    }

    function renderForum(item: any) {
      const date = new Date(item.created_at).toLocaleDateString("de-DE");
      const isThread = item._type === "thread";
      const label = isThread ? "THREAD" : "BEITRAG";
      const title = isThread ? (item.title || "–") : "";
      const body = (item.body || "").slice(0, 120);
      return `<div class="bg-surface-container-lowest rounded-xl p-lg border border-outline/20" data-id="${item.id}" data-type="forum">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">${label}</p>
            <p class="text-body-md text-on-surface font-medium">${item.display_name || "–"}</p>
            ${title ? `<p class="text-body-md text-on-surface mt-sm">${title}</p>` : ""}
            <p class="text-body-sm text-on-surface-variant mt-sm">${body}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-body-sm text-on-surface-variant whitespace-nowrap">${date}</span>
            <button type="button" class="delete-content-btn font-label-sm text-label-sm uppercase tracking-widest px-3 py-1.5 rounded-full bg-error text-on-error min-h-11 flex items-center cursor-pointer hover:opacity-90 transition-colors">Löschen</button>
          </div>
        </div>
      </div>`;
    }

    function renderChat(item: any) {
      const date = new Date(item.created_at).toLocaleDateString("de-DE");
      return `<div class="bg-surface-container-lowest rounded-xl p-lg border border-outline/20" data-id="${item.id}" data-type="chat">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="text-body-md text-on-surface font-medium">${item.display_name || "–"}</p>
            <p class="text-body-sm text-on-surface-variant mt-sm">${(item.body || "").slice(0, 150)}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-body-sm text-on-surface-variant whitespace-nowrap">${date}</span>
            <button type="button" class="delete-content-btn font-label-sm text-label-sm uppercase tracking-widest px-3 py-1.5 rounded-full bg-error text-on-error min-h-11 flex items-center cursor-pointer hover:opacity-90 transition-colors">Löschen</button>
          </div>
        </div>
      </div>`;
    }

    function renderMarketplace(item: any) {
      const date = new Date(item.created_at).toLocaleDateString("de-DE");
      return `<div class="bg-surface-container-lowest rounded-xl p-lg border border-outline/20" data-id="${item.id}" data-type="marketplace">
        <div class="flex justify-between items-start gap-4">
          <div>
            <p class="text-body-md text-on-surface font-medium">${item.title || "–"}</p>
            <p class="text-body-sm text-on-surface-variant">${item.display_name || "–"} · ${item.price ?? "–"} € · ${item.status || "–"}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-body-sm text-on-surface-variant whitespace-nowrap">${date}</span>
            <button type="button" class="delete-content-btn font-label-sm text-label-sm uppercase tracking-widest px-3 py-1.5 rounded-full bg-error text-on-error min-h-11 flex items-center cursor-pointer hover:opacity-90 transition-colors">Löschen</button>
          </div>
        </div>
      </div>`;
    }

    const renderers: Record<string, (item: any) => string> = {
      catch: renderCatch,
      forum: renderForum,
      chat: renderChat,
      marketplace: renderMarketplace,
    };

    async function loadContent() {
      const container = document.getElementById("content-container");
      const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
      if (!container) return;
      container.innerHTML = '<p class="text-body-md text-on-surface-variant">Lade…</p>';

      const q = searchInput?.value?.trim() || "";
      try {
        const res = await fetch(`/api/admin/content?type=${currentType}${q ? `&q=${encodeURIComponent(q)}` : ""}`);
        if (!res.ok) throw new Error();
        const { items } = await res.json();

        if (!items || items.length === 0) {
          container.innerHTML = '<p class="text-body-md text-on-surface-variant">Keine Inhalte gefunden.</p>';
          return;
        }

        const renderer = renderers[currentType] || renderCatch;
        container.innerHTML = items.map(renderer).join("");

        container.querySelectorAll(".delete-content-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const card = btn.closest("[data-id]");
            if (!card) return;
            const id = card.getAttribute("data-id") || "";
            const type = card.getAttribute("data-type") || currentType;
            if (!confirm("Inhalt wirklich löschen?")) return;
            btn.setAttribute("disabled", "true");
            btn.textContent = "…";
            await fetch("/api/admin/content", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ type, id }),
            });
            loadContent();
          });
        });
      } catch {
        container.innerHTML = '<p class="text-body-md text-error">Fehler beim Laden.</p>';
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const tabs = document.querySelectorAll(".content-tab");
      const searchInput = document.getElementById("search-input") as HTMLInputElement | null;

      function setActive(type: string) {
        currentType = type;
        tabs.forEach((t) => {
          const tabType = t.getAttribute("data-type");
          if (tabType === type) {
            t.className = "content-tab font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-primary text-on-primary min-h-11 flex items-center cursor-pointer";
          } else {
            t.className = "content-tab font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface min-h-11 flex items-center cursor-pointer";
          }
        });
        if (searchInput) searchInput.value = "";
        loadContent();
      }

      tabs.forEach((t) => {
        t.addEventListener("click", () => {
          const type = t.getAttribute("data-type");
          if (type) setActive(type);
        });
      });

      searchInput?.addEventListener("input", () => {
        if (searchTimeout) clearTimeout(searchTimeout);
        searchTimeout = setTimeout(loadContent, 300);
      });

      loadContent();
    });
  </script>
</Layout>
