---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/admin/Breadcrumb.astro";
import Pagination from "../../components/admin/Pagination.astro";
import Skeleton from "../../components/admin/Skeleton.astro";
import { getSessionAndProfile } from "../../lib/admin";

const { session, isAdmin } = await getSessionAndProfile(Astro);
if (!session) return Astro.redirect("/login/");
if (!isAdmin) return Astro.redirect("/");
---

<Layout title="Carp24 – Admin: Audit" noindex>
<main class="flex-grow flex flex-col items-center px-margin-mobile md:px-margin-desktop py-xl max-w-7xl mx-auto w-full">
    <div class="w-full mb-xl">
      <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">PASSION. FISHING. COMMUNITY.</p>
      <h1 class="text-headline-lg text-on-surface" data-de="AUDIT-LOG" data-en="AUDIT LOG">AUDIT-LOG</h1>
    </div>

    <Breadcrumb items={[{label: 'Admin', href: '/admin/'}, {label: 'Audit'}]} />

    <nav class="flex gap-4 mb-xl flex-wrap">
      <a href="/admin/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Übersicht" data-en="Overview">Übersicht</a>
      <a href="/admin/reports/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Reports" data-en="Reports">Reports</a>
      <a href="/admin/users/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Nutzer" data-en="Users">Nutzer</a>
      <a href="/admin/content/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Inhalte" data-en="Content">Inhalte</a>
      <a href="/admin/revenue/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Revenue" data-en="Revenue">Revenue</a>
      <a href="/admin/audit/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-primary text-on-primary min-h-12 flex items-center" data-de="Audit" data-en="Audit">Audit</a>
      <a href="/admin/notifications/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Benachrichtigungen" data-en="Notifications">Benachrichtigungen</a>
      <a href="/admin/settings/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center" data-de="Einstellungen" data-en="Settings">Einstellungen</a>
    </nav>

    <div class="w-full flex flex-wrap items-center gap-3 mb-lg">
      <select id="filter-action" class="bg-surface-container-highest text-on-surface rounded-full px-4 py-3 text-body-md border border-outline/20 min-h-12 cursor-pointer">
        <option value="" data-de="Alle Aktionen" data-en="All Actions">Alle Aktionen</option>
        <option value="user.role">user.role</option>
        <option value="user.pro">user.pro</option>
        <option value="user.ban">user.ban</option>
        <option value="user.unban">user.unban</option>
        <option value="user.reset_password">user.reset_password</option>
        <option value="user.delete">user.delete</option>
        <option value="report.resolve">report.resolve</option>
        <option value="report.delete_content">report.delete_content</option>
      </select>
      <input type="date" id="filter-date-from" class="bg-surface-container-highest text-on-surface rounded-full px-4 py-3 text-body-md border border-outline/20 min-h-12 cursor-pointer">
      <span class="text-on-surface-variant text-body-md">–</span>
      <input type="date" id="filter-date-to" class="bg-surface-container-highest text-on-surface rounded-full px-4 py-3 text-body-md border border-outline/20 min-h-12 cursor-pointer">
      <button id="filter-apply-btn" type="button" class="font-label-sm text-label-sm uppercase tracking-widest px-4 py-2 rounded-full bg-primary text-on-primary min-h-12 flex items-center cursor-pointer" data-de="Anwenden" data-en="Apply">Anwenden</button>
      <button id="filter-clear-btn" type="button" class="font-label-sm text-label-sm uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-error-container hover:text-on-error-container transition-colors min-h-12 flex items-center cursor-pointer" data-de="Zurücksetzen" data-en="Reset">Zurücksetzen</button>
    </div>

    <div class="w-full overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-outline/20">
            <th class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant py-3 px-4" data-de="Zeit" data-en="Time">Zeit</th>
            <th class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant py-3 px-4" data-de="Admin" data-en="Admin">Admin</th>
            <th class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant py-3 px-4" data-de="Aktion" data-en="Action">Aktion</th>
            <th class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant py-3 px-4" data-de="Ziel" data-en="Target">Ziel</th>
            <th class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant py-3 px-4" data-de="Details" data-en="Details">Details</th>
          </tr>
        </thead>
        <tbody id="audit-body">
          <Skeleton variant="table-row" count={5} cols={5} />
        </tbody>
      </table>
    </div>

    <div id="pagination-wrapper" class="mt-lg">{/* JS fills this */}</div>
  </main>

  <script>
    // Auto-reload on SW update
    if ('serviceWorker' in navigator) {
      let reloading = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (reloading) return;
        reloading = true;
        window.location.reload();
      });
    }

    import AdminKeyboardShortcuts from "../../components/admin/keyboard-shortcuts.js";

    AdminKeyboardShortcuts.init({
      shortcuts: [
        { key: 'g 0', desc: 'Zur Übersicht', handler: function () { window.location.href = '/admin/'; } },
        { key: 'g r', desc: 'Zu Reports', handler: function () { window.location.href = '/admin/reports/'; } },
        { key: 'g u', desc: 'Zu Nutzer', handler: function () { window.location.href = '/admin/users/'; } },
        { key: 'g c', desc: 'Zu Inhalten', handler: function () { window.location.href = '/admin/content/'; } },
        { key: 'g v', desc: 'Zu Revenue', handler: function () { window.location.href = '/admin/revenue/'; } },
        { key: 'g a', desc: 'Zu Audit', handler: function () { window.location.href = '/admin/audit/'; } },
        { key: 'g s', desc: 'Zu Einstellungen', handler: function () { window.location.href = '/admin/settings/'; } },
      ]
    });

    var currentPage = 1;
    var totalPages = 1;

    function escapeHtml(str) {
      var div = document.createElement("div");
      div.appendChild(document.createTextNode(str || ""));
      return div.innerHTML;
    }

    function formatDetails(details) {
      if (!details) return "–";
      try {
        if (typeof details === "string") details = JSON.parse(details);
        return escapeHtml(JSON.stringify(details, null, 2));
      } catch {
        return escapeHtml(String(details));
      }
    }

    function getFilterParams() {
      var params = new URLSearchParams();
      var action = document.getElementById("filter-action").value;
      var dateFrom = document.getElementById("filter-date-from").value;
      var dateTo = document.getElementById("filter-date-to").value;
      if (action) params.set("action", action);
      if (dateFrom) params.set("date_from", dateFrom);
      if (dateTo) params.set("date_to", dateTo);
      return params;
    }

    function updateUrlParams() {
      var params = getFilterParams();
      params.set("page", String(currentPage));
      params.set("limit", "25");
      var newUrl = window.location.pathname + "?" + params.toString();
      window.history.replaceState(null, "", params.toString() ? newUrl : window.location.pathname);
    }

    function buildPaginationControls() {
      var wrapper = document.getElementById("pagination-wrapper");
      if (!wrapper) return;

      var html = '<div class="pagination-wrapper flex items-center justify-between gap-4 mt-lg pt-lg border-t border-outline/20">';
      html += '<span class="text-body-sm text-on-surface-variant" id="pagination-info">Seite ' + currentPage + ' von ' + totalPages + '</span>';
      html += '<nav class="flex items-center gap-2" aria-label="Pagination">';

      if (currentPage > 1) {
        html += '<button data-page="' + (currentPage - 1) + '" class="paginate-btn font-label-sm text-label-sm uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 flex items-center cursor-pointer">← Zurück</button>';
      }

      html += '<div class="hidden sm:flex items-center gap-1">';
      var start = Math.max(1, currentPage - 2);
      var end = Math.min(totalPages, currentPage + 2);
      for (var p = start; p <= end; p++) {
        if (p === currentPage) {
          html += '<span class="font-label-sm text-label-sm px-3 py-1.5 rounded-full bg-primary text-on-primary min-h-9 flex items-center">' + p + '</span>';
        } else {
          html += '<button data-page="' + p + '" class="paginate-btn font-label-sm text-label-sm px-3 py-1.5 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-9 flex items-center cursor-pointer">' + p + '</button>';
        }
      }
      html += '</div>';

      if (currentPage < totalPages) {
        html += '<button data-page="' + (currentPage + 1) + '" class="paginate-btn font-label-sm text-label-sm uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 flex items-center cursor-pointer">Weiter →</button>';
      }

      html += '</nav></div>';
      wrapper.innerHTML = html;

      var buttons = wrapper.querySelectorAll(".paginate-btn");
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].addEventListener("click", function() {
          var page = parseInt(this.getAttribute("data-page"));
          if (page && page !== currentPage) {
            currentPage = page;
            loadAudit();
          }
        });
      }
    }

    async function loadAudit() {
      var tbody = document.getElementById("audit-body");
      if (!tbody) return;

      try {
        var params = getFilterParams();
        params.set("limit", "25");
        params.set("page", String(currentPage));

        var res = await fetch("/api/admin/audit?" + params.toString());
        if (!res.ok) throw new Error();
        var data = await res.json();

        if (data.pagination) {
          currentPage = data.pagination.page || currentPage;
          totalPages = data.pagination.totalPages || 1;
        }

        var logs = data.logs || [];

        if (logs.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="text-body-md text-on-surface-variant py-4 px-4">Keine Einträge gefunden.</td></tr>';
        } else {
          tbody.innerHTML = logs
            .map(function(l) {
              var date = new Date(l.created_at).toLocaleString("de-DE");
              return '<tr class="border-b border-outline/10 hover:bg-surface-container-low transition-colors">' +
                '<td class="text-body-sm text-on-surface-variant py-3 px-4 whitespace-nowrap">' + date + '</td>' +
                '<td class="text-body-md text-on-surface py-3 px-4">' + escapeHtml(l.actor_name || "–") + '</td>' +
                '<td class="text-body-sm text-on-surface py-3 px-4"><span class="font-label-sm text-label-sm uppercase tracking-widest text-primary">' + escapeHtml(l.action) + '</span></td>' +
                '<td class="text-body-sm text-on-surface-variant py-3 px-4">' + escapeHtml(l.target_type || "–") + ' ' + escapeHtml(l.target_id ? l.target_id.slice(0, 8) : "") + '</td>' +
                '<td class="text-body-sm text-on-surface-variant py-3 px-4"><pre class="whitespace-pre-wrap text-xs max-w-xs overflow-hidden">' + formatDetails(l.details) + '</pre></td>' +
              '</tr>';
            })
            .join("");
        }

        updateUrlParams();
        buildPaginationControls();
      } catch (e) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-body-md text-error py-4 px-4">Fehler beim Laden.</td></tr>';
      }
    }

    function applyFilters() {
      currentPage = 1;
      loadAudit();
    }

    function clearFilters() {
      document.getElementById("filter-action").value = "";
      document.getElementById("filter-date-from").value = "";
      document.getElementById("filter-date-to").value = "";
      currentPage = 1;
      loadAudit();
    }

    document.addEventListener("DOMContentLoaded", function() {
      // Restore filters from URL params on load
      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has("action")) {
        document.getElementById("filter-action").value = urlParams.get("action");
      }
      if (urlParams.has("date_from")) {
        document.getElementById("filter-date-from").value = urlParams.get("date_from");
      }
      if (urlParams.has("date_to")) {
        document.getElementById("filter-date-to").value = urlParams.get("date_to");
      }
      if (urlParams.has("page")) {
        currentPage = parseInt(urlParams.get("page"), 10) || 1;
      }

      document.getElementById("filter-apply-btn").addEventListener("click", applyFilters);
      document.getElementById("filter-clear-btn").addEventListener("click", clearFilters);
      loadAudit();
    });
  </script>

  <style>
    
      100% { background-position: 468px 0; }
    }
  </style>
</Layout>