---
import Layout from "../../layouts/Layout.astro";
import { getSessionAndProfile } from "../../lib/admin";

const { session, isAdmin } = await getSessionAndProfile(Astro);
if (!session) return Astro.redirect("/login/");
if (!isAdmin) return Astro.redirect("/");
---

<Layout title="Carp24 – Admin" noindex>
  <main class="flex-grow flex flex-col items-center px-margin-mobile md:px-margin-desktop py-xl max-w-7xl mx-auto w-full">
    <div class="w-full mb-xl">
      <p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">PASSION. FISHING. COMMUNITY.</p>
      <h1 class="text-headline-lg text-on-surface">ADMIN-BEREICH</h1>
    </div>

    <nav class="flex gap-4 mb-xl flex-wrap">
      <a href="/admin/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-primary text-on-primary min-h-12 flex items-center">Übersicht</a>
      <a href="/admin/reports/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Reports</a>
      <a href="/admin/users/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Nutzer</a>
      <a href="/admin/content/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Inhalte</a>
      <a href="/admin/revenue/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Revenue</a>
      <a href="/admin/audit/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Audit</a>
      <a href="/admin/settings/" class="font-nav-item text-nav-item uppercase tracking-widest px-4 py-2 rounded-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-12 flex items-center">Einstellungen</a>
    </nav>

    <div id="kpi-grid" class="grid grid-cols-2 md:grid-cols-4 gap-gutter w-full mb-xl">
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Nutzer</p>
        <p class="text-headline-lg text-on-surface" data-kpi="users">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Fänge</p>
        <p class="text-headline-lg text-on-surface" data-kpi="catches">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Offene Reports</p>
        <p class="text-headline-lg text-on-surface" data-kpi="openReports" data-kpi-warn="true">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Forum-Threads</p>
        <p class="text-headline-lg text-on-surface" data-kpi="forumThreads">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Forum-Antworten</p>
        <p class="text-headline-lg text-on-surface" data-kpi="forumPosts">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Chat-Nachrichten</p>
        <p class="text-headline-lg text-on-surface" data-kpi="chatMessages">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Marktplatz-Anzeigen</p>
        <p class="text-headline-lg text-on-surface" data-kpi="marketplaceItems">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Trips</p>
        <p class="text-headline-lg text-on-surface" data-kpi="trips">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Aktive Pro</p>
        <p class="text-headline-lg text-on-surface" data-kpi="proUsers">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Gebannte User</p>
        <p class="text-headline-lg text-on-surface" data-kpi="bannedUsers">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Offene Reports</p>
        <p class="text-headline-lg text-on-surface" data-kpi="openReports2">–</p>
      </div>
      <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm">Kontaktanfragen</p>
        <p class="text-headline-lg text-on-surface" data-kpi="marketContacts">–</p>
      </div>
    </div>

    <div class="w-full mb-xl">
      <h2 class="text-headline-md text-on-surface mb-lg">Wartungsmodus</h2>
      <div id="maintenance-card" class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <div class="flex items-center gap-md mb-md">
          <span id="maintenance-badge" class="inline-flex items-center px-4 py-1 rounded-full font-label-sm text-label-sm uppercase tracking-widest">–</span>
          <span id="maintenance-hint" class="text-body-sm text-on-surface-variant"></span>
        </div>
        <div class="mb-md">
          <label for="maintenance-message" class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant mb-sm block">Nachricht an Besucher (optional)</label>
          <textarea id="maintenance-message" rows="2" class="w-full bg-surface-container-highest text-on-surface rounded-xl px-lg py-md border border-outline/20 focus:border-primary focus:outline-none text-body-md resize-none" placeholder="Nachricht an Besucher (optional)"></textarea>
        </div>
        <button id="maintenance-toggle" class="font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full min-h-11 transition-colors">–</button>
      </div>
    </div>

    <div class="w-full mb-xl">
      <h2 class="text-headline-md text-on-surface mb-lg">Wachstum (14 Tage)</h2>
      <div id="growth-chart" class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <div class="flex gap-sm mb-md">
          <span class="inline-flex items-center gap-xs"><span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span><span class="font-label-sm text-label-sm text-on-surface-variant">User-Signups</span></span>
          <span class="inline-flex items-center gap-xs"><span class="w-3 h-3 rounded-full bg-primary inline-block"></span><span class="font-label-sm text-label-sm text-on-surface-variant">Fänge</span></span>
        </div>
        <div id="growth-bars" class="flex items-end gap-xs min-h-32"></div>
      </div>
    </div>

    <div class="w-full mb-xl">
      <h2 class="text-headline-md text-on-surface mb-lg">Integrations</h2>
      <div id="integrations-card" class="bg-surface-container-lowest rounded-2xl p-lg border border-outline/20">
        <p class="text-body-md text-on-surface-variant">Lade…</p>
      </div>
    </div>

    <div class="w-full">
      <h2 class="text-headline-md text-on-surface mb-lg">Offene Reports</h2>
      <div id="reports-list" class="space-y-3">
        <p class="text-body-md text-on-surface-variant">Lade…</p>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      // Wartungsmodus
      try {
        var mRes = await fetch("/api/admin/settings");
        if (mRes.ok) {
          var mData = await mRes.json();
          updateMaintenanceUI(mData.enabled, mData.message || "");
        }
      } catch {}

      var mToggle = document.getElementById("maintenance-toggle");
      var mMessage = document.getElementById("maintenance-message") as HTMLTextAreaElement;
      if (mToggle) {
        mToggle.addEventListener("click", async function() {
          var currentlyEnabled = mToggle.getAttribute("data-enabled") === "true";
          var msg = mMessage ? mMessage.value : "";
          try {
            var res = await fetch("/api/admin/settings", {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ enabled: !currentlyEnabled, message: msg }),
            });
            if (res.ok) {
              updateMaintenanceUI(!currentlyEnabled, msg);
            }
          } catch {}
        });
      }

      try {
        const res = await fetch("/api/admin/stats");
        if (!res.ok) return;
        const { stats, growth, stripeEvents } = await res.json();
        for (const [key, value] of Object.entries(stats)) {
          const el = document.querySelector('[data-kpi="' + key + '"]');
          if (el) {
            el.textContent = String(value);
            if (key === "openReports" && typeof value === "number" && value > 0) {
              (el as HTMLElement).style.color = "var(--color-error, #b3261e)";
            }
          }
        }
        const openReports2 = document.querySelector('[data-kpi="openReports2"]');
        if (openReports2) {
          openReports2.textContent = String(stats.openReports ?? 0);
          if ((stats.openReports ?? 0) > 0) (openReports2 as HTMLElement).style.color = "var(--color-error, #b3261e)";
        }

        if (growth) {
          var barContainer = document.getElementById("growth-bars");
          if (barContainer) {
            barContainer.innerHTML = "";
            var days = Object.keys(growth.userSignupsByDay || {});
            var maxVal = 0;
            days.forEach(function(day) {
              var uv = (growth.userSignupsByDay && growth.userSignupsByDay[day]) || 0;
              var cv = (growth.catchesByDay && growth.catchesByDay[day]) || 0;
              if (uv > maxVal) maxVal = uv;
              if (cv > maxVal) maxVal = cv;
            });
            if (maxVal === 0) maxVal = 1;
            days.forEach(function(day) {
              var col = document.createElement("div");
              col.className = "flex-1 flex flex-col items-center gap-xs";
              var barWrapper = document.createElement("div");
              barWrapper.className = "w-full flex items-end gap-xs justify-center min-h-32";
              var uv = (growth.userSignupsByDay && growth.userSignupsByDay[day]) || 0;
              var cv = (growth.catchesByDay && growth.catchesByDay[day]) || 0;
              var barU = document.createElement("div");
              barU.className = "w-2 rounded-t bg-green-500 transition-all duration-300";
              var pctU = (uv / maxVal) * 100;
              barU.style.height = pctU + "%";
              barU.style.minHeight = uv > 0 ? "4px" : "0";
              var barC = document.createElement("div");
              barC.className = "w-2 rounded-t bg-primary transition-all duration-300";
              var pctC = (cv / maxVal) * 100;
              barC.style.height = pctC + "%";
              barC.style.minHeight = cv > 0 ? "4px" : "0";
              barWrapper.appendChild(barU);
              barWrapper.appendChild(barC);
              col.appendChild(barWrapper);
              var lbl = document.createElement("span");
              lbl.className = "font-label-sm text-label-sm text-on-surface-variant";
              lbl.style.fontSize = "0.55rem";
              lbl.textContent = day.slice(5);
              col.appendChild(lbl);
              barContainer.appendChild(col);
            });
          }
        }
      } catch {}

      try {
        var intRes = await fetch("/api/admin/integrations");
        if (intRes.ok) {
          var intData = await intRes.json();
          var intCard = document.getElementById("integrations-card");
          if (intCard) {
            var services = [
              { key: "stripe_keys", label: "Stripe" },
              { key: "openrouter", label: "KI-Assistent" },
              { key: "vapid", label: "Push" },
              { key: "service_role", label: "Service-Role" },
              { key: "realtime", label: "Realtime" },
            ];
            intCard.innerHTML = '<div class="flex flex-wrap gap-lg">' +
              services.map(function(s) {
                var ok = !!intData[s.key];
                var dot = ok
                  ? '<span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>'
                  : '<span class="w-3 h-3 rounded-full bg-error inline-block"></span>';
                return '<div class="flex items-center gap-sm">' + dot + '<span class="text-body-md text-on-surface">' + s.label + '</span></div>';
              }).join("") +
              '</div>';
          }
        }
      } catch {}

      try {
        var repRes = await fetch("/api/admin/reports?status=open");
        if (!repRes.ok) return;
        var repData = await repRes.json();
        var container = document.getElementById("reports-list");
        if (!container) return;

        if (!repData.reports || repData.reports.length === 0) {
          container.innerHTML = '<p class="text-body-md text-on-surface-variant">Keine offenen Reports.</p>';
          return;
        }

        container.innerHTML = repData.reports
          .slice(0, 10)
          .map(function(r: any) {
            var date = new Date(r.created_at).toLocaleDateString("de-DE");
            var preview = "";
            if (r.preview) {
              if (r.target_type === "catch") {
                var parts = [];
                if (r.preview.species) parts.push(r.preview.species);
                if (r.preview.weight_kg) parts.push(r.preview.weight_kg + " kg");
                if (r.preview.water_name) parts.push(r.preview.water_name);
                preview = parts.join(" · ");
              } else if (r.target_type === "forum_thread") {
                preview = r.preview.title || r.preview.body || "";
              } else if (r.target_type === "forum_post" || r.target_type === "chat_message") {
                preview = (r.preview.body || "").slice(0, 100);
              } else if (r.target_type === "marketplace_item") {
                preview = r.preview.title || "";
              }
            }
            var previewHtml = preview ? '<p class="text-body-sm text-on-surface bg-surface-container-high rounded-lg px-3 py-2 mt-sm">' + escapeHtml(preview) + '</p>' : '';
            return '<a href="/admin/reports/" class="block bg-surface-container-lowest rounded-xl p-lg border border-outline/20 hover:border-primary/40 transition-colors">' +
              '<div class="flex justify-between items-start gap-4">' +
              '<div>' +
              '<p class="font-label-sm text-label-sm uppercase tracking-widest text-primary mb-sm">' + escapeHtml(r.target_type) + '</p>' +
              '<p class="text-body-md text-on-surface">' + escapeHtml(r.reason || "Kein Grund angegeben") + '</p>' +
              previewHtml +
              '</div>' +
              '<span class="text-body-sm text-on-surface-variant whitespace-nowrap">' + date + '</span>' +
              '</div>' +
              '</a>';
          })
          .join("");
      } catch {}
    });

    function escapeHtml(str: string) {
      var div = document.createElement("div");
      div.appendChild(document.createTextNode(str || ""));
      return div.innerHTML;
    }

    function updateMaintenanceUI(enabled: boolean, message: string) {
      var badge = document.getElementById("maintenance-badge");
      var hint = document.getElementById("maintenance-hint");
      var toggle = document.getElementById("maintenance-toggle");
      var msgInput = document.getElementById("maintenance-message") as HTMLTextAreaElement;
      if (badge) {
        if (enabled) {
          badge.textContent = "WARTUNGSMODUS AKTIV";
          badge.className = "inline-flex items-center px-4 py-1 rounded-full font-label-sm text-label-sm uppercase tracking-widest bg-error-container text-on-error-container";
        } else {
          badge.textContent = "WARTUNGSMODUS AUS";
          badge.className = "inline-flex items-center px-4 py-1 rounded-full font-label-sm text-label-sm uppercase tracking-widest bg-primary-container text-on-primary-container";
        }
      }
      if (hint) {
        hint.textContent = enabled ? "Besucher sehen aktuell die Wartungsseite." : "";
      }
      if (toggle) {
        toggle.textContent = enabled ? "WARTUNGSMODUS DEAKTIVIEREN" : "WARTUNGSMODUS AKTIVIEREN";
        toggle.setAttribute("data-enabled", String(enabled));
        toggle.className = enabled
          ? "font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full min-h-11 transition-colors bg-error-container text-on-error-container hover:opacity-90"
          : "font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full min-h-11 transition-colors bg-primary-container text-on-primary-container hover:opacity-90";
      }
      if (msgInput) {
        msgInput.value = message || "";
      }
    }
  </script>
</Layout>
