            <div class="pt-xl flex justify-end">
              <button type="submit" id="submit-btn" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase py-4 px-8 rounded-full hover:bg-surface-tint transition-colors shadow-sm w-full md:w-auto min-h-12 disabled:opacity-50 disabled:cursor-not-allowed i18n" data-de={t("fang_erfassen.speichern", "de")} data-en={t("fang_erfassen.speichern", "en")}>
                {t("fang_erfassen.speichern")}
              </button>
