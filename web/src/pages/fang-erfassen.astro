        <div id="drafts-container" class="hidden mt-lg">
          <div class="bg-surface-container-high rounded-xl border border-primary/40 p-lg shadow-sm">
            <div class="flex items-center justify-between mb-md">
              <h2 class="font-headline-md text-headline-md text-primary i18n" data-de={t("fang_erfassen.offene_drafts", "de")} data-en={t("fang_erfassen.offene_drafts", "en")}>{t("fang_erfassen.offene_drafts")}</h2>
              <button id="draft-sync-btn" class="font-nav-item text-nav-item uppercase py-2 px-4 rounded-full bg-primary-container text-on-primary-container hover:bg-surface-tint transition-colors text-sm cursor-pointer i18n" data-de={t("fang_erfassen.jetzt_syncen", "de")} data-en={t("fang_erfassen.jetzt_syncen", "en")}>
                {t("fang_erfassen.jetzt_syncen")}
              </button>
            </div>
            <div id="draft-list" class="flex flex-col gap-sm"></div>
          </div>
        </div>
      </>
    )}
  </main>
</Layout>

<script is:inline define:vars={{ userTripsJson }}>
(function () {
  var SUPABASE_URL = document.body.dataset.supabaseUrl || "";
  var SUPABASE_ANON_KEY = document.body.dataset.supabaseAnonKey || "";

  var userTrips = [];
  try { userTrips = JSON.parse(userTripsJson); } catch (e) { userTrips = []; }

  // Populate trip select
  var tripSelect = document.getElementById('trip-select');
  if (tripSelect && userTrips.length > 0) {
    userTrips.forEach(function (t) {
      var opt = document.createElement('option');
      opt.value = t.id;
      opt.textContent = t.name;
      tripSelect.appendChild(opt);
    });
  }

  function genClientUuid() {
    if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
      return crypto.randomUUID();
    }
    if (typeof crypto !== "undefined" && typeof crypto.getRandomValues === "function") {
      var buf = new Uint8Array(16);
      crypto.getRandomValues(buf);
      buf[6] = (buf[6] & 0x0f) | 0x40;
      buf[8] = (buf[8] & 0x3f) | 0x80;
      var hex = Array.from(buf, function (b) { return b.toString(16).padStart(2, "0"); }).join("");
      return hex.slice(0, 8) + "-" + hex.slice(8, 12) + "-" + hex.slice(12, 16) + "-" + hex.slice(16, 20) + "-" + hex.slice(20);
    }
    return "f" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10);
  }

  var DB_NAME = 'carp24-offline';
  var DB_VERSION = 1;
  var STORE_NAME = 'drafts';

  function openDB(cb) {
    var req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = function () {
      var db = req.result;
      if (!db.objectStoreNames.contains(STORE_NAME)) {
        db.createObjectStore(STORE_NAME, { keyPath: 'client_uuid' });
      }
    };
    req.onsuccess = function () { cb(null, req.result); };
    req.onerror = function () { cb(req.error); };
  }

  function queueDraft(draft, cb) {
    openDB(function (err, db) {
      if (err) { cb(err); return; }
      var tx = db.transaction(STORE_NAME, 'readwrite');
      tx.objectStore(STORE_NAME).put(draft);
      tx.oncomplete = function () {
        window.dispatchEvent(new CustomEvent('draft-queued'));
        cb(null);
      };
      tx.onerror = function () { cb(tx.error); };
    });
  }

  function getDrafts(cb) {
    openDB(function (err, db) {
      if (err) { cb(err); return; }
      var tx = db.transaction(STORE_NAME, 'readonly');
      var req = tx.objectStore(STORE_NAME).getAll();
      req.onsuccess = function () { cb(null, req.result); };
      req.onerror = function () { cb(req.error); };
    });
  }

  function removeDraft(uuid, cb) {
    openDB(function (err, db) {
      if (err) { cb(err); return; }
      var tx = db.transaction(STORE_NAME, 'readwrite');
      tx.objectStore(STORE_NAME).delete(uuid);
      tx.oncomplete = function () { cb(null); };
      tx.onerror = function () { cb(tx.error); };
    });
  }

  function syncDrafts() {
    if (window.__syncing) return;
    window.__syncing = true;
    var sb = getSupabase();
    if (!sb) { window.__syncing = false; return; }
    getDrafts(function (err, drafts) {
      if (err || !drafts || !drafts.length) { window.__syncing = false; return; }
      var chain = Promise.resolve();
      drafts.forEach(function (draft) {
        chain = chain.then(function () {
          return sb.rpc('sync_catch', { p_client_uuid: draft.client_uuid, p_data: draft.p_data })
            .then(function (res) {
              if (!res.error) {
                return new Promise(function (resolve) {
                  removeDraft(draft.client_uuid, function () { resolve(); });
                });
              }
            })
            .catch(function () {});
        });
      });
      chain.then(function () {
        window.__syncing = false;
        window.dispatchEvent(new CustomEvent('drafts-synced'));
        renderDraftList();
      });
    });
  }

  function renderDraftList() {
    var list = document.getElementById('draft-list');
    var container = document.getElementById('drafts-container');
    if (!list || !container) return;
    getDrafts(function (err, drafts) {
      if (err || !drafts || !drafts.length) {
        container.classList.add('hidden');
        return;
      }
      container.classList.remove('hidden');
      list.innerHTML = '';
      drafts.forEach(function (d) {
        var p = d.p_data || {};
        var date = p.catch_ts ? new Date(p.catch_ts).toLocaleDateString('de-DE') : '';
        var weight = p.weight_kg ? p.weight_kg + ' kg' : '';
        var species = p.species || '';
        var el = document.createElement('div');
        el.className = 'flex items-center justify-between py-sm px-md bg-surface-container-lowest rounded border border-primary/10';
        el.innerHTML = '<div class="flex gap-md text-body-md items-center">' +
          '<span class="text-secondary">' + escapeHtml(date) + '</span>' +
          '<span class="text-on-surface font-nav-item text-nav-item uppercase">' + escapeHtml(species) + '</span>' +
          '<span class="text-secondary">' + escapeHtml(weight) + '</span>' +
          '</div>';
        list.appendChild(el);
      });
    });
  }

  function getSupabase() {
    if (window.__supabase) return window.__supabase;
    if (typeof window.supabase !== 'undefined' && window.supabase.createClient) {
      window.__supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true, storageKey: "sb-carp24-auth-token" },
        cookieOptions: { path: '/', sameSite: 'lax', secure: window.location.protocol === 'https:' }
      });
      return window.__supabase;
    }
    return null;
  }

  var form = document.getElementById('catch-form');
  if (!form) return;

  var speciesChips = document.querySelectorAll('.species-chip');
  var speciesInput = document.getElementById('species');
  var gewaesserInput = document.getElementById('gewaesser-input');
  var gewaesserDropdown = document.getElementById('gewaesser-dropdown');
  var waterNameInput = document.getElementById('water_name');
  var waterIdInput = document.getElementById('water_id');
  var latInput = document.getElementById('lat');
  var lngInput = document.getElementById('lng');
  var gpsBtn = document.getElementById('gps-btn');
  var gpsStatus = document.getElementById('gps-status');
  var photoDrop = document.getElementById('photo-drop');
  var photoInput = document.getElementById('photo-input');
  var photoName = document.getElementById('photo-name');
  var photosInput = document.getElementById('photos');
  var notizen = document.getElementById('notizen');
  var notesCounter = document.getElementById('notes-counter');
  var gewichtInput = document.getElementById('gewicht');
  var submitBtn = document.getElementById('submit-btn');
  var submitError = document.getElementById('submit-error');
  var submitSuccess = document.getElementById('submit-success');

  var debounceTimer = null;

  speciesChips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      speciesChips.forEach(function (c) {
        c.classList.remove('bg-primary-container', 'text-on-primary-container');
        c.classList.add('text-on-surface-variant');
      });
      chip.classList.add('bg-primary-container', 'text-on-primary-container');
      chip.classList.remove('text-on-surface-variant');
      speciesInput.value = chip.getAttribute('data-species');
    });
  });

  gewichtInput.addEventListener('input', function () {
    this.value = this.value.replace(',', '.');
  });

  notizen.addEventListener('input', function () {
    notesCounter.textContent = this.value.length + ' / 1000';
  });

  gewaesserInput.addEventListener('input', function () {
    var q = this.value.trim();
    if (q.length < 2) {
      gewaesserDropdown.classList.add('hidden');
      return;
    }
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () {
      fetchWaters(q);
    }, 300);
  });

  gewaesserInput.addEventListener('blur', function () {
    setTimeout(function () {
      gewaesserDropdown.classList.add('hidden');
    }, 200);
  });

  function fetchWaters(query) {
    if (!navigator.onLine) {
      gewaesserDropdown.classList.add('hidden');
      return;
    }
    var sb = getSupabase();
    if (!sb) return;
    sb.functions.invoke('gewaesser-search', { body: { query: query } }).then(function (res) {
      if (res.error || !res.data) {
        gewaesserDropdown.classList.add('hidden');
        return;
      }
      var results = res.data;
      if (!results.length) {
        gewaesserDropdown.classList.add('hidden');
        return;
      }
      gewaesserDropdown.innerHTML = '';
      results.forEach(function (w) {
        var item = document.createElement('div');
        item.className = 'px-4 py-3 cursor-pointer hover:bg-surface-container-high transition-colors border-b border-primary/10 last:border-0';
        item.innerHTML = '<div class="text-body-md text-on-surface">' + escapeHtml(w.name) + '</div>' +
          '<div class="text-body-md text-on-surface-variant text-xs">' + w.lat.toFixed(4) + ', ' + w.lng.toFixed(4) + '</div>';
        item.addEventListener('mousedown', function (e) {
          e.preventDefault();
          gewaesserInput.value = w.name;
          waterNameInput.value = w.name;
          latInput.value = w.lat;
          lngInput.value = w.lng;
          gewaesserDropdown.classList.add('hidden');
        });
        gewaesserDropdown.appendChild(item);
      });
      gewaesserDropdown.classList.remove('hidden');
    });
  }

  gpsBtn.addEventListener('click', function () {
    if (!navigator.geolocation) {
      gpsStatus.textContent = 'Geolocation nicht unterstützt';
      gpsStatus.classList.remove('hidden');
      return;
    }
    gpsStatus.textContent = 'Standort wird ermittelt…';
    gpsStatus.classList.remove('hidden');
    navigator.geolocation.getCurrentPosition(
      function (pos) {
        latInput.value = pos.coords.latitude.toFixed(6);
        lngInput.value = pos.coords.longitude.toFixed(6);
        gpsStatus.textContent = 'Standort erfasst ✓';
        gpsStatus.classList.add('text-primary');
      },
      function (err) {
        gpsStatus.textContent = 'Fehler: ' + err.message;
        gpsStatus.classList.remove('text-primary');
      },
      { enableHighAccuracy: true, timeout: 10000 }
    );
  });

  photoDrop.addEventListener('click', function () {
    photoInput.click();
  });
  photoDrop.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      photoInput.click();
    }
  });

  photoInput.addEventListener('change', function () {
    if (!this.files || !this.files[0]) return;
    var file = this.files[0];
    photoName.textContent = file.name;
    photoName.classList.remove('hidden');

    // HEIC detection — browsers can't decode HEIC natively
    var isHeic = file.type === 'image/heic' || file.type === 'image/heif' ||
                 file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif');

    var sb = getSupabase();
    if (!sb) {
      showSubmitError('Foto-Upload nicht möglich — offline. Foto wird beim Sync hochgeladen.');
      return;
    }
    sb.auth.getUser().then(function (ur) {
      var userId = ur.data && ur.data.user ? ur.data.user.id : null;
      if (!userId) {
        showSubmitError('Foto-Upload fehlgeschlagen: nicht angemeldet.');
        return;
      }
      var processImage = function (blob) {
        // createImageBitmap handles large images better on mobile than new Image()
        createImageBitmap(blob).then(function (bitmap) {
          var maxDim = 1600;
          var scale = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
          var canvas = document.createElement('canvas');
          canvas.width = Math.round(bitmap.width * scale);
          canvas.height = Math.round(bitmap.height * scale);
          var ctx = canvas.getContext('2d');
          ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          bitmap.close(); // free memory
          // Try WebP first (smaller), fallback to JPEG
          canvas.toBlob(function (blob) {
            if (!blob) {
              canvas.toBlob(function (blob2) {
                uploadPhotoBlob(blob2, 'image/jpeg', '.jpg');
              }, 'image/jpeg', 0.80);
              return;
            }
            uploadPhotoBlob(blob, 'image/webp', '.webp');
          }, 'image/webp', 0.80);
        }).catch(function (e) {
          console.error('Image decode failed:', e);
          showSubmitError('Foto konnte nicht gelesen werden: ' + (e.message || 'Unbekannter Fehler'));
        });
      };
      function uploadPhotoBlob(blob, mime, ext) {
          var filePath = userId + '/' + genClientUuid() + ext;
          sb.storage.from('catch-photos').upload(filePath, blob, { contentType: mime }).then(function (res) {
            if (res.error) {
              showSubmitError('Foto-Upload fehlgeschlagen: ' + res.error.message);
              return;
            }
            photosInput.value = JSON.stringify(['foto:' + filePath]);
            photoName.textContent = file.name + ' (optimiert)';
          });
      }
      // HEIC → convert via canvas, otherwise process directly
      if (isHeic) {
        photoName.textContent = file.name + ' (HEIC → WebP konvertiert...)';
        // Use createImageBitmap for HEIC — supported in Safari 16+
        createImageBitmap(file).then(function (bitmap) {
          var c = document.createElement('canvas');
          c.width = bitmap.width;
          c.height = bitmap.height;
          c.getContext('2d').drawImage(bitmap, 0, 0);
          c.toBlob(function (blob) {
            if (blob) processImage(blob);
            else showSubmitError('HEIC-Konvertierung fehlgeschlagen.');
          }, 'image/jpeg', 0.90);
        }).catch(function () {
          showSubmitError('HEIC nicht unterstützt in diesem Browser. Bitte JPG/PNG verwenden.');
        });
      } else {
        processImage(file);
      }
    });
  });

  function buildInputData() {
    var gewicht = parseFloat(gewichtInput.value);
    if (!gewicht || gewicht <= 0) {
      showSubmitError('Bitte ein gültiges Gewicht eingeben.');
      return null;
    }

    var species = speciesInput.value;
    if (!species) {
      showSubmitError('Bitte eine Fischart auswählen.');
      return null;
    }

    var datum = document.getElementById('datum').value;
    if (!datum) {
      showSubmitError('Bitte ein Datum eingeben.');
      return null;
    }

    var uhrzeit = document.getElementById('uhrzeit').value;
    var catch_ts = datum + (uhrzeit ? 'T' + uhrzeit + ':00' : 'T12:00:00');

    var input = {
      catch_ts: new Date(catch_ts).toISOString(),
      species: species,
      weight_kg: gewicht,
    };

    var laenge = parseFloat(document.getElementById('laenge').value);
    if (laenge > 0) input.length_cm = laenge;

    var waterTemp = parseFloat(document.getElementById('water_temp_c').value);
    if (!isNaN(waterTemp) && waterTemp >= 0 && waterTemp <= 40) input.water_temp_c = waterTemp;

    var koeder = document.getElementById('koeder').value.trim();
    if (koeder) input.bait = koeder;

    var methode = document.getElementById('methode').value.trim();
    if (methode) input.method = methode;

    var notes = notizen.value.trim();
    if (notes) input.notes = notes;

    var lat = parseFloat(latInput.value);
    var lng = parseFloat(lngInput.value);
    if (!isNaN(lat)) input.lat = lat;
    if (!isNaN(lng)) input.lng = lng;

    var wn = waterNameInput.value;
    if (wn) input.water_name = wn;
    var wid = waterIdInput.value;
    if (wid) input.water_id = wid;

    var photosVal = photosInput.value;
    if (photosVal) {
      try { input.photos = JSON.parse(photosVal); } catch (e) { input.photos = [photosVal]; }
    }

    return input;
  }

  function showBadgeToast(data) {
    var codes = data.map(function (d) { return typeof d === 'string' ? d : d.code || d.badge_code || d.badge_id; });
    if (codes.length === 0) return;
    var sb = getSupabase();
    if (!sb) return;
    sb.from("badges").select("code, name, id").then(function (res) {
      if (res.error || !res.data) return;
      var nameMap = {};
      res.data.forEach(function (b) {
        nameMap[b.code] = b.name;
        nameMap[b.id] = b.name;
      });
      codes.forEach(function (code, i) {
        var name = nameMap[code] || code;
        setTimeout(function () {
          var toast = document.createElement("div");
          toast.className = "fixed top-4 right-4 z-50 bg-primary-container text-on-primary-container px-6 py-4 rounded-xl shadow-lg flex items-center gap-3 cursor-pointer";
          toast.style.opacity = "1";
          toast.style.transition = "opacity 0.3s";
          toast.textContent = "Neues Badge: " + name;
          toast.addEventListener("click", function () { toast.remove(); });
          document.body.appendChild(toast);
          setTimeout(function () {
            toast.style.opacity = "0";
            setTimeout(function () { toast.remove(); }, 300);
          }, 4000);
        }, i * 500);
      });
    });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    hideMessages();

    var input = buildInputData();
    if (!input) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'WIRD GESPEICHERT…';

    if (!navigator.onLine) {
      var client_uuid = genClientUuid();
      var draft = {
        client_uuid: client_uuid,
        p_data: Object.assign({}, input, {
          draft: false,
          weather_auto: false,
          client_updated_at: new Date().toISOString(),
        }),
        created_at: new Date().toISOString(),
      };
      queueDraft(draft, function (err) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'FANG SPEICHERN';
        if (err) {
          showSubmitError('Fehler beim lokalen Speichern: ' + err);
        } else {
          submitSuccess.textContent = 'Offline gespeichert — wird automatisch synchronisiert.';
          submitSuccess.classList.remove('hidden');
          renderDraftList();
          form.reset();
          speciesChips.forEach(function (c) {
            c.classList.remove('bg-primary-container', 'text-on-primary-container');
            c.classList.add('text-on-surface-variant');
          });
          speciesInput.value = '';
          var now = new Date();
          document.getElementById('datum').value = now.toISOString().split('T')[0];
          document.getElementById('uhrzeit').value = now.toTimeString().slice(0, 5);
          notesCounter.textContent = '0 / 1000';
        }
      });
      return;
    }

    saveCatchViaRpc(input, function (result) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'FANG SPEICHERN';
      if (result.error) {
        showSubmitError('Fehler beim Speichern: ' + result.error);
      } else {
        submitSuccess.textContent = 'Fang erfolgreich gespeichert!';
        submitSuccess.classList.remove('hidden');
        if (tripSelect) tripSelect.value = '';
        var sb = getSupabase();
        var isPublicCheckbox = document.getElementById('is_public');
        if (sb && isPublicCheckbox && isPublicCheckbox.checked && result.id) {
          sb.from("catches").update({ is_public: true }).eq("id", result.id).then(function () {});
        }
        if (sb) {
          sb.auth.getUser().then(function (ur) {
            var userId = ur.data && ur.data.user ? ur.data.user.id : null;
            if (userId) {
              sb.rpc('check_badges', { p_user_id: userId, p_imported: false }).then(function (badgeRes) {
                if (badgeRes.data && Array.isArray(badgeRes.data) && badgeRes.data.length > 0) {
                  showBadgeToast(badgeRes.data);
                }
              }).catch(function () {});
            }
          });
        }
        setTimeout(function () {
          window.location.href = '/faenge';
        }, 1200);
      }
    });
  });

  function fetchWeatherForCatch(catchId, lat, lng, catchTs, cb) {
    if (!lat || !lng) { cb(null); return; }
    fetch('/api/catches/weather', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ catch_id: catchId, lat: lat, lng: lng, catch_ts: catchTs }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.ok) {
          console.warn('[WEATHER] Fetch failed:', data.error);
        }
        cb(null);
      })
      .catch(function (err) {
        console.warn('[WEATHER] Network error:', err);
        cb(null);
      });
  }

  function saveCatchViaRpc(input, cb) {
    var sb = getSupabase();
    if (!sb) {
      cb({ error: 'Supabase nicht initialisiert' });
      return;
    }
    var client_uuid = genClientUuid();
    var p_data = Object.assign({}, input, {
      draft: false,
      weather_auto: false,
      client_updated_at: new Date().toISOString(),
    });
    sb.rpc('sync_catch', { p_client_uuid: client_uuid, p_data: p_data }).then(function (res) {
      if (res.error) {
        cb({ error: res.error.message });
        return;
      }
      var catch_id = res.data;
      var tripId = tripSelect ? tripSelect.value || null : null;
      var rpcParams = { p_catch_id: catch_id };
      if (tripId) rpcParams.p_trip_id = tripId;
      sb.rpc('publish_catch', rpcParams).then(function (pubRes) {
        if (pubRes.error) {
          cb({ id: catch_id, error: pubRes.error.message });
        } else {
          // Wetter automatisch abrufen (nur bei Koordinaten + innerhalb 24h)
          fetchWeatherForCatch(catch_id, input.lat, input.lng, input.catch_ts, function () {
            cb({ id: catch_id });
          });
        }
      });
    });
  }

  function showSubmitError(msg) {
    submitError.textContent = msg;
    submitError.classList.remove('hidden');
  }

  function hideMessages() {
    submitError.classList.add('hidden');
    submitSuccess.classList.add('hidden');
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  var now = new Date();
  document.getElementById('datum').value = now.toISOString().split('T')[0];
  document.getElementById('uhrzeit').value = now.toTimeString().slice(0, 5);

  var draftSyncBtn = document.getElementById('draft-sync-btn');
  if (draftSyncBtn) {
    draftSyncBtn.addEventListener('click', function () {
      draftSyncBtn.disabled = true;
      draftSyncBtn.textContent = '...';
      syncDrafts();
      setTimeout(function () {
        draftSyncBtn.disabled = false;
        draftSyncBtn.textContent = 'JETZT SYNCEN';
        renderDraftList();
      }, 2000);
    });
  }

  window.addEventListener('drafts-synced', function () {
    renderDraftList();
  });

  renderDraftList();
})();
</script>

<script>
  // Karten-Pick: Leaflet dynamisch, OSM-Tiles nur mit Klaro-Consent ("all")
  const mapPickBtn = document.getElementById("map-pick-btn");
  const mapContainer = document.getElementById("map-pick-container");
  const mapConsentHint = document.getElementById("map-consent-hint");
  const latInput = document.getElementById("lat");
  const lngInput = document.getElementById("lng");

  function hasMapConsent() {
    try { return localStorage.getItem("klaro-consent") === "all"; } catch (e) { return false; }
  }

  if (mapPickBtn && mapContainer && latInput && lngInput) {
    mapPickBtn.addEventListener("click", async function () {
      if (!hasMapConsent()) {
        if (mapConsentHint) mapConsentHint.classList.remove("hidden");
        return;
      }
      if (mapConsentHint) mapConsentHint.classList.add("hidden");
      mapContainer.classList.remove("hidden");
      const L = await import("leaflet");
      const pinIcon = L.divIcon({
        className: "",
        html: '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="42" viewBox="0 0 24 24" fill="none" stroke="#0b6e4f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3" fill="#0b6e4f" stroke="none"/></svg>',
        iconSize: [30, 42],
        iconAnchor: [15, 42],
      });
      let marker = null;
      if (!window.__mapPick) {
        window.__mapPick = L.map(mapContainer, { zoomControl: true, attributionControl: true });
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        }).addTo(window.__mapPick);
        window.__mapPick.on("click", function (e) {
          const lat = e.latlng.lat.toFixed(6);
          const lng = e.latlng.lng.toFixed(6);
          latInput.value = lat;
          lngInput.value = lng;
          if (marker) window.__mapPick.removeLayer(marker);
          marker = L.marker([lat, lng], { icon: pinIcon }).addTo(window.__mapPick);
        });
        const curLat = parseFloat(latInput.value);
        const curLng = parseFloat(lngInput.value);
        if (!isNaN(curLat) && !isNaN(curLng)) {
          window.__mapPick.setView([curLat, curLng], 13);
        } else {
          window.__mapPick.setView([47.5, 14.3], 7);
        }
      } else {
        window.__mapPick.invalidateSize();
      }
    });
  }
</script>
