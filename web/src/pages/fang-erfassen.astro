---
import Layout from "../layouts/Layout.astro";
import { createSSRClient } from "../lib/ssr-client";
import { t } from "../lib/i18n";

const supabase = createSSRClient(Astro);
import { escHtml } from "../lib/escape";
import "leaflet/dist/leaflet.css";

const { data: { session } } = await supabase.auth.getSession();
const isLoggedIn = !!session;

let userTrips: any[] = [];
if (isLoggedIn && session) {
  const { data } = await supabase
    .from("trips")
    .select("id, name")
    .eq("user_id", session.user.id)
    .order("created_at", { ascending: false });
  userTrips = data ?? [];
}
const userTripsJson = JSON.stringify(userTrips);
---

<Layout title="Carp24 – Neuen Fang eintragen" noindex>
  <main class="flex-grow w-full max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-xl">
    {!isLoggedIn ? (
      <div class="flex flex-col items-center justify-center py-3xl text-center gap-lg">
        <h1 class="text-display-lg text-primary mb-2 i18n" data-de={t("fang_erfassen.titel", "de")} data-en={t("fang_erfassen.titel", "en")}>{t("fang_erfassen.titel")}</h1>
