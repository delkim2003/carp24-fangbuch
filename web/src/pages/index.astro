---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carp24 – Jeder Fang zählt." class="i18n" data-de="Carp24 – Jeder Fang zählt." data-en="Carp24 – Every catch counts.">
  <!-- 1. Hero Section (Screen 1) -->
  <section class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-24 relative overflow-hidden flex flex-col md:flex-row items-center gap-12">
    <div class="w-full md:w-1/2 z-10 flex flex-col items-start gap-6">
      <span class="font-label-sm text-label-sm uppercase text-tertiary-container tracking-[0.15em] i18n" 
            data-de="Premium Editorial" 
            data-en="Premium Editorial">Premium Editorial</span>
      <h1 class="font-display-lg text-display-lg text-on-surface md:text-[56px] md:leading-[64px] font-bold max-w-lg i18n" 
          data-de="Jeder Fang zählt." 
          data-en="Every catch counts.">
        Jeder Fang zählt.
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md i18n" 
         data-de="Dein digitales Tagebuch für Momente, die bleiben. Präzise Dokumentation, edles Design, absolute Privatsphäre." 
         data-en="Your digital diary for moments that last. Precise documentation, elegant design, absolute privacy.">
        Dein digitales Tagebuch für Momente, die bleiben. Präzise Dokumentation, edles Design, absolute Privatsphäre.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-4 w-full sm:w-auto">
        <button class="bg-primary-container text-on-primary-container font-nav-item text-nav-item px-8 py-4 rounded-full min-h-12 hover:bg-primary transition-colors flex items-center justify-center gap-2 i18n" 
                data-de="Kostenlos starten" 
                data-en="Start free">
          Kostenlos starten
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <button class="border border-outline-variant text-on-surface font-nav-item text-nav-item px-8 py-4 rounded-full hover:bg-surface-variant transition-colors i18n" 
                data-de="Funktionen entdecken" 
                data-en="Discover features">
          Funktionen entdecken
        </button>
      </div>
    </div>
    <div class="w-full md:w-1/2 relative">
      <!-- Decorative Frame -->
      <div class="absolute -inset-4 border border-outline-variant/30 rounded-2xl z-0 pointer-events-none transform translate-x-4 translate-y-4"></div>
      <!-- Embedded Asset -->
      <img alt="Scenic lake at sunrise" class="w-full h-auto aspect-square object-cover rounded-xl border border-outline-variant/20 relative z-10 shadow-sm" src="/images/landing/stitch-0.jpg"/>
    </div>
  </section>


  <!-- 3. How it Works (Screen 2) -->
  <section class="max-w-[1280px] w-full mx-auto px-margin-mobile md:px-margin-desktop py-xl border-t border-hairline-olive">
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-center mb-[60px] i18n" 
        data-de="Drei Schritte. Kein Tutorial nötig." 
        data-en="Three steps. No tutorial needed.">Drei Schritte. Kein Tutorial nötig.</h2>
    <div class="flex flex-col md:flex-row justify-between items-center relative gap-xl md:gap-0">
      <!-- Connecting Line (Desktop only) -->
      <div class="hidden md:block absolute top-1/2 left-[15%] right-[15%] h-px bg-hairline-olive -translate-y-1/2 z-0"></div>
      <div class="flex flex-col items-center bg-surface-mist border border-hairline-olive p-lg z-10 w-full md:w-64">
        <svg class="w-6 h-6 text-[48px] text-deep-olive mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" width="48" height="48"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-on-surface i18n" 
            data-de="Fang erfassen" 
            data-en="Record catch">Fang erfassen</h3>
      </div>
      <div class="flex flex-col items-center bg-surface-mist border border-hairline-olive p-lg z-10 w-full md:w-64">
        <svg class="w-6 h-6 text-[48px] text-deep-olive mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" width="48" height="48"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 20V10M12 20V4M6 20v-6"/></svg>
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-on-surface i18n" 
            data-de="Muster sehen" 
            data-en="See patterns">Muster sehen</h3>
      </div>
      <div class="flex flex-col items-center bg-surface-mist border border-hairline-olive p-lg z-10 w-full md:w-64">
        <svg class="w-6 h-6 text-[48px] text-deep-olive mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" width="48" height="48"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-on-surface i18n" 
            data-de="Teilen &amp; vergleichen" 
            data-en="Share &amp; compare">Teilen &amp; vergleichen</h3>
      </div>
    </div>
  </section>

  <!-- 4. Features (Screen 2) -->
  <section class="max-w-[1280px] w-full mx-auto px-margin-mobile md:px-margin-desktop py-xl border-t border-hairline-olive bg-surface-container-low">
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-[60px] i18n" 
        data-de="Gebaut für echte Ansitze." 
        data-en="Built for real sessions.">Gebaut für echte Ansitze.</h2>
    <div class="grid grid-cols-1 md:grid-cols-6 gap-gutter">
      <!-- Bento Grid Layout -->
      <div class="md:col-span-4 bg-surface-mist border border-hairline-olive p-lg min-h-[200px]">
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-deep-olive mb-sm i18n" 
            data-de="Fang-Erfassung" 
            data-en="Catch Recording">Fang-Erfassung</h3>
        <p class="font-body-lg text-body-lg text-on-surface-variant i18n" 
           data-de="Dokumentiere Gewicht, Länge, Köder und Wetter in Sekunden. Minimalistisches Interface, maximaler Informationsgehalt." 
           data-en="Document weight, length, bait and weather in seconds. Minimalist interface, maximum information content.">Dokumentiere Gewicht, Länge, Köder und Wetter in Sekunden. Minimalistisches Interface, maximaler Informationsgehalt.</p>
      </div>
      <div class="md:col-span-2 bg-surface-mist border border-hairline-olive p-lg min-h-[200px]">
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-deep-olive mb-sm i18n" 
            data-de="Statistik" 
            data-en="Statistics">Statistik</h3>
        <p class="font-body-lg text-body-lg text-on-surface-variant i18n" 
           data-de="Detaillierte Analysen zu Mondphasen, Luftdruck und Erfolgsködern." 
           data-en="Detailed analyses of moon phases, air pressure and successful baits.">Detaillierte Analysen zu Mondphasen, Luftdruck und Erfolgsködern.</p>
      </div>
      <div class="md:col-span-2 bg-surface-mist border border-hairline-olive p-lg min-h-[200px]">
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-deep-olive mb-sm i18n" 
            data-de="Season Review" 
            data-en="Season Review">Season Review</h3>
        <p class="font-body-lg text-body-lg text-on-surface-variant i18n" 
           data-de="Ein eleganter Jahresrückblick deiner anglerischen Highlights." 
           data-en="An elegant yearly review of your angling highlights.">Ein eleganter Jahresrückblick deiner anglerischen Highlights.</p>
      </div>
      <div class="md:col-span-2 bg-surface-mist border border-hairline-olive p-lg min-h-[200px]">
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-deep-olive mb-sm i18n" 
            data-de="KI-Assistent" 
            data-en="AI Assistant">KI-Assistent</h3>
        <p class="font-body-lg text-body-lg text-on-surface-variant i18n" 
           data-de="Intelligente Vorschläge basierend auf historischen Fangdaten." 
           data-en="Intelligent suggestions based on historical catch data.">Intelligente Vorschläge basierend auf historischen Fangdaten.</p>
      </div>
      <div class="md:col-span-2 bg-surface-mist border border-hairline-olive p-lg min-h-[200px]">
        <h3 class="font-data-mono text-data-mono uppercase tracking-widest text-deep-olive mb-sm i18n" 
            data-de="Trips" 
            data-en="Trips">Trips</h3>
        <p class="font-body-lg text-body-lg text-on-surface-variant i18n" 
           data-de="Organisiere deine Sessions an verschiedenen Gewässern übersichtlich." 
           data-en="Organize your sessions at different waters clearly.">Organisiere deine Sessions an verschiedenen Gewässern übersichtlich.</p>
      </div>
    </div>
  </section>

  <!-- 5. Statistics (Screen 3) -->
  <section class="py-xl px-margin-mobile md:px-margin-desktop mt-xl">
    <div class="max-w-4xl mx-auto text-center mb-xl">
      <h2 class="font-headline-lg md:font-display-lg text-headline-lg md:text-display-lg text-primary mb-md i18n" 
          data-de="Wetterdaten treffen Fangdaten" 
          data-en="Weather data meets catch data">Wetterdaten treffen Fangdaten</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto i18n" 
         data-de="Carp24 verknüpft deine Fänge automatisch mit Luftdruck, Temperatur, Wind und Mondphase. Erkenne, wann die Karpfen beißen — basierend auf echten Daten." 
         data-en="Carp24 automatically links your catches to air pressure, temperature, wind and moon phase. Recognize when carp bite — based on real data.">Carp24 verknüpft deine Fänge automatisch mit Luftdruck, Temperatur, Wind und Mondphase. Erkenne, wann die Karpfen beißen — basierend auf echten Daten.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter max-w-5xl mx-auto">
      <div class="bg-surface-variant hairline-all rounded-xl p-lg text-center">
        <svg class="w-10 h-10 text-deep-olive mx-auto mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
        <h3 class="font-headline-md text-on-surface mb-sm i18n" data-de="Luftdruck" data-en="Air pressure">Luftdruck</h3>
        <p class="font-body-md text-on-surface-variant i18n" data-de="Erkenne Zusammenhänge zwischen Luftdruckänderungen und Bissbereitschaft." data-en="Recognize connections between air pressure changes and bite activity.">Erkenne Zusammenhänge zwischen Luftdruckänderungen und Bissbereitschaft.</p>
      </div>
      <div class="bg-surface-variant hairline-all rounded-xl p-lg text-center">
        <svg class="w-10 h-10 text-deep-olive mx-auto mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        <h3 class="font-headline-md text-on-surface mb-sm i18n" data-de="Mondphase" data-en="Moon phase">Mondphase</h3>
        <p class="font-body-md text-on-surface-variant i18n" data-de="Welche Mondphasen bringen die besten Ergebnisse an deinem Gewässer?" data-en="Which moon phases bring the best results at your water?">Welche Mondphasen bringen die besten Ergebnisse an deinem Gewässer?</p>
      </div>
      <div class="bg-surface-variant hairline-all rounded-xl p-lg text-center">
        <svg class="w-10 h-10 text-deep-olive mx-auto mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        <h3 class="font-headline-md text-on-surface mb-sm i18n" data-de="Wind & Temperatur" data-en="Wind & temperature">Wind & Temperatur</h3>
        <p class="font-body-md text-on-surface-variant i18n" data-de="Windrichtung, Temperatur und Wetterlage — alles in deinem Fangbuch." data-en="Wind direction, temperature and weather conditions — everything in your logbook.">Windrichtung, Temperatur und Wetterlage — alles in deinem Fangbuch.</p>
      </div>
    </div>
  </section>

  <!-- 6. App Preview (Screen 3) -->
  <section class="py-xl px-margin-mobile md:px-margin-desktop my-xl">
    <div class="text-center mb-xl">
      <h2 class="font-headline-lg md:font-display-lg text-headline-lg md:text-display-lg text-primary mb-md i18n" 
          data-de="Dein Fangbuch. Immer dabei." 
          data-en="Your logbook. Always with you.">Dein Fangbuch. Immer dabei.</h2>
    </div>
    <div class="max-w-5xl mx-auto bg-surface-container-low rounded-xl hairline-all p-4 md:p-xl shadow-sm relative overflow-hidden">
      <!-- Decorative grain overlay -->
      <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
      <!-- Mockup frame -->
      <div class="relative bg-surface rounded-lg hairline-all shadow-md overflow-hidden">
        <img src="/images/landing/dashboard-0.jpg" alt="Carp24 Dashboard" class="w-full h-auto" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 7. Community (Screen 2) -->
  <section class="max-w-[1280px] w-full mx-auto px-margin-mobile md:px-margin-desktop py-xl border-t border-hairline-olive">
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-center mb-[60px] i18n" 
        data-de="Teil einer Gemeinschaft" 
        data-en="Part of a community">Teil einer Gemeinschaft</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
      <div class="border border-hairline-olive bg-surface-mist p-sm flex flex-col">
        <div class="aspect-w-1 aspect-h-1 w-full relative mb-sm overflow-hidden bg-surface-dim">
          <img class="object-cover w-full h-full" alt="A high-quality editorial photograph of a large common carp being held gently at the water's edge during golden hour" src="/images/landing/stitch-1.jpg" loading="lazy"/>
        </div>
        <div class="flex justify-between items-center px-xs">
          <span class="font-data-mono text-data-mono text-on-surface i18n" data-de="24.5 KG" data-en="24.5 KG">24.5 KG</span>
          <span class="font-data-mono text-label-sm text-outline i18n" data-de="12. OKT 2023" data-en="12 OCT 2023">12. OKT 2023</span>
        </div>
      </div>
      <div class="border border-hairline-olive bg-surface-mist p-sm flex flex-col">
        <div class="aspect-w-1 aspect-h-1 w-full relative mb-sm overflow-hidden bg-surface-dim">
          <img class="object-cover w-full h-full" alt="Close-up of a trophy carp being weighed or measured on a soft mat" src="/images/landing/stitch-2.jpg" loading="lazy"/>
        </div>
        <div class="flex justify-between items-center px-xs">
          <span class="font-data-mono text-data-mono text-on-surface i18n" data-de="18.2 KG" data-en="18.2 KG">18.2 KG</span>
          <span class="font-data-mono text-label-sm text-outline i18n" data-de="05. SEP 2023" data-en="05 SEP 2023">05. SEP 2023</span>
        </div>
      </div>
      <div class="border border-hairline-olive bg-surface-mist p-sm flex flex-col">
        <div class="aspect-w-1 aspect-h-1 w-full relative mb-sm overflow-hidden bg-surface-dim">
          <img class="object-cover w-full h-full" alt="A premium close-up photo of a beautiful carp fish, natural colors, bright and clean editorial style" src="/images/landing/stitch-3.jpg" loading="lazy"/>
        </div>
        <div class="flex justify-between items-center px-xs">
          <span class="font-data-mono text-data-mono text-on-surface i18n" data-de="21.0 KG" data-en="21.0 KG">21.0 KG</span>
          <span class="font-data-mono text-label-sm text-outline i18n" data-de="28. AUG 2023" data-en="28 AUG 2023">28. AUG 2023</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Marketplace (Screen 3) -->
  <section class="py-xl px-margin-mobile md:px-margin-desktop my-xl bg-surface-container-low border-y border-primary/10">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-xl">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-md i18n" 
            data-de="Kauf &amp; Verkauf unter Anglern" 
            data-en="Buy &amp; sell among anglers">Kauf &amp; Verkauf unter Anglern</h2>
        <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto i18n" 
           data-de="Handele sicher mit hochwertigem Equipment aus der Community. Von Ruten über Köder bis zu Elektronik — alles an einem Ort." 
           data-en="Trade safely with high-quality equipment from the community. From rods to bait to electronics — everything in one place.">Handele sicher mit hochwertigem Equipment aus der Community. Von Ruten über Köder bis zu Elektronik — alles an einem Ort.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <div class="bg-surface-container-low rounded-xl p-lg text-center">
          <svg class="w-10 h-10 text-deep-olive mx-auto mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
          <h3 class="font-headline-md text-on-surface mb-sm i18n" data-de="Kleinanzeigen" data-en="Classifieds">Kleinanzeigen</h3>
          <p class="font-body-md text-on-surface-variant i18n" data-de="Biete oder suche Equipment direkt in der Community." data-en="Offer or search for equipment directly in the community.">Biete oder suche Equipment direkt in der Community.</p>
        </div>
        <div class="bg-surface-container-low rounded-xl p-lg text-center">
          <svg class="w-10 h-10 text-deep-olive mx-auto mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          <h3 class="font-headline-md text-on-surface mb-sm i18n" data-de="Kategorien" data-en="Categories">Kategorien</h3>
          <p class="font-body-md text-on-surface-variant i18n" data-de="Ruten, Rollen, Köder, Elektronik und Zubehör — alles sauber sortiert." data-en="Rods, reels, bait, electronics and accessories — everything neatly sorted.">Ruten, Rollen, Köder, Elektronik und Zubehör — alles sauber sortiert.</p>
        </div>
        <div class="bg-surface-container-low rounded-xl p-lg text-center">
          <svg class="w-10 h-10 text-deep-olive mx-auto mb-md" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <h3 class="font-headline-md text-on-surface mb-sm i18n" data-de="Community" data-en="Community">Community</h3>
          <p class="font-body-md text-on-surface-variant i18n" data-de="Direkt von Angler zu Angler — ohne Zwischenhändler." data-en="Directly from angler to angler — without middlemen.">Direkt von Angler zu Angler — ohne Zwischenhändler.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Pricing (Screen 4) -->
  <section class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-xl mb-xl">
    <div class="text-center mb-xl">
      <h2 class="font-display-lg text-headline-lg-mobile md:text-display-lg text-primary mb-md i18n" 
          data-de="Du zahlst nur, wenn du's ernst meinst." 
          data-en="You only pay when you're serious.">Du zahlst nur, wenn du's ernst meinst.</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto i18n" 
         data-de="Einfache, transparente Preise. Wähle den Plan, der zu deinem Angelstil passt." 
         data-en="Simple, transparent pricing. Choose the plan that fits your fishing style.">Einfache, transparente Preise. Wähle den Plan, der zu deinem Angelstil passt.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter max-w-4xl mx-auto">
      <!-- FREE Card -->
      <div class="bg-surface-variant rounded-xl border border-primary/20 p-lg md:p-xl flex flex-col justify-between h-full">
        <div>
          <h3 class="font-nav-item text-nav-item text-secondary mb-sm uppercase tracking-widest">FREE</h3>
          <div class="flex items-baseline gap-xs mb-lg border-b border-primary/15 pb-md">
            <span class="font-display-lg text-display-lg text-on-surface">0€</span>
            <span class="font-body-md text-body-md text-on-surface-variant i18n" data-de="/Monat" data-en="/month">/Monat</span>
          </div>
          <ul class="space-y-md mb-xl">
            <li class="flex items-start gap-sm font-body-md text-body-md text-on-surface-variant">
              <svg class="w-6 h-6 text-primary text-[20px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5"/></svg>
              <span class="i18n" data-de="Unbegrenzt Fänge" data-en="Unlimited catches">Unbegrenzt Fänge</span>
            </li>
            <li class="flex items-start gap-sm font-body-md text-body-md text-on-surface-variant">
