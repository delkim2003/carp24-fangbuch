  .conic-gradient {
    background: conic-gradient(
      #546140 0% 55%,      /* Primary Sage */
      #617a7c 55% 85%,    /* Tertiary Slate */
      #c6c8bc 85% 100%    /* Outline Variant */
    );
  }
</style>

<script>
  // i18n functionality
  const lang = localStorage.getItem("carp24-lang") || "de";
  document.documentElement.lang = lang;

  function applyI18n() {
    document.querySelectorAll(".i18n").forEach((el) => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) {
        el.innerHTML = text;
      }
    });
  }

  applyI18n();

  // Button click handlers
  document.querySelectorAll("button").forEach((btn) => {
    btn.addEventListener("click", function () {
      const text = this.textContent.trim().toLowerCase();
      
      // "Kostenlos starten" or "Register" → /login
      if (text.includes("kostenlos") || text.includes("registrieren") || text.includes("register") || text.includes("start free")) {
        window.location.href = "/login";
        return;
      }
      
      // "Funktionen entdecken" → scroll to features
      if (text.includes("funktionen") || text.includes("discover")) {
        const features = document.querySelector("h2[data-de*='Gebaut für echte']");
        if (features) {
          features.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        return;
      }
      
      // "Pro wählen" → /premium
      if (text.includes("pro") || text.includes("choose")) {
        window.location.href = "/premium";
        return;
      }
    });
  });
</script>