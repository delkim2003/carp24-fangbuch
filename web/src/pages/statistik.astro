---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Statistik">
  <div class="stats-page">
    <aside class="filter-sidebar" id="filterSidebar">
      <h2>Filter</h2>

      <div class="filter-section">
        <label>Zeitraum</label>
        <div class="pills" id="zeitraumPills">
          <button class="pill active" data-value="all">Alle</button>
          <button class="pill" data-value="7d">7 Tage</button>
          <button class="pill" data-value="30d">30 Tage</button>
          <button class="pill" data-value="90d">90 Tage</button>
          <button class="pill" data-value="1y">1 Jahr</button>
        </div>
      </div>

      <div class="filter-section">
        <label for="gewaesser">Gewässer</label>
        <select id="gewaesser"><option value="">Alle</option></select>
      </div>

      <div class="filter-section">
        <label for="koeder">Köder</label>
        <select id="koeder"><option value="">Alle</option></select>
      </div>

      <details class="filter-advanced">
        <summary>Weitere Filter</summary>
        <div class="filter-section">
          <label for="mondphase">Mondphase</label>
          <select id="mondphase"><option value="">Alle</option></select>
        </div>
        <div class="filter-section">
          <label for="wetter">Wetter</label>
          <select id="wetter"><option value="">Alle</option></select>
        </div>
        <div class="filter-section">
          <label>Gewicht (kg)</label>
          <div class="range-row">
            <input type="number" id="gewichtMin" placeholder="Min" min="0" step="0.1" />
            <span>–</span>
            <input type="number" id="gewichtMax" placeholder="Max" min="0" step="0.1" />
          </div>
        </div>
        <div class="filter-section">
          <label for="methode">Methode</label>
          <select id="methode"><option value="">Alle</option></select>
        </div>
        <div class="filter-section">
          <label>Wassertemp. (°C)</label>
          <div class="range-row">
            <input type="number" id="tempMin" placeholder="Min" step="0.5" />
            <span>–</span>
            <input type="number" id="tempMax" placeholder="Max" step="0.5" />
          </div>
        </div>
        <div class="filter-section">
          <label for="fischart">Fischart</label>
          <select id="fischart"><option value="">Alle</option></select>
        </div>
      </details>

      <button class="btn-apply" id="btnApply">Anwenden</button>
    </aside>

    <main class="stats-content">
      <h1>Fang-Statistiken</h1>

      <div class="kpi-row">
        <div class="kpi-card">
          <span class="kpi-value">0</span>
          <span class="kpi-label">GESAMTE FÄNGE</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">– KG</span>
          <span class="kpi-label">SCHWERSTER FANG</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">– KG</span>
          <span class="kpi-label">Ø GEWICHT</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">0</span>
          <span class="kpi-label">AKTIVE GEWÄSSER</span>
        </div>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Fänge nach Fischart</h3>
          <canvas id="donutChart" width="320" height="320"></canvas>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Fänge nach Gewässer</h3>
          <canvas id="gewaesserChart" width="400" height="260"></canvas>
        </section>
        <section class="chart-card">
          <h3>Mondphasen</h3>
          <canvas id="mondChart" width="400" height="260"></canvas>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>Fänge pro Monat</h3>
          <canvas id="monatChart" width="800" height="260"></canvas>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Gewichtsverlauf</h3>
          <div id="verlaufChart"></div>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Wetter-Korrelation</h3>
          <div id="wetterChart"></div>
        </section>
        <section class="chart-card wide">
          <h3>Beste Kombinationen</h3>
          <table class="kombi-table">
            <thead>
              <tr><th>Kombi</th><th>Fänge</th><th>Ø Gewicht</th></tr>
            </thead>
            <tbody id="kombiBody"></tbody>
          </table>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>🤖 KI-Analyse</h3>
          <div class="insight-cards">
            <div class="insight-card"><span class="insight-icon">⏰</span><span class="insight-text">Deine beste Fangzeit: <strong>–</strong> (Ø – kg)</span></div>
            <div class="insight-card"><span class="insight-icon">🌤️</span><span class="insight-text">Beste Wetterlage: <strong>–</strong> (Ø – kg)</span></div>
            <div class="insight-card"><span class="insight-icon">🎣</span><span class="insight-text">Bestes Köder: <strong>–</strong> (Ø – kg)</span></div>
          </div>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>🏆 Badges</h3>
          <div class="badges-progress">
            <span class="badges-count">0 / 0</span>
            <div class="badges-bar"><div class="badges-bar-fill" style="width: 0%"></div></div>
          </div>
          <div class="badges-grid" id="badgesGrid"></div>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>🗺️ Trips</h3>
          <div class="kpi-row">
            <div class="kpi-card">
              <span class="kpi-value">0</span>
              <span class="kpi-label">TRIPS</span>
            </div>
            <div class="kpi-card">
              <span class="kpi-value">– KG</span>
              <span class="kpi-label">Ø GEWICHT / TRIP</span>
            </div>
            <div class="kpi-card">
              <span class="kpi-value">–</span>
              <span class="kpi-label">BESTES GEWÄSSER</span>
            </div>
          </div>
          <table class="kombi-table">
            <thead>
              <tr><th>Datum</th><th>Gewässer</th><th>Fänge</th><th>Ø Gewicht</th><th>Max Gewicht</th></tr>
            </thead>
            <tbody id="tripsBody"></tbody>
          </table>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>📋 Fangdetails</h3>
          <table class="kombi-table">
            <thead>
              <tr><th>Datum</th><th>Gewicht</th><th>Fischart</th><th>Gewässer</th><th>Köder</th></tr>
            </thead>
            <tbody id="drilldownBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>

  <script>
    import { supabase } from '../lib/supabase-client';
    import uPlot from 'uplot';
    import 'uplot/dist/uPlot.min.css';

    const MONAT_NAMES = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
    function monatName(m: number) { return MONAT_NAMES[m - 1] ?? String(m); }

    function getFilters(): Record<string, any> {
      const f: Record<string, any> = {};
      const z = document.querySelector('#zeitraumPills .pill.active') as HTMLElement;
      if (z) f.zeitraum = z.dataset.value;
      const g = (document.getElementById('gewaesser') as HTMLSelectElement)?.value;
      if (g) f.gewaesser = g;
      const k = (document.getElementById('koeder') as HTMLSelectElement)?.value;
      if (k) f.koeder = k;
      const m = (document.getElementById('mondphase') as HTMLSelectElement)?.value;
      if (m) f.mondphase = m;
      const w = (document.getElementById('wetter') as HTMLSelectElement)?.value;
      if (w) f.wetter = w;
      const gMin = (document.getElementById('gewichtMin') as HTMLInputElement)?.value;
      const gMax = (document.getElementById('gewichtMax') as HTMLInputElement)?.value;
      if (gMin || gMax) f.gewicht = { min: gMin ? +gMin : null, max: gMax ? +gMax : null };
      const meth = (document.getElementById('methode') as HTMLSelectElement)?.value;
      if (meth) f.methode = meth;
      const tMin = (document.getElementById('tempMin') as HTMLInputElement)?.value;
      const tMax = (document.getElementById('tempMax') as HTMLInputElement)?.value;
      if (tMin || tMax) f.wassertemp = { min: tMin ? +tMin : null, max: tMax ? +tMax : null };
      const fa = (document.getElementById('fischart') as HTMLSelectElement)?.value;
      if (fa) f.fischart = fa;
      return f;
    }

    function drawDonut(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('donutChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 320, H = 320;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';

      const cx = W / 2, cy = H / 2, R = 120, r = 70;
      const total = data.reduce((s, d) => s + d.value, 0);
      if (total === 0) {
        ctx.clearRect(0, 0, W, H);
        return;
      }
      const palette = ['#6c7a57','#a3b18a','#dde5b6','#bfc0c0','#588157','#3a5a40','#344e41'];
      let start = -Math.PI / 2;

      data.forEach((d, i) => {
        const angle = (d.value / total) * Math.PI * 2;
        ctx.beginPath();
        ctx.arc(cx, cy, R, start, start + angle);
        ctx.arc(cx, cy, r, start + angle, start, true);
        ctx.closePath();
        ctx.fillStyle = palette[i % palette.length];
        ctx.fill();
        start += angle;
      });

      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-on-surface').trim() || '#222';
      ctx.font = 'bold 28px "Source Serif 4", serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(String(total), cx, cy - 10);
      ctx.font = '13px "Source Sans 3", sans-serif';
      ctx.fillText('Fänge', cx, cy + 14);

      let legend = canvas.parentElement!.querySelector('.donut-legend') as HTMLElement;
      if (!legend) {
        legend = document.createElement('div');
        legend.className = 'donut-legend';
        canvas.parentElement!.appendChild(legend);
      }
      legend.innerHTML = data.map((d, i) =>
        `<span><i style="background:${palette[i % palette.length]}"></i>${d.label} (${d.value})</span>`
      ).join('');
    }

    function drawGewaesser(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('gewaesserChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 400, H = 260;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.clearRect(0, 0, W, H);

      if (!data.length) return;
      const maxVal = Math.max(...data.map(d => d.value), 1);
      const barH = Math.min(28, (H - 20) / data.length - 4);
      const marginLeft = 120, marginRight = 50;

      data.forEach((d, i) => {
        const y = 10 + i * (barH + 4);
        const barW = ((W - marginLeft - marginRight) * d.value) / maxVal;
        ctx.fillStyle = '#6c7a57';
        ctx.fillRect(marginLeft, y, barW, barH);
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-on-surface').trim() || '#222';
        ctx.font = '12px "Source Sans 3", sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText(d.label, marginLeft - 8, y + barH / 2);
        ctx.textAlign = 'left';
        ctx.fillText(String(d.value), marginLeft + barW + 6, y + barH / 2);
      });
    }

    function drawMond(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('mondChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 400, H = 260;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.clearRect(0, 0, W, H);

      if (!data.length) return;
      const maxVal = Math.max(...data.map(d => d.value), 1);
      const marginLeft = 50, marginBottom = 40, marginTop = 20;
      const chartW = W - marginLeft - 20;
      const chartH = H - marginTop - marginBottom;
      const barW = Math.min(60, chartW / data.length - 8);

      data.forEach((d, i) => {
        const x = marginLeft + i * (chartW / data.length) + (chartW / data.length - barW) / 2;
        const barH = (chartH * d.value) / maxVal;
        ctx.fillStyle = '#6c7a57';
        ctx.fillRect(x, marginTop + chartH - barH, barW, barH);
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-on-surface').trim() || '#222';
        ctx.font = '11px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(d.label, x + barW / 2, H - marginBottom + 16);
        ctx.fillText(String(d.value), x + barW / 2, marginTop + chartH - barH - 6);
      });
    }

    function drawMonat(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('monatChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 800, H = 260;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.clearRect(0, 0, W, H);

      if (!data.length) return;
      const maxVal = Math.max(...data.map(d => d.value), 1);
      const marginLeft = 50, marginBottom = 40, marginTop = 20;
      const chartW = W - marginLeft - 20;
      const chartH = H - marginTop - marginBottom;
      const barW = Math.min(50, chartW / data.length - 8);

      data.forEach((d, i) => {
        const x = marginLeft + i * (chartW / data.length) + (chartW / data.length - barW) / 2;
        const barH = (chartH * d.value) / maxVal;
        ctx.fillStyle = '#6c7a57';
        ctx.fillRect(x, marginTop + chartH - barH, barW, barH);
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-on-surface').trim() || '#222';
        ctx.font = '11px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(d.label, x + barW / 2, H - marginBottom + 16);
        ctx.fillText(String(d.value), x + barW / 2, marginTop + chartH - barH - 6);
      });
    }

    function renderVerlauf(data: any[]) {
      const el = document.getElementById('verlaufChart');
      if (!el || !data.length) { if (el) el.innerHTML = '<p style="text-align:center;color:#999;padding:2rem;">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const months = data.map((d: any) => d.month);
      const avgW = data.map((d: any) => +d.avg_weight);
      const maxW = data.map((d: any) => +d.max_weight);

      const opts: uPlot.Options = {
        width: el.clientWidth || 500,
        height: 260,
        axes: [
          { stroke: '#888', grid: { stroke: '#dfe4d6' }, font: '12px "Source Sans 3", sans-serif' },
          { stroke: '#888', grid: { stroke: '#dfe4d6' }, font: '12px "Source Sans 3", sans-serif' },
        ],
        series: [
          {},
          { label: 'Ø Gewicht', stroke: '#6c7a57', width: 2, points: { show: true, size: 5 } },
          { label: 'Max Gewicht', stroke: '#a3b18a', width: 2, dash: [6, 3] },
        ],
      };
      new uPlot(opts, [months, avgW, maxW], el);
    }

    function renderWetter(data: any[]) {
      const el = document.getElementById('wetterChart');
      if (!el || !data.length) { if (el) el.innerHTML = '<p style="text-align:center;color:#999;padding:2rem;">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const labels = data.map((d: any) => d.weather_type);
      const counts = data.map((d: any) => +d.catch_count);

      const opts: uPlot.Options = {
        width: el.clientWidth || 500,
        height: 260,
        axes: [
          { stroke: '#888', grid: { stroke: '#dfe4d6' }, font: '12px "Source Sans 3", sans-serif' },
          { stroke: '#888', grid: { stroke: '#dfe4d6' }, font: '12px "Source Sans 3", sans-serif' },
        ],
        series: [
          {},
          { label: 'Fänge', stroke: '#6c7a57', bars: { show: true, width: 0.6, fill: '#6c7a57' } },
        ],
      };
      new uPlot(opts, [labels, counts], el);
    }

    function renderBadges(data: any[]) {
      const grid = document.getElementById('badgesGrid');
      if (!grid) return;
      const earned = data.filter((b: any) => b.erreicht).length;
      const total = data.length;
      const countEl = grid.parentElement!.querySelector('.badges-count');
      if (countEl) countEl.textContent = `${earned} / ${total}`;
      const fillEl = grid.parentElement!.querySelector('.badges-bar-fill') as HTMLElement;
      if (fillEl) fillEl.style.width = total ? `${Math.round(earned / total * 100)}%` : '0%';
      grid.innerHTML = data.map((b: any) => `
        <div class="badge-item ${b.erreicht ? 'badge-earned' : 'badge-locked'}">
          <span class="badge-icon">${b.icon ?? '🏅'}</span>
          <span class="badge-name">${b.name}</span>
          ${b.erreicht ? `<span class="badge-date">${b.erreicht_am ? new Date(b.erreicht_am).toLocaleDateString('de-DE') : ''}</span>` : ''}
        </div>
      `).join('');
    }

    function renderTrips(data: any) {
      const trips = data?.trips ?? [];
      const summary = data?.summary ?? {};
      const kpis = document.querySelectorAll('.stats-content .kpi-row:last-of-type .kpi-value');
      if (kpis[0]) kpis[0].textContent = String(summary.trip_anzahl ?? 0);
      if (kpis[1]) kpis[1].textContent = (summary.avg_gewicht ?? '–') + ' KG';
      if (kpis[2]) kpis[2].textContent = summary.bestes_gewaesser ?? '–';
      const tbody = document.getElementById('tripsBody');
      if (tbody) {
        tbody.innerHTML = trips.map((t: any) => `
          <tr>
            <td>${t.datum ? new Date(t.datum).toLocaleDateString('de-DE') : '–'}</td>
            <td>${t.gewaesser ?? '–'}</td>
            <td>${t.fangzahl ?? 0}</td>
            <td>${t.avg_gewicht ? Number(t.avg_gewicht).toFixed(1) + ' kg' : '–'}</td>
            <td>${t.max_gewicht ? Number(t.max_gewicht).toFixed(1) + ' kg' : '–'}</td>
          </tr>
        `).join('');
      }
    }

    function renderDrilldown(data: any[]) {
      const tbody = document.getElementById('drilldownBody');
      if (!tbody) return;
      tbody.innerHTML = data.map((d: any) => `
        <tr>
          <td>${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE') : '–'}</td>
          <td>${d.weight_kg ? Number(d.weight_kg).toFixed(1) + ' kg' : '–'}</td>
          <td>${d.species ?? '–'}</td>
          <td>${d.water_name ?? '–'}</td>
          <td>${d.bait ?? '–'}</td>
        </tr>
      `).join('');
    }

    async function populateSelects() {
      const { data } = await supabase.rpc('stats_conditions', { p_filters: {} });
      if (!data?.buckets) return;
    }

    async function refresh() {
      const filters = getFilters();
      const [
        { data: cond },
        { data: kombis },
        { data: ins },
        { data: verl },
        { data: wet },
        { data: drill },
      ] = await Promise.all([
        supabase.rpc('stats_conditions', { p_filters: filters }),
        supabase.rpc('stats_beste_kombis', { p_filters: filters, p_limit: 5 }),
        supabase.rpc('stats_insights', { p_filters: filters }),
        supabase.rpc('stats_gewichtsverlauf', { p_filters: filters }),
        supabase.rpc('stats_wetter_korrelation', { p_filters: filters }),
        supabase.rpc('stats_drilldown', { p_filters: filters }),
      ]);

      const kpis = document.querySelectorAll('.kpi-value');
      if (kpis[0]) kpis[0].textContent = String(cond?.total?.fangzahl ?? 0);
      if (kpis[1]) kpis[1].textContent = (cond?.total?.max_gewicht ?? '–') + ' KG';
      if (kpis[2]) kpis[2].textContent = (cond?.total?.avg_gewicht ?? '–') + ' KG';
      if (kpis[3]) kpis[3].textContent = String(Object.keys(cond?.buckets?.gewaesser ?? {}).length);

      const buckets = cond?.buckets ?? {};
      drawDonut(Object.entries(buckets.art ?? {}).map(([label, v]: any) => ({ label, value: +(v?.fangzahl ?? v ?? 0) })));
      drawGewaesser(Object.entries(buckets.gewaesser ?? {}).map(([label, v]: any) => ({ label, value: +(v?.fangzahl ?? v ?? 0) })));
      drawMond(Object.entries(buckets.mond ?? {}).map(([label, v]: any) => ({ label, value: +(v?.fangzahl ?? v ?? 0) })));
      drawMonat(Object.entries(buckets.monat ?? {}).sort(([a],[b]) => +a - +b).map(([label, v]: any) => ({ label: monatName(+label), value: +(v?.fangzahl ?? v ?? 0) })));
      renderVerlauf(verl ?? []);
      renderWetter(wet ?? []);

      const tbody = document.getElementById('kombiBody');
      if (tbody) {
        tbody.innerHTML = (kombis ?? []).map((k: any) =>
          `<tr><td>${k.kombi}</td><td>${k.fangzahl}</td><td>${Number(k.avg_gewicht).toFixed(1)} kg</td></tr>`
        ).join('');
      }

      if (ins) {
        const insightCards = document.querySelectorAll('.insight-card .insight-text');
        if (insightCards[0]) insightCards[0].innerHTML = `Deine beste Fangzeit: <strong>${ins.beste_fangzeit?.wert ?? '–'}</strong> (Ø ${ins.beste_fangzeit?.avg_gewicht ?? '–'} kg)`;
        if (insightCards[1]) insightCards[1].innerHTML = `Beste Wetterlage: <strong>${ins.beste_wetterlage?.wert ?? '–'}</strong> (Ø ${ins.beste_wetterlage?.avg_gewicht ?? '–'} kg)`;
        if (insightCards[2]) insightCards[2].innerHTML = `Bestes Köder: <strong>${ins.beste_koeder_kombi?.wert ?? '–'}</strong> (Ø ${ins.beste_koeder_kombi?.avg_gewicht ?? '–'} kg)`;
      }

      renderDrilldown(drill ?? []);
    }

    document.getElementById('zeitraumPills')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.pill') as HTMLElement;
      if (!btn) return;
      document.querySelectorAll('#zeitraumPills .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });

