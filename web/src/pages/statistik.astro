---
import { createSSRClient } from '../lib/ssr-client';
import Layout from '../layouts/Layout.astro';

const supabase = createSSRClient(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  return Astro.redirect('/login');
}
---

<Layout title="Statistik" active="statistik">
  <div class="stats-page">
    <aside class="filter-sidebar" id="filterSidebar">
      <h2>Filter</h2>

      <div class="filter-section">
        <label>Zeitraum</label>
        <div class="pills" id="zeitraumPills">
          <button class="pill active" data-value="all">Alle</button>
          <button class="pill" data-value="7d">7 Tage</button>
          <button class="pill" data-value="30d">30 Tage</button>
          <button class="pill" data-value="90d">90 Tage</button>
          <button class="pill" data-value="1y">1 Jahr</button>
        </div>
      </div>

      <div class="filter-section">
        <label>Fischart</label>
        <div class="pills" id="fischartPills">
          <button class="pill active" data-value="">Alle</button>
        </div>
      </div>

      <div class="filter-section">
        <label for="gewaesser">Gewässer</label>
        <select id="gewaesser"><option value="">Alle</option></select>
      </div>

      <div class="filter-section">
        <label for="koeder">Köder</label>
        <select id="koeder"><option value="">Alle</option></select>
      </div>

      <details class="filter-advanced">
        <summary>Weitere Filter</summary>
        <div class="filter-section">
          <label for="mondphase">Mondphase</label>
          <select id="mondphase"><option value="">Alle</option></select>
        </div>
        <div class="filter-section">
          <label for="wetter">Wetter</label>
          <select id="wetter"><option value="">Alle</option></select>
        </div>

        <div class="filter-group">
          <label>Gewicht (kg)</label>
          <div style="display:flex;gap:0.5rem">
            <input type="number" id="gewichtMin" placeholder="Min" style="width:80px;padding:0.4rem;border:1px solid var(--color-outline);border-radius:8px;background:var(--color-surface);color:var(--color-on-surface)">
            <input type="number" id="gewichtMax" placeholder="Max" style="width:80px;padding:0.4rem;border:1px solid var(--color-outline);border-radius:8px;background:var(--color-surface);color:var(--color-on-surface)">
          </div>
        </div>
        <div class="filter-group">
          <label>Luftdruck (hPa)</label>
          <div style="display:flex;gap:0.5rem">
            <input type="number" id="druckMin" placeholder="Min" style="width:80px;padding:0.4rem;border:1px solid var(--color-outline);border-radius:8px;background:var(--color-surface);color:var(--color-on-surface)">
            <input type="number" id="druckMax" placeholder="Max" style="width:80px;padding:0.4rem;border:1px solid var(--color-outline);border-radius:8px;background:var(--color-surface);color:var(--color-on-surface)">
          </div>
        </div>
        <div class="filter-group">
          <label>Wassertemperatur (°C)</label>
          <div style="display:flex;gap:0.5rem">
            <input type="number" id="wassertempMin" placeholder="Min" style="width:80px;padding:0.4rem;border:1px solid var(--color-outline);border-radius:8px;background:var(--color-surface);color:var(--color-on-surface)">
            <input type="number" id="wassertempMax" placeholder="Max" style="width:80px;padding:0.4rem;border:1px solid var(--color-outline);border-radius:8px;background:var(--color-surface);color:var(--color-on-surface)">
          </div>
        </div>
      </details>

      <button class="btn-apply" id="btnApply">Anwenden</button>
    </aside>

    <main class="stats-content">
      <h1>Fang-Statistiken</h1>

      <div id="loading-indicator" style="display:none;text-align:center;padding:2rem;color:var(--color-on-surface-variant)">⏳ Daten laden...</div>

      <div class="kpi-row main-kpi">
        <div class="kpi-card">
          <span class="kpi-value">0</span>
          <span class="kpi-label">GESAMTE FÄNGE</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">– KG</span>
          <span class="kpi-label">SCHWERSTER FANG</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">– KG</span>
          <span class="kpi-label">Ø GEWICHT</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">0</span>
          <span class="kpi-label">AKTIVE GEWÄSSER</span>
        </div>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>📊 Carp24 Analyse</h3>
          <div class="insight-cards">
            <div class="insight-card"><span class="insight-icon">⏰</span><span class="insight-text">Deine beste Fangzeit: <strong>–</strong> (Ø – kg)</span></div>
            <div class="insight-card"><span class="insight-icon">🌤️</span><span class="insight-text">Beste Wetterlage: <strong>–</strong> (Ø – kg)</span></div>
            <div class="insight-card"><span class="insight-icon">🎣</span><span class="insight-text">Bestes Köder: <strong>–</strong> (Ø – kg)</span></div>
          </div>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Fänge nach Gewässer</h3>
          <canvas id="gewaesserChart" width="400" height="260"></canvas>
        </section>
        <section class="chart-card">
          <h3>Mondphasen</h3>
          <canvas id="mondChart" width="400" height="260"></canvas>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>Fänge pro Monat</h3>
          <canvas id="monatChart" width="800" height="260"></canvas>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Gewichtsverlauf</h3>
          <div id="verlaufChart"></div>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card">
          <h3>Wetter-Korrelation</h3>
          <div id="wetterChart"></div>
        </section>
        <section class="chart-card">
          <h3>🌤️ Luftdruck-Korrelation</h3>
          <div id="luftdruckChart" style="min-height:260px"></div>
        </section>
        <section class="chart-card wide">
          <h3>Beste Kombinationen</h3>
          <table class="kombi-table">
            <thead>
              <tr><th>Kombi</th><th>Fänge</th><th>Ø Gewicht</th></tr>
            </thead>
            <tbody id="kombiBody"></tbody>
          </table>
        </section>
      </div>



      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>🏆 Badges</h3>
          <div class="badges-progress">
            <span class="badges-count">0 / 0</span>
            <div class="badges-bar"><div class="badges-bar-fill" style="width: 0%"></div></div>
          </div>
          <div class="badges-grid" id="badgesGrid"></div>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>🗺️ Trips</h3>
          <div class="kpi-row trip-kpi">
            <div class="kpi-card">
              <span class="kpi-value">0</span>
              <span class="kpi-label">TRIPS</span>
            </div>
            <div class="kpi-card">
              <span class="kpi-value">– KG</span>
              <span class="kpi-label">Ø GEWICHT / TRIP</span>
            </div>
            <div class="kpi-card">
              <span class="kpi-value">–</span>
              <span class="kpi-label">BESTES GEWÄSSER</span>
            </div>
          </div>
          <table class="kombi-table">
            <thead>
              <tr><th>Datum</th><th>Gewässer</th><th>Fänge</th><th>Ø Gewicht</th><th>Max Gewicht</th></tr>
            </thead>
            <tbody id="tripsBody"></tbody>
          </table>
        </section>
      </div>

      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>📋 Fangdetails</h3>
          <table class="kombi-table">
            <thead>
              <tr><th>Datum</th><th>Gewicht</th><th>Fischart</th><th>Gewässer</th><th>Köder</th></tr>
            </thead>
            <tbody id="drilldownBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>

  <script>
    import { supabase } from '../lib/supabase-client';
    import uPlot from 'uplot';
    import 'uplot/dist/uPlot.min.css';

    const CSS = {
      primary: getComputedStyle(document.documentElement).getPropertyValue('--color-primary-container').trim() || '#6c7a57',
      primaryDim: getComputedStyle(document.documentElement).getPropertyValue('--color-primary-fixed-dim').trim() || '#a3b18a',
      primaryFixed: getComputedStyle(document.documentElement).getPropertyValue('--color-primary-fixed').trim() || '#dde5b6',
      surface: getComputedStyle(document.documentElement).getPropertyValue('--color-surface-container-lowest').trim() || '#fff',
      outline: getComputedStyle(document.documentElement).getPropertyValue('--color-outline-variant').trim() || '#c6c8bc',
      onSurface: getComputedStyle(document.documentElement).getPropertyValue('--color-on-surface').trim() || '#181d14',
    };

    const MONAT_NAMES = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
    function monatName(m: number) { return MONAT_NAMES[m - 1] ?? String(m); }

    function speciesName(s: string): string {
      const map: Record<string, string> = {
        karpfen: 'Karpfen', schlei: 'Schlei', barsch: 'Barsch',
        hecht: 'Hecht', zander: 'Zander', wels: 'Wels',
        amur: 'Amur', karausche: 'Karausche', rotfeder: 'Rotfeder',
        brasse: 'Brasse', aland: 'Aland', laube: 'Laube',
      };
      return map[s?.toLowerCase()] ?? s ?? '–';
    }

    function getFilters(): Record<string, any> {
      const f: Record<string, any> = {};
      const z = document.querySelector('#zeitraumPills .pill.active') as HTMLElement;
      if (z) {
        const val = z.dataset.value;
        const now = new Date();
        if (val === '7d') {
          const d = new Date(now); d.setDate(d.getDate()-7);
          f.zeitraum = { von: d.toISOString().slice(0,10), bis: now.toISOString().slice(0,10) };
        } else if (val === '30d') {
          const d = new Date(now); d.setDate(d.getDate()-30);
          f.zeitraum = { von: d.toISOString().slice(0,10), bis: now.toISOString().slice(0,10) };
        } else if (val === '90d') {
          const d = new Date(now); d.setDate(d.getDate()-90);
          f.zeitraum = { von: d.toISOString().slice(0,10), bis: now.toISOString().slice(0,10) };
        } else if (val === '1y') {
          const d = new Date(now); d.setFullYear(d.getFullYear()-1);
          f.zeitraum = { von: d.toISOString().slice(0,10), bis: now.toISOString().slice(0,10) };
        }
      }
      const g = (document.getElementById('gewaesser') as HTMLSelectElement)?.value;
      if (g) f.gewaesser = g;
      const k = (document.getElementById('koeder') as HTMLSelectElement)?.value;
      if (k) f.koeder = k;
      const m = (document.getElementById('mondphase') as HTMLSelectElement)?.value;
      if (m) f.mond = m;
      const w = (document.getElementById('wetter') as HTMLSelectElement)?.value;
      if (w) f.wetter = w;
      const fa = (document.querySelector('#fischartPills .pill.active') as HTMLElement)?.dataset?.value;
      if (fa) f.art = fa;
      const gMin = (document.getElementById('gewichtMin') as HTMLInputElement)?.value;
      const gMax = (document.getElementById('gewichtMax') as HTMLInputElement)?.value;
      if (gMin || gMax) f.gewicht = { min: gMin ? +gMin : null, max: gMax ? +gMax : null };
      const dMin = (document.getElementById('druckMin') as HTMLInputElement)?.value;
      const dMax = (document.getElementById('druckMax') as HTMLInputElement)?.value;
      if (dMin || dMax) f.druck = { min: dMin ? +dMin : null, max: dMax ? +dMax : null };
      const wtMin = (document.getElementById('wassertempMin') as HTMLInputElement)?.value;
      const wtMax = (document.getElementById('wassertempMax') as HTMLInputElement)?.value;
      if (wtMin || wtMax) f.wassertemp = { min: wtMin ? +wtMin : null, max: wtMax ? +wtMax : null };
      return f;
    }

    function drawGewaesser(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('gewaesserChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 400, H = 260;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.clearRect(0, 0, W, H);

      if (!data.length) {
        ctx.fillStyle = CSS.onSurface;
        ctx.font = '14px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Keine Daten', canvas.width/2, canvas.height/2);
        return;
      }
      const maxVal = Math.max(...data.map(d => d.value), 1);
      const barH = Math.min(28, (H - 20) / data.length - 4);
      const marginLeft = 120, marginRight = 50;

      data.forEach((d, i) => {
        const y = 10 + i * (barH + 4);
        const barW = ((W - marginLeft - marginRight) * d.value) / maxVal;
        ctx.fillStyle = CSS.primary;
        ctx.fillRect(marginLeft, y, barW, barH);
        ctx.fillStyle = CSS.onSurface;
        ctx.font = '12px "Source Sans 3", sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText(d.label, marginLeft - 8, y + barH / 2);
        ctx.textAlign = 'left';
        ctx.fillText(String(d.value), marginLeft + barW + 6, y + barH / 2);
      });
    }

    function drawMond(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('mondChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 400, H = 260;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.clearRect(0, 0, W, H);

      if (!data.length) {
        ctx.fillStyle = CSS.onSurface;
        ctx.font = '14px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Keine Daten', canvas.width/2, canvas.height/2);
        return;
      }
      const maxVal = Math.max(...data.map(d => d.value), 1);
      const marginLeft = 50, marginBottom = 40, marginTop = 20;
      const chartW = W - marginLeft - 20;
      const chartH = H - marginTop - marginBottom;
      const barW = Math.min(60, chartW / data.length - 8);

      data.forEach((d, i) => {
        const x = marginLeft + i * (chartW / data.length) + (chartW / data.length - barW) / 2;
        const barH = (chartH * d.value) / maxVal;
        ctx.fillStyle = CSS.primary;
        ctx.fillRect(x, marginTop + chartH - barH, barW, barH);
        ctx.fillStyle = CSS.onSurface;
        ctx.font = '11px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(d.label, x + barW / 2, H - marginBottom + 16);
        ctx.fillText(String(d.value), x + barW / 2, marginTop + chartH - barH - 6);
      });
    }

    function drawMonat(data: { label: string; value: number }[]) {
      const canvas = document.getElementById('monatChart') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const dpr = window.devicePixelRatio || 1;
      const W = 800, H = 260;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.clearRect(0, 0, W, H);

      if (!data.length) {
        ctx.fillStyle = CSS.onSurface;
        ctx.font = '14px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Keine Daten', canvas.width/2, canvas.height/2);
        return;
      }
      const maxVal = Math.max(...data.map(d => d.value), 1);
      const marginLeft = 50, marginBottom = 40, marginTop = 20;
      const chartW = W - marginLeft - 20;
      const chartH = H - marginTop - marginBottom;
      const barW = Math.min(50, chartW / data.length - 8);

      data.forEach((d, i) => {
        const x = marginLeft + i * (chartW / data.length) + (chartW / data.length - barW) / 2;
        const barH = (chartH * d.value) / maxVal;
        ctx.fillStyle = CSS.primary;
        ctx.fillRect(x, marginTop + chartH - barH, barW, barH);
        ctx.fillStyle = CSS.onSurface;
        ctx.font = '11px "Source Sans 3", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(d.label, x + barW / 2, H - marginBottom + 16);
        ctx.fillText(String(d.value), x + barW / 2, marginTop + chartH - barH - 6);
      });
    }

    function renderVerlauf(data: any[]) {
      const el = document.getElementById('verlaufChart');
      if (!el || !data.length) { if (el) el.innerHTML = '<p style="text-align:center;color:#999;padding:2rem;">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const months = data.map((d: any) => {
        const [y, m] = d.month.split('-');
        return Math.floor(new Date(+y, +m - 1, 15).getTime() / 1000);
      });
      const avgW = data.map((d: any) => +d.avg_weight);
      const maxW = data.map((d: any) => +d.max_weight);

      const opts: uPlot.Options = {
        width: el.clientWidth || 500,
        height: 260,
        axes: [
          { stroke: '#888', grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif',
            values: (u, vals) => vals.map(v => {
              const d = new Date(v * 1000);
              return d.toLocaleDateString('de-DE', { month: 'short', year: '2-digit' });
            }),
          },
          { stroke: '#888', grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
        ],
        series: [
          {},
          { label: 'Ø Gewicht', stroke: CSS.primary, width: 2, points: { show: true, size: 5 } },
          { label: 'Max Gewicht', stroke: CSS.primaryDim, width: 2, dash: [6, 3] },
        ],
      };
      new uPlot(opts, [months, avgW, maxW], el);
    }

    function renderWetter(data: any[]) {
      const el = document.getElementById('wetterChart');
      if (!el || !data.length) { if (el) el.innerHTML = '<p style="text-align:center;color:#999;padding:2rem;">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const indices = data.map((_: any, i: number) => i);
      const counts = data.map((d: any) => +d.catch_count);
      const avgW = data.map((d: any) => +d.avg_weight);
      const labels = data.map((d: any) => d.weather_type);

      const opts: uPlot.Options = {
        width: el.clientWidth || 500,
        height: 260,
        axes: [
          { stroke: '#888', grid: { show: false }, font: '12px "Source Sans 3", sans-serif',
            values: () => labels },
          { stroke: '#888', grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
          { stroke: '#888', grid: { show: false }, font: '12px "Source Sans 3", sans-serif', side: 1 },
        ],
        series: [
          {},
          { label: 'Fänge', stroke: CSS.primary, fill: CSS.primary + '40', width: 1 },
          { label: 'Ø kg', stroke: '#e07a5f', width: 2, points: { show: true, size: 5 }, scale: 'y2' },
        ],
        scales: {
          y2: { side: 1 },
        },
      };
      new uPlot(opts, [indices, counts, avgW], el);
    }

    function renderLuftdruck(data: any[]) {
      const el = document.getElementById('luftdruckChart');
      if (!el || !data.length) { if (el) el.innerHTML = '<p style="text-align:center;color:#999;padding:2rem;">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const indices = data.map((_: any, i: number) => i);
      const counts = data.map((d: any) => +d.catch_count);
      const avgW = data.map((d: any) => +d.avg_weight);
      const labels = data.map((d: any) => d.druck_bereich);
      const opts: uPlot.Options = {
        width: el.clientWidth || 500,
        height: 260,
        axes: [
          { stroke: '#888', grid: { show: false }, font: '12px "Source Sans 3", sans-serif',
            values: () => labels },
          { stroke: '#888', grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
          { stroke: '#888', grid: { show: false }, font: '12px "Source Sans 3", sans-serif', side: 1 },
        ],
        series: [
          {},
          { label: 'Fänge', stroke: CSS.primary, fill: CSS.primary + '40', width: 1 },
          { label: 'Ø kg', stroke: '#e07a5f', width: 2, points: { show: true, size: 5 }, scale: 'y2' },
        ],
        scales: {
          y2: { side: 1 },
        },
      };
      new uPlot(opts, [indices, counts, avgW], el);
    }

    function renderBadges(data: any[]) {
      const grid = document.getElementById('badgesGrid');
      if (!grid) return;
      const earned = data.filter((b: any) => b.erreicht).length;
      const total = data.length;
      const countEl = grid.parentElement!.querySelector('.badges-count');
      if (countEl) countEl.textContent = `${earned} / ${total}`;
      const fillEl = grid.parentElement!.querySelector('.badges-bar-fill') as HTMLElement;
      if (fillEl) fillEl.style.width = total ? `${Math.round(earned / total * 100)}%` : '0%';
      grid.innerHTML = data.map((b: any) => `
        <div class="badge-item ${b.erreicht ? 'badge-earned' : 'badge-locked'}">
          <span class="badge-icon">${b.icon ?? '🏅'}</span>
          <span class="badge-name">${b.name}</span>
          ${b.erreicht ? `<span class="badge-date">${b.erreicht_am ? new Date(b.erreicht_am).toLocaleDateString('de-DE') : ''}</span>` : ''}
        </div>
      `).join('');
    }

    function renderTrips(data: any) {
      const trips = data?.trips ?? [];
      const summary = data?.summary ?? {};
      const tripKpis = document.querySelectorAll('.trip-kpi .kpi-value');
      if (tripKpis[0]) tripKpis[0].textContent = String(summary.trip_anzahl ?? 0);
      if (tripKpis[1]) tripKpis[1].textContent = (summary.avg_gewicht ?? '–') + ' KG';
      if (tripKpis[2]) tripKpis[2].textContent = summary.bestes_gewaesser ?? '–';
      const tbody = document.getElementById('tripsBody');
      if (tbody) {
        tbody.innerHTML = trips.map((t: any) => `
          <tr>
            <td>${t.datum ? new Date(t.datum).toLocaleDateString('de-DE', {day:'2-digit',month:'2-digit',year:'2-digit'}) : '–'}</td>
            <td>${t.gewaesser ?? '–'}</td>
            <td>${t.fangzahl ?? 0}</td>
            <td>${t.avg_gewicht ? Number(t.avg_gewicht).toFixed(1) + ' kg' : '–'}</td>
            <td>${t.max_gewicht ? Number(t.max_gewicht).toFixed(1) + ' kg' : '–'}</td>
          </tr>
        `).join('');
      }
    }

    function renderDrilldown(data: any[]) {
      const tbody = document.getElementById('drilldownBody');
      if (!tbody) return;
      tbody.innerHTML = data.map((d: any) => `
        <tr>
          <td>${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE', {day:'2-digit',month:'2-digit',year:'2-digit'}) : '–'}</td>
          <td>${d.weight_kg ? Number(d.weight_kg).toFixed(1) + ' kg' : '–'}</td>
          <td>${speciesName(d.species)}</td>
          <td>${d.water_name ?? '–'}</td>
          <td>${d.bait ?? '–'}</td>
        </tr>
      `).join('');
    }

    function populateSelects(cond: any) {
      if (!cond?.buckets) return;
      const b = cond.buckets;
      function fillSelect(id: string, obj: Record<string, any> | undefined) {
        const sel = document.getElementById(id);
        if (!sel || !obj) return;
        while (sel.options.length > 1) sel.remove(1);
        Object.keys(obj).forEach(k => {
          if (k && k !== 'Unbekannt') {
            const opt = document.createElement('option');
            opt.value = k; opt.textContent = k;
            sel.appendChild(opt);
          }
        });
      }
      fillSelect('gewaesser', b.gewaesser);
      fillSelect('koeder', b.koeder);
      fillSelect('mondphase', b.mond);
      fillSelect('wetter', b.wetter);

      const fischartPills = document.getElementById('fischartPills');
      if (fischartPills && b.art) {
        fischartPills.innerHTML = '<button class="pill active" data-value="">Alle</button>';
        Object.keys(b.art).forEach(k => {
          if (k && k !== 'Unbekannt') {
            fischartPills.innerHTML += `<button class="pill" data-value="${k}">${k} (${b.art[k]})</button>`;
          }
        });
        fischartPills.querySelectorAll('.pill').forEach(p => p.addEventListener('click', () => {
          fischartPills.querySelectorAll('.pill').forEach(x => x.classList.remove('active'));
          p.classList.add('active');
          refresh();
        }));
      }
    }

    async function refresh() {
      const loadingEl = document.getElementById('loading-indicator');
      if (loadingEl) loadingEl.style.display = 'block';
      const { data: { user } } = await supabase.auth.getUser();
      const filters = getFilters();
      const [
        { data: cond },
        { data: kombis },
        { data: ins },
        { data: verl },
        { data: wet },
        { data: ldruck },
        { data: drill },
      ] = await Promise.all([
        supabase.rpc('stats_conditions', { p_filters: filters }),
        supabase.rpc('stats_beste_kombis', { p_filters: filters, p_limit: 5 }),
        supabase.rpc('stats_insights', { p_filters: filters }),
        supabase.rpc('stats_gewichtsverlauf', { p_filters: filters }),
        supabase.rpc('stats_wetter_korrelation', { p_filters: filters }),
        supabase.rpc('stats_luftdruck_korrelation', { p_filters: filters }),
        supabase.rpc('stats_drilldown', { p_filters: filters }),
      ]);

      const [{ data: badgeData }, { data: tripData }] = await Promise.all([
        supabase.rpc('stats_badges', { p_user_id: user?.id }),
        supabase.rpc('stats_trips', { p_user_id: user?.id }),
      ]);
      renderBadges(badgeData);
      renderTrips(tripData);

      const mainKpis = document.querySelectorAll('.main-kpi .kpi-value');
      if (mainKpis[0]) mainKpis[0].textContent = String(cond?.total?.fangzahl ?? 0);
      if (mainKpis[1]) mainKpis[1].textContent = (cond?.total?.max_gewicht ?? '–') + ' KG';
      if (mainKpis[2]) mainKpis[2].textContent = (cond?.total?.avg_gewicht ?? '–') + ' KG';
      if (mainKpis[3]) mainKpis[3].textContent = String(Object.keys(cond?.buckets?.gewaesser ?? {}).length);

      const buckets = cond?.buckets ?? {};
      drawGewaesser(Object.entries(buckets.gewaesser ?? {}).map(([label, v]: any) => ({ label, value: +(v?.fangzahl ?? v ?? 0) })));
      drawMond(Object.entries(buckets.mond ?? {}).map(([label, v]: any) => ({ label, value: +(v?.fangzahl ?? v ?? 0) })));
      drawMonat(Object.entries(buckets.monat ?? {}).sort(([a],[b]) => +a - +b).map(([label, v]: any) => ({ label: monatName(+label), value: +(v?.fangzahl ?? v ?? 0) })));
      renderVerlauf(verl ?? []);
      renderWetter(wet ?? []);
      renderLuftdruck(ldruck ?? []);

      const kombiLabels: Record<string, string> = {
        mond: 'Mond', druck: 'Druck', wetter: 'Wetter', koeder: 'Köder',
        uhrzeit: 'Uhrzeit', wassertemp: 'Wassertemp', lufttemp: 'Lufttemp', wind: 'Wind'
      };
      const tbody = document.getElementById('kombiBody');
      if (tbody) {
        tbody.innerHTML = (kombis ?? []).map((k: any) => {
          const parts = k.kombi.split(' + ').map((p: string) => {
            const [key, val] = p.split('=');
            return (kombiLabels[key] || key) + ': ' + val;
          });
          return `<tr><td>${parts.join(' · ')}</td><td>${k.fangzahl}</td><td>${Number(k.avg_gewicht).toFixed(1)} kg</td></tr>`;
        }).join('');
      }

      if (ins) {
        const insightCards = document.querySelectorAll('.insight-card .insight-text');
        if (insightCards[0]) insightCards[0].innerHTML = `Deine beste Fangzeit: <strong>${ins.beste_fangzeit?.wert ?? '–'}</strong> (Ø ${ins.beste_fangzeit?.avg_gewicht ?? '–'} kg)`;
        if (insightCards[1]) insightCards[1].innerHTML = `Beste Wetterlage: <strong>${ins.beste_wetterlage?.wert ?? '–'}</strong> (Ø ${ins.beste_wetterlage?.avg_gewicht ?? '–'} kg)`;
        if (insightCards[2]) insightCards[2].innerHTML = `Bestes Köder: <strong>${ins.beste_koeder_kombi?.wert ?? '–'}</strong> (Ø ${ins.beste_koeder_kombi?.avg_gewicht ?? '–'} kg)`;
      }

      renderDrilldown(drill ?? []);
      populateSelects(cond);
      if (loadingEl) loadingEl.style.display = 'none';
    }

    document.getElementById('zeitraumPills')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.pill') as HTMLElement;
      if (!btn) return;
      document.querySelectorAll('#zeitraumPills .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });

    document.getElementById('btnApply')?.addEventListener('click', () => refresh());

    refresh();
  </script>
</Layout>

