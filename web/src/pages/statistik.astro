---
import { createSSRClient } from '../lib/ssr-client';
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase-client';

const client = createSSRClient(Astro);
const { data: { session } } = await client.auth.getSession();
if (!session) return Astro.redirect('/login');
---

<Layout title="Statistik" active="statistik">
  <div class="stats-page">
    <h1>Fang-Statistiken</h1>

    <div class="filter-bar" id="filterBar">
      <div class="filter-row">
        <span class="filter-label">ZEITRAUM:</span>
        <div class="filter-pills" id="zeitraumPills">
          <button class="pill active" data-value="all">Alle</button>
          <button class="pill" data-value="7d">7d</button>
          <button class="pill" data-value="30d">30d</button>
          <button class="pill" data-value="90d">90d</button>
          <button class="pill" data-value="1y">1y</button>
        </div>
      </div>
      <div class="filter-row">
        <select id="gewaesser"><option value="">Gewässer</option></select>
        <select id="koeder"><option value="">Köder</option></select>
        <select id="mondphase"><option value="">Mond</option></select>
        <select id="wetter"><option value="">Wetter</option></select>
        <select id="druckTrend">
          <option value="">Druck</option>
          <option value="niedrig">&lt;1005</option>
          <option value="mittel">1005–1015</option>
          <option value="hoch">&gt;=1015</option>
        </select>
        <select id="wind">
          <option value="">Wind</option>
          <option value="windstill">&lt;5</option>
          <option value="leicht">5–10</option>
          <option value="maessig">10–20</option>
          <option value="stark">20+</option>
        </select>
        <button class="btn-apply" id="btnApply">Anwenden</button>
      </div>
    </div>

    <div id="loading-indicator" class="loading-indicator">
      <div class="skeleton-spinner"></div>
    </div>

    <div class="kpi-row" id="kpiRow">
      <div class="kpi-card">
        <span class="kpi-value" id="kpiFang">0</span>
        <span class="kpi-label">Fänge</span>
      </div>
      <div class="kpi-card">
        <span class="kpi-value" id="kpiAvg">–</span>
        <span class="kpi-label">Ø Gewicht</span>
      </div>
      <div class="kpi-card">
        <span class="kpi-value" id="kpiMax">–</span>
        <span class="kpi-label">Max Gewicht</span>
      </div>
      <div class="kpi-card">
        <span class="kpi-value" id="kpiWater">0</span>
        <span class="kpi-label">Gewässer</span>
      </div>
    </div>

    <section class="beste-bed" id="bestConditionsCard">
      <span class="beste-bed-label">BESTE BEDINGUNGEN</span>
      <div class="beste-bed-content" id="bestConditions">
        <p class="placeholder">Wird berechnet…</p>
      </div>
    </section>

    <div class="charts-row">
      <section class="card">
        <h3>Dimensionen-Analyse</h3>
        <div class="conditions-grid">
          <div class="condition-row" data-dimension="mond">
            <h4>Mondphase</h4>
            <div id="mondBars" class="condition-bars"></div>
          </div>
          <div class="condition-row" data-dimension="wetter">
            <h4>Wetter</h4>
            <div id="wetterBars" class="condition-bars"></div>
          </div>
          <div class="condition-row" data-dimension="uhrzeit">
            <h4>Tageszeit</h4>
            <div id="uhrzeitBars" class="condition-bars"></div>
          </div>
          <div class="condition-row" data-dimension="druck">
            <h4>Luftdruck</h4>
            <div id="druckBars" class="condition-bars"></div>
          </div>
          <div class="condition-row" data-dimension="temp">
            <h4>Wassertemperatur</h4>
            <div id="tempBars" class="condition-bars"></div>
          </div>
          <div class="condition-row" data-dimension="wind">
            <h4>Wind</h4>
            <div id="windBars" class="condition-bars"></div>
          </div>
        </div>
      </section>

      <section class="card">
        <h3>Gewichtsverlauf</h3>
        <div id="verlaufChart"></div>
      </section>
    </div>

    <section class="card" id="gewaesserSection">
      <h3>Fänge nach Gewässer (Top 8)</h3>
      <div id="gewaesserChart" class="gewaesser-chart"></div>
    </section>

    <section class="card" id="kombiSection">
      <h3>Top Kombinationen</h3>
      <div id="kombiCards" class="kombi-cards"></div>
    </section>

    <section class="card" id="drilldownSection">
      <h3>Fangdetails</h3>
      <div id="drilldownContainer">
        <table class="detail-table">
          <thead>
            <tr><th>Datum</th><th>Gewicht</th><th>Fischart</th><th>Gewässer</th><th>Köder</th><th>Länge</th></tr>
          </thead>
          <tbody id="drilldownBody"></tbody>
        </table>
      </div>
    </section>
  </div>

  <script>
    import { supabase } from '../lib/supabase-client';
    import uPlot from 'uplot';
    import 'uplot/dist/uPlot.min.css';

    function n(val: unknown): number {
      const v = Number(val);
      return Number.isFinite(v) ? v : 0;
    }

    function nf(val: unknown, digits = 1): string {
      const v = Number(val);
      return Number.isFinite(v) ? v.toFixed(digits) : '–';
    }

    function speciesName(s: string): string {
      const map: Record<string, string> = {
        karpfen: 'Karpfen', schlei: 'Schlei', barsch: 'Barsch',
        hecht: 'Hecht', zander: 'Zander', wels: 'Wels',
        amur: 'Amur', karausche: 'Karausche', rotfeder: 'Rotfeder',
        brasse: 'Brasse', aland: 'Aland', laube: 'Laube',
      };
      return map[s?.toLowerCase()] ?? s ?? '–';
    }

    function getCSS(): Record<string, string> {
      const s = getComputedStyle(document.documentElement);
      return {
        primary: s.getPropertyValue('--color-primary-container').trim() || '#6c7a57',
        primaryDim: s.getPropertyValue('--color-primary-fixed-dim').trim() || '#a3b18a',
        surface: s.getPropertyValue('--color-surface-container-lowest').trim() || '#fff',
        outline: s.getPropertyValue('--color-outline-variant').trim() || '#c6c8bc',
        onSurface: s.getPropertyValue('--color-on-surface').trim() || '#181d14',
        onSurfaceVar: s.getPropertyValue('--color-on-surface-variant').trim() || '#45483f',
      };
    }

    let CSS = getCSS();

    const MOND_EMOJI: Record<string, string> = {
      'Neumond': '🌑', 'Zunehmend': '🌒', 'Erstes Viertel': '🌓',
      'Zunehmender Gibbus': '🌔', 'Vollmond': '🌕', 'Abnehmender Gibbus': '🌖',
      'Letztes Viertel': '🌗', 'Abnehmend': '🌘'
    };

    const WETTER_EMOJI: Record<string, string> = {
      'Sonnig': '☀️', 'Bewölkt': '☁️', 'Regen': '🌧️', 'Windig': '💨', 'Neblig': '🌫️',
      'sonnig': '☀️', 'bewölkt': '☁️', 'regen': '🌧️', 'windig': '💨', 'neblig': '🌫️',
    };

    function uhrzeitEmoji(label: string): string {
      const l = label.toLowerCase();
      if (l.includes('nacht') || l.includes('0-6') || l.includes('0–6')) return '🌙';
      if (l.includes('morgen') || l.includes('6-12') || l.includes('6–12')) return '🌅';
      if (l.includes('mittag') || l.includes('12-18') || l.includes('12–18')) return '☀️';
      if (l.includes('abend') || l.includes('18-24') || l.includes('18–24') || l.includes('18-0')) return '🌇';
      return '🌅';
    }

    function druckEmoji(label: string): string {
      const l = label.toLowerCase();
      if (l.includes('fall') || l.includes('niedrig') || l.includes('<') || l.includes('↘')) return '↘️';
      if (l.includes('steig') || l.includes('hoch') || l.includes('>') || l.includes('↗')) return '↗️';
      return '➡️';
    }

    function getFilters(): Record<string, any> {
      const f: Record<string, any> = {};
      const z = document.querySelector('#zeitraumPills .pill.active') as HTMLElement;
      if (z) {
        const val = z.dataset.value;
        const now = new Date();
        if (val && val !== 'all') {
          const d = new Date(now);
          if (val === '1y') d.setFullYear(d.getFullYear() - 1);
          else d.setDate(d.getDate() - parseInt(val));
          f.zeitraum = { von: d.toISOString().slice(0, 10), bis: now.toISOString().slice(0, 10) };
        }
      }
      const g = (document.getElementById('gewaesser') as HTMLSelectElement)?.value;
      if (g) f.gewaesser = g;
      const k = (document.getElementById('koeder') as HTMLSelectElement)?.value;
      if (k) f.koeder = k;
      const m = (document.getElementById('mondphase') as HTMLSelectElement)?.value;
      if (m) f.mond = m;
      const w = (document.getElementById('wetter') as HTMLSelectElement)?.value;
      if (w) f.wetter = w;
      const dt = (document.getElementById('druckTrend') as HTMLSelectElement)?.value;
      if (dt) f.druck_trend = dt;
      const wi = (document.getElementById('wind') as HTMLSelectElement)?.value;
      if (wi) f.wind = wi;
      return f;
    }

    function renderConditionBars(containerId: string, data: any[], labelKey: string, valueKey: string, avgKey: string, dimension: string, emojiFn?: (label: string) => string) {
      const el = document.getElementById(containerId);
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }
      const maxVal = Math.max(...data.map(d => n(d[valueKey])));
      const color = CSS.primary;
      el.innerHTML = data.map(d => {
        const pct = maxVal > 0 ? (n(d[valueKey]) / maxVal * 100) : 0;
        const label = d[labelKey] ?? '–';
        const emoji = emojiFn ? emojiFn(label) : '';
        return `<div class="condition-bar">
          <span class="condition-bar-label">${emoji ? emoji + ' ' : ''}${label}</span>
          <div class="condition-bar-track"><div class="condition-bar-fill" style="width:${pct}%;background:${color}"></div></div>
          <span class="condition-bar-value">${n(d[valueKey])}</span>
          <span class="condition-bar-avg">Ø ${nf(d[avgKey])} kg</span>
        </div>`;
      }).join('');
    }

    function renderBestConditions(best: any) {
      const el = document.getElementById('bestConditions');
      if (!el) return;
      if (!best) { el.innerHTML = '<p class="placeholder">Keine Daten</p>'; return; }

      const parts: string[] = [];
      if (best.mond) parts.push(`${MOND_EMOJI[best.mond] || '🌙'} ${best.mond}`);
      if (best.wetter) parts.push(`${WETTER_EMOJI[best.wetter] || '🌤️'} ${best.wetter}`);
      if (best.uhrzeit) parts.push(`${uhrzeitEmoji(best.uhrzeit)} ${best.uhrzeit}`);
      if (best.druck) parts.push(`${druckEmoji(best.druck)} ${best.druck}`);
      if (best.wind) parts.push(`💨 ${best.wind}`);
      if (best.wassertemp) parts.push(`🌡️ ${best.wassertemp}`);

      el.innerHTML = `
        <div class="beste-bed-chips">
          ${parts.map(p => `<span class="condition-chip">${p}</span>`).join('')}
        </div>
        <div class="beste-bed-result">
          <span class="beste-bed-count">${n(best.fangzahl)} Fänge</span>
          <span class="beste-bed-avg">Ø ${nf(best.avg_gewicht)} kg</span>
        </div>
      `;
    }

    function renderGewaesser(data: any[]) {
      const el = document.getElementById('gewaesserChart');
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }

      const sorted = [...data].sort((a, b) => n(b.catch_count) - n(a.catch_count));
      const top8 = sorted.slice(0, 8);
      const rest = sorted.slice(8);
      const maxVal = n(top8[0]?.catch_count) || 1;

      const heatColor = (val: number): string => {
        const pct = val / maxVal;
        if (pct > 0.66) return CSS.primary;
        if (pct > 0.33) return CSS.primaryDim;
        return CSS.outline;
      };

      let html = top8.map(d => {
        const count = n(d.catch_count);
        const pct = (count / maxVal * 100);
        return `<div class="gewaesser-bar">
          <span class="gewaesser-bar-label">${d.water_name || 'Unbekannt'}</span>
          <div class="gewaesser-bar-track"><div class="gewaesser-bar-fill" style="width:${pct}%;background:${heatColor(count)}"></div></div>
          <span class="gewaesser-bar-value">${count}</span>
        </div>`;
      }).join('');

      if (rest.length) {
        html += `<details class="gewaesser-more"><summary>Weitere anzeigen (${rest.length})</summary>`;
        html += rest.map(d => {
          const count = n(d.catch_count);
          const pct = (count / maxVal * 100);
          return `<div class="gewaesser-bar">
            <span class="gewaesser-bar-label">${d.water_name || 'Unbekannt'}</span>
            <div class="gewaesser-bar-track"><div class="gewaesser-bar-fill" style="width:${pct}%;background:${heatColor(count)}"></div></div>
            <span class="gewaesser-bar-value">${count}</span>
          </div>`;
        }).join('');
        html += '</details>';
      }

      el.innerHTML = html;
    }

    function renderVerlauf(data: any[]) {
      const el = document.getElementById('verlaufChart');
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const months = data.map((d: any) => {
        const [y, m] = d.month.split('-');
        return Math.floor(new Date(+y, +m - 1, 15).getTime() / 1000);
      });
      const avgW = data.map((d: any) => n(d.avg_weight));
      const maxW = data.map((d: any) => n(d.max_weight));

      const opts: uPlot.Options = {
        width: el.clientWidth || 600,
        height: 320,
        cursor: { show: true },
        legend: { show: true },
        axes: [
          { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif',
            values: (_u: any, vals: any) => vals.map((v: number) => {
              const d = new Date(v * 1000);
              return d.toLocaleDateString('de-DE', { month: 'short', year: '2-digit' });
            }),
          },
          { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
        ],
        series: [
          {},
          { label: 'Ø Gewicht', stroke: CSS.primary, fill: 'rgba(108,122,87,0.18)', width: 2, points: { show: true, size: 4 } },
          { label: 'Max Gewicht', stroke: CSS.primaryDim, width: 2, dash: [6, 3] },
        ],
      };
      new uPlot(opts, [months, avgW, maxW], el);
    }

    function renderKombis(data: any[]) {
      const el = document.getElementById('kombiCards');
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }

      const kombiLabels: Record<string, string> = {
        mond: '🌙', druck: '📊', wetter: '🌤️', koeder: '🎣',
        uhrzeit: '🌅', wassertemp: '🌡️', lufttemp: '🌡️', wind: '💨'
      };

      const sorted = [...data].sort((a, b) => n(b.fangzahl) - n(a.fangzahl));

      el.innerHTML = sorted.slice(0, 8).map((k: any, i: number) => {
        const rank = i + 1;
        const rankClass = rank <= 3 ? `rank-${rank}` : '';
        const parts = (k.kombi ?? '').split(' + ').map((p: string) => {
          const [key, val] = p.split('=');
          return `${kombiLabels[key] || key} ${val}`;
        });
        return `<div class="kombi-card ${rankClass}">
          <div class="kombi-rank">${rank}</div>
          <div class="kombi-card-header">
            <span class="kombi-card-count">${n(k.fangzahl)} Fänge</span>
            <span class="kombi-card-weight">Ø ${nf(k.avg_gewicht)} kg</span>
          </div>
          <div class="kombi-card-label">${parts.join(' · ')}</div>
        </div>`;
      }).join('');
    }

    function renderDrilldown(data: any[]) {
      const tbody = document.getElementById('drilldownBody');
      const container = document.getElementById('drilldownContainer');
      if (!tbody || !container) return;
      if (!data.length) { tbody.innerHTML = '<tr><td colspan="6" class="no-data">Keine Daten</td></tr>'; return; }

      const rows = data.map((d: any) => `
        <tr>
          <td>${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '–'}</td>
          <td>${d.weight_kg ? nf(d.weight_kg) + ' kg' : '–'}</td>
          <td>${speciesName(d.species)}</td>
          <td>${d.water_name ?? '–'}</td>
          <td>${d.bait ?? '–'}</td>
          <td>${d.length_cm ? n(d.length_cm) + ' cm' : '–'}</td>
        </tr>
      `).join('');
      tbody.innerHTML = rows;

      let cards = data.map((d: any) => `
        <div class="detail-card">
          <div class="detail-card-row"><span class="detail-card-label">Datum</span><span>${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '–'}</span></div>
          <div class="detail-card-row"><span class="detail-card-label">Gewicht</span><span>${d.weight_kg ? nf(d.weight_kg) + ' kg' : '–'}</span></div>
          <div class="detail-card-row"><span class="detail-card-label">Fischart</span><span>${speciesName(d.species)}</span></div>
          <div class="detail-card-row"><span class="detail-card-label">Gewässer</span><span>${d.water_name ?? '–'}</span></div>
          <div class="detail-card-row"><span class="detail-card-label">Köder</span><span>${d.bait ?? '–'}</span></div>
          <div class="detail-card-row"><span class="detail-card-label">Länge</span><span>${d.length_cm ? n(d.length_cm) + ' cm' : '–'}</span></div>
        </div>
      `).join('');
      const existingCards = container.querySelector('.detail-cards-mobile');
      if (existingCards) existingCards.remove();
      const cardsDiv = document.createElement('div');
      cardsDiv.className = 'detail-cards-mobile';
      cardsDiv.innerHTML = cards;
      container.appendChild(cardsDiv);
    }

    function populateSelects(cond: any) {
      if (!cond?.buckets) return;
      const b = cond.buckets;
      function fillSelect(id: string, obj: Record<string, any> | undefined) {
        const sel = document.getElementById(id);
        if (!sel || !obj) return;
        const firstOpt = sel.options[0];
        sel.innerHTML = '';
        sel.appendChild(firstOpt);
        Object.keys(obj).forEach(k => {
          if (k && k !== 'Unbekannt') {
            const opt = document.createElement('option');
            opt.value = k; opt.textContent = k;
            sel.appendChild(opt);
          }
        });
      }
      fillSelect('gewaesser', b.gewaesser);
      fillSelect('koeder', b.koeder);
      fillSelect('mondphase', b.mond);
      fillSelect('wetter', b.wetter);
    }

    let refreshSeq = 0;

    async function refresh() {
      const mySeq = ++refreshSeq;
      const loadingEl = document.getElementById('loading-indicator');
      if (loadingEl) loadingEl.style.display = 'flex';
      const filters = getFilters();

      const [
        { data: cond },
        { data: bestCond },
        { data: verl },
        { data: gewData },
        { data: mondData },
        { data: wetterData },
        { data: druckData },
        { data: windData },
        { data: tempData },
        { data: kombis },
        { data: drill },
      ] = await Promise.all([
        supabase.rpc('stats_conditions', { p_filters: filters }),
        supabase.rpc('stats_best_conditions', { p_filters: filters }),
        supabase.rpc('stats_gewichtsverlauf', { p_filters: filters }),
        supabase.rpc('stats_drilldown_by_water', { p_filters: filters }),
        supabase.rpc('stats_drilldown_by_mond', { p_filters: filters }),
        supabase.rpc('stats_wetter_korrelation', { p_filters: filters }),
        supabase.rpc('stats_luftdruck_korrelation', { p_filters: filters }),
        supabase.rpc('stats_wind_korrelation', { p_filters: filters }),
        supabase.rpc('stats_wassertemp_korrelation', { p_filters: filters }),
        supabase.rpc('stats_beste_kombis', { p_filters: filters, p_limit: 8 }),
        supabase.rpc('stats_drilldown', { p_filters: filters }),
      ]);

      if (mySeq !== refreshSeq) return;

      const kpiFang = document.getElementById('kpiFang');
      const kpiAvg = document.getElementById('kpiAvg');
      const kpiMax = document.getElementById('kpiMax');
      const kpiWater = document.getElementById('kpiWater');
      if (kpiFang) kpiFang.textContent = String(n(cond?.total?.fangzahl));
      if (kpiAvg) kpiAvg.textContent = nf(cond?.total?.avg_gewicht) + ' kg';
      if (kpiMax) kpiMax.textContent = nf(cond?.total?.max_gewicht) + ' kg';
      if (kpiWater) kpiWater.textContent = String(Object.keys(cond?.buckets?.gewaesser ?? {}).length);

      renderBestConditions(bestCond);

      const mondBarsData = Object.entries(cond?.buckets?.mond ?? {}).map(([label, v]: any) => ({
        mond_phase: label, catch_count: n(v?.fangzahl), avg_weight: n(v?.avg_gewicht)
      }));
      renderConditionBars('mondBars', mondBarsData, 'mond_phase', 'catch_count', 'avg_weight', 'mond', (l) => MOND_EMOJI[l] || '🌙');
      renderConditionBars('wetterBars', wetterData ?? [], 'weather_type', 'catch_count', 'avg_weight', 'wetter', (l) => WETTER_EMOJI[l] || '🌤️');
      const uhrzeitBarsData = Object.entries(cond?.buckets?.uhrzeit ?? {}).map(([label, v]: any) => ({ uhrzeit_bereich: label, catch_count: n(v?.fangzahl), avg_weight: n(v?.avg_gewicht) }));
      renderConditionBars('uhrzeitBars', uhrzeitBarsData, 'uhrzeit_bereich', 'catch_count', 'avg_weight', 'uhrzeit', uhrzeitEmoji);
      renderConditionBars('druckBars', druckData ?? [], 'druck_bereich', 'catch_count', 'avg_weight', 'druck', druckEmoji);
      renderConditionBars('tempBars', tempData ?? [], 'temp_bereich', 'catch_count', 'avg_weight', 'temp', () => '🌡️');
      renderConditionBars('windBars', windData ?? [], 'wind_bereich', 'catch_count', 'avg_weight', 'wind', () => '💨');

      renderVerlauf(verl ?? []);
      renderGewaesser(gewData ?? []);
      renderKombis(kombis ?? []);
      renderDrilldown(drill ?? []);
      populateSelects(cond);

      if (loadingEl) loadingEl.style.display = 'none';
    }

    document.getElementById('zeitraumPills')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.pill') as HTMLElement;
      if (!btn) return;
      document.querySelectorAll('#zeitraumPills .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      refresh();
    });

    document.getElementById('btnApply')?.addEventListener('click', () => refresh());

    const observer = new MutationObserver(() => {
      CSS = getCSS();
      refresh();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    refresh();
  </script>
</Layout>

