---
import Layout from '../layouts/Layout.astro';
import { createSSRClient } from '../lib/ssr-client';

const supabase = createSSRClient(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect('/login');
---

<Layout title="Carp24 – Statistik" active="statistik" noindex>
  <main class="flex-grow px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto w-full py-xl flex flex-col gap-xl">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
      <div>
        <h1 class="text-display-lg text-primary mb-2">Fang-Statistiken</h1>
        <p class="text-body-lg text-on-surface-variant">Deine Fänge im Überblick — analysiere Bedingungen, Trends und Kombinationen.</p>
      </div>
    </div>

    <!-- FILTER -->
    <div id="filterBar" class="bg-surface-variant border border-outline-variant/20 rounded-[16px] p-lg mb-xl">
      <div class="flex flex-wrap gap-sm items-center mb-md">
        <span class="font-nav-item text-nav-item text-on-surface-variant uppercase tracking-widest mr-sm">Zeitraum:</span>
        <div id="zeitraumPills" class="flex flex-wrap gap-sm">
          <button class="pill active font-nav-item text-nav-item uppercase py-2 px-4 rounded-full border border-primary/40 text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 cursor-pointer bg-primary-container text-on-primary-container" data-value="all">Alle</button>
          <button class="pill font-nav-item text-nav-item uppercase py-2 px-4 rounded-full border border-primary/40 text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 cursor-pointer" data-value="7d">7d</button>
          <button class="pill font-nav-item text-nav-item uppercase py-2 px-4 rounded-full border border-primary/40 text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 cursor-pointer" data-value="30d">30d</button>
          <button class="pill font-nav-item text-nav-item uppercase py-2 px-4 rounded-full border border-primary/40 text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 cursor-pointer" data-value="90d">90d</button>
          <button class="pill font-nav-item text-nav-item uppercase py-2 px-4 rounded-full border border-primary/40 text-on-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-colors min-h-11 cursor-pointer" data-value="1y">1y</button>
        </div>
      </div>
      <div class="flex flex-wrap gap-sm items-center">
        <select id="gewaesser" class="bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-2 px-3 min-h-11 text-sm"><option value="">Gewässer</option></select>
        <select id="koeder" class="bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-2 px-3 min-h-11 text-sm"><option value="">Köder</option></select>
        <select id="mondphase" class="bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-2 px-3 min-h-11 text-sm"><option value="">Mond</option></select>
        <select id="wetter" class="bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-2 px-3 min-h-11 text-sm"><option value="">Wetter</option></select>
        <select id="druckTrend" class="bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-2 px-3 min-h-11 text-sm">
          <option value="">Druck</option>
          <option value="niedrig">&lt;1005</option>
          <option value="mittel">1005–1015</option>
          <option value="hoch">&gt;=1015</option>
        </select>
        <select id="wind" class="bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-2 px-3 min-h-11 text-sm">
          <option value="">Wind</option>
          <option value="windstill">&lt;5</option>
          <option value="leicht">5–10</option>
          <option value="maessig">10–20</option>
          <option value="stark">20+</option>
        </select>
        <button id="btnApply" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase py-2 px-6 rounded-full hover:bg-surface-tint transition-colors min-h-11 cursor-pointer">Anwenden</button>
      </div>
    </div>

    <!-- LOADING -->
    <div id="loading-indicator" class="hidden justify-center items-center py-lg">
      <div class="w-9 h-9 border-[3px] border-outline-variant border-t-primary-container rounded-full animate-spin"></div>
    </div>

    <!-- KPIs -->
    <div id="kpiRow" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter mb-xl">
      <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
        <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest">Fänge</span>
        <span id="kpiFang" class="text-display-lg text-primary">0</span>
      </div>
      <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
        <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest">Ø Gewicht</span>
        <span id="kpiAvg" class="text-display-lg text-primary">–</span>
      </div>
      <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
        <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest">Max Gewicht</span>
        <span id="kpiMax" class="text-display-lg text-primary">–</span>
      </div>
      <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
        <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest">Gewässer</span>
        <span id="kpiWater" class="text-display-lg text-primary">0</span>
      </div>
    </div>

    <!-- BESTE BEDINGUNGEN -->
    <section id="bestConditionsCard" class="bg-surface border-l-4 border-l-primary rounded-r-[16px] p-lg mb-xl">
      <span class="font-nav-item text-nav-item text-primary uppercase tracking-widest block mb-md">Beste Bedingungen</span>
      <div id="bestConditions" class="flex flex-wrap items-center gap-md">
        <p class="text-body-md text-on-surface-variant italic">Wird berechnet…</p>
      </div>
    </section>

    <!-- CHARTS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-xl">
      <section class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col">
        <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4">Dimensionen-Analyse</h3>
        <div class="flex flex-col gap-lg">
          <div>
            <h4 class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest mb-sm">Mondphase</h4>
            <div id="mondBars" class="flex flex-col gap-sm"></div>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest mb-sm">Wetter</h4>
            <div id="wetterBars" class="flex flex-col gap-sm"></div>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest mb-sm">Tageszeit</h4>
            <div id="uhrzeitBars" class="flex flex-col gap-sm"></div>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest mb-sm">Luftdruck</h4>
            <div id="druckBars" class="flex flex-col gap-sm"></div>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest mb-sm">Wassertemperatur</h4>
            <div id="tempBars" class="flex flex-col gap-sm"></div>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-primary-container uppercase tracking-widest mb-sm">Wind</h4>
            <div id="windBars" class="flex flex-col gap-sm"></div>
          </div>
        </div>
      </section>

      <section class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col">
        <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4">Gewichtsverlauf</h3>
        <div id="verlaufChart" class="flex-1 min-h-[300px]"></div>
      </section>
    </div>

    <!-- GEWÄSSER -->
    <section id="gewaesserSection" class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg mb-xl">
      <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4">Fänge nach Gewässer (Top 8)</h3>
      <div id="gewaesserChart" class="flex flex-col gap-sm max-h-[400px] overflow-y-auto"></div>
    </section>

    <!-- KOMBI-CARDS -->
    <section id="kombiSection" class="mb-xl">
      <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4">Top Kombinationen</h3>
      <div id="kombiCards" class="grid grid-cols-2 lg:grid-cols-4 gap-gutter"></div>
    </section>

    <!-- FANGDETAILS -->
    <section id="drilldownSection" class="overflow-hidden rounded-[16px] border border-outline-variant/20">
      <div class="bg-surface-container-high p-lg border-b border-outline-variant/20">
        <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest">Fangdetails</h3>
      </div>
      <div id="drilldownContainer" class="bg-surface">
        <div class="overflow-x-auto">
          <table class="w-full text-body-md">
            <thead>
              <tr class="bg-surface-variant">
                <th class="text-left py-3 px-4 font-label-sm text-label-sm text-primary-container uppercase tracking-widest">Datum</th>
                <th class="text-left py-3 px-4 font-label-sm text-label-sm text-primary-container uppercase tracking-widest">Gewicht</th>
                <th class="text-left py-3 px-4 font-label-sm text-label-sm text-primary-container uppercase tracking-widest">Fischart</th>
                <th class="text-left py-3 px-4 font-label-sm text-label-sm text-primary-container uppercase tracking-widest">Gewässer</th>
                <th class="text-left py-3 px-4 font-label-sm text-label-sm text-primary-container uppercase tracking-widest">Köder</th>
                <th class="text-left py-3 px-4 font-label-sm text-label-sm text-primary-container uppercase tracking-widest">Länge</th>
              </tr>
            </thead>
            <tbody id="drilldownBody"></tbody>
          </table>
        </div>
        <div id="drilldownCards" class="flex flex-col gap-sm p-lg lg:hidden"></div>
      </div>
    </section>

  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase-client';
  import uPlot from 'uplot';
  import 'uplot/dist/uPlot.min.css';

  function n(val: unknown): number {
    const v = Number(val);
    return Number.isFinite(v) ? v : 0;
  }

  function nf(val: unknown, digits = 1): string {
    const v = Number(val);
    return Number.isFinite(v) ? v.toFixed(digits) : '–';
  }

  function speciesName(s: string): string {
    const map: Record<string, string> = {
      SPIEGEL: 'Spiegelkarpfen', LEDER: 'Lederkarpfen', SCHUPPEN: 'Schuppenkarpfen',
      AMUR: 'Amurkarpfen', ANDERE: 'Andere',
      karpfen: 'Karpfen', schlei: 'Schlei', barsch: 'Barsch',
      hecht: 'Hecht', zander: 'Zander', wels: 'Wels',
      amur: 'Amur', karausche: 'Karausche', rotfeder: 'Rotfeder',
      brasse: 'Brasse', aland: 'Aland', laube: 'Laube',
    };
    return map[s?.toUpperCase()] ?? map[s?.toLowerCase()] ?? s ?? '–';
  }

  function getCSS(): Record<string, string> {
    const s = getComputedStyle(document.documentElement);
    return {
      primary: s.getPropertyValue('--color-primary-container').trim() || '#6c7a57',
      primaryDim: s.getPropertyValue('--color-primary-fixed-dim').trim() || '#a3b18a',
      surface: s.getPropertyValue('--color-surface-container-lowest').trim() || '#fff',
      outline: s.getPropertyValue('--color-outline-variant').trim() || '#c6c8bc',
      onSurface: s.getPropertyValue('--color-on-surface').trim() || '#181d14',
      onSurfaceVar: s.getPropertyValue('--color-on-surface-variant').trim() || '#45483f',
    };
  }

  let CSS = getCSS();

  const MOND_EMOJI: Record<string, string> = {
    'Neumond': '🌑', 'Zunehmend': '🌒', 'Erstes Viertel': '🌓',
    'Zunehmender Gibbus': '🌔', 'Vollmond': '🌕', 'Abnehmender Gibbus': '🌖',
    'Letztes Viertel': '🌗', 'Abnehmend': '🌘'
  };

  const WETTER_EMOJI: Record<string, string> = {
    'Sonnig': '☀️', 'Bewölkt': '☁️', 'Regen': '🌧️', 'Windig': '💨', 'Neblig': '🌫️',
    'sonnig': '☀️', 'bewölkt': '☁️', 'regen': '🌧️', 'windig': '💨', 'neblig': '🌫️',
  };

  function uhrzeitEmoji(label: string): string {
    const l = label.toLowerCase();
    if (l.includes('nacht') || l.includes('0-6') || l.includes('0–6')) return '🌙';
    if (l.includes('morgen') || l.includes('6-12') || l.includes('6–12')) return '🌅';
    if (l.includes('mittag') || l.includes('12-18') || l.includes('12–18')) return '☀️';
    if (l.includes('abend') || l.includes('18-24') || l.includes('18–24') || l.includes('18-0')) return '🌇';
    return '🌅';
  }

  function druckEmoji(label: string): string {
    const l = label.toLowerCase();
    if (l.includes('fall') || l.includes('niedrig') || l.includes('<') || l.includes('↘')) return '↘️';
    if (l.includes('steig') || l.includes('hoch') || l.includes('>') || l.includes('↗')) return '↗️';
    return '➡️';
  }

  function getFilters(): Record<string, any> {
    const f: Record<string, any> = {};
    const z = document.querySelector('#zeitraumPills .pill.active') as HTMLElement;
    if (z) {
      const val = z.dataset.value;
      const now = new Date();
      if (val && val !== 'all') {
        const d = new Date(now);
        if (val === '1y') d.setFullYear(d.getFullYear() - 1);
        else d.setDate(d.getDate() - parseInt(val));
        f.zeitraum = { von: d.toISOString().slice(0, 10), bis: now.toISOString().slice(0, 10) };
      }
    }
    const g = (document.getElementById('gewaesser') as HTMLSelectElement)?.value;
    if (g) f.gewaesser = g;
    const k = (document.getElementById('koeder') as HTMLSelectElement)?.value;
    if (k) f.koeder = k;
    const m = (document.getElementById('mondphase') as HTMLSelectElement)?.value;
    if (m) f.mond = m;
    const w = (document.getElementById('wetter') as HTMLSelectElement)?.value;
    if (w) f.wetter = w;
    const dt = (document.getElementById('druckTrend') as HTMLSelectElement)?.value;
    if (dt) f.druck_trend = dt;
    const wi = (document.getElementById('wind') as HTMLSelectElement)?.value;
    if (wi) f.wind = wi;
    return f;
  }

  function renderConditionBars(containerId: string, data: any[], labelKey: string, valueKey: string, avgKey: string, dimension: string, emojiFn?: (label: string) => string) {
    const el = document.getElementById(containerId);
    if (!el) return;
    if (!data.length) { el.innerHTML = '<p class="text-body-md text-on-surface-variant italic text-center py-md">Keine Daten</p>'; return; }
    const maxVal = Math.max(...data.map(d => n(d[valueKey])));
    const color = CSS.primary;
    el.innerHTML = data.map(d => {
      const pct = maxVal > 0 ? (n(d[valueKey]) / maxVal * 100) : 0;
      const label = d[labelKey] ?? '–';
      const emoji = emojiFn ? emojiFn(label) : '';
      return `<div class="flex items-center gap-sm text-body-md">
        <span class="w-[140px] text-right text-on-surface-variant truncate flex-shrink-0">${emoji ? emoji + ' ' : ''}${label}</span>
        <div class="flex-1 h-[22px] bg-surface-variant rounded-md overflow-hidden"><div class="h-full rounded-md min-w-[2px] transition-all duration-300" style="width:${pct}%;background:${color}"></div></div>
        <span class="font-bold text-on-surface min-w-[30px] text-right">${n(d[valueKey])}</span>
        <span class="text-on-surface-variant opacity-50 text-xs min-w-[70px]">Ø ${nf(d[avgKey])} kg</span>
      </div>`;
    }).join('');
  }

  function renderBestConditions(best: any) {
    const el = document.getElementById('bestConditions');
    if (!el) return;
    if (!best) { el.innerHTML = '<p class="text-body-md text-on-surface-variant italic">Keine Daten</p>'; return; }

    const parts: string[] = [];
    if (best.mond) parts.push(`${MOND_EMOJI[best.mond] || '🌙'} ${best.mond}`);
    if (best.wetter) parts.push(`${WETTER_EMOJI[best.wetter] || '🌤️'} ${best.wetter}`);
    if (best.uhrzeit) parts.push(`${uhrzeitEmoji(best.uhrzeit)} ${best.uhrzeit}`);
    if (best.druck) parts.push(`${druckEmoji(best.druck)} ${best.druck}`);
    if (best.wind) parts.push(`💨 ${best.wind}`);
    if (best.wassertemp) parts.push(`🌡️ ${best.wassertemp}`);

    el.innerHTML = `
      <div class="flex flex-wrap gap-sm flex-1">
        ${parts.map(p => `<span class="inline-flex items-center py-1 px-3 rounded-full bg-surface-variant text-body-md text-on-surface whitespace-nowrap font-medium">${p}</span>`).join('')}
      </div>
      <div class="flex items-baseline gap-sm">
        <span class="text-headline-md text-primary-container font-bold">${n(best.fangzahl)} Fänge</span>
        <span class="text-body-md text-on-surface-variant opacity-60">Ø ${nf(best.avg_gewicht)} kg</span>
      </div>
    `;
  }

  function renderGewaesser(data: any[]) {
    const el = document.getElementById('gewaesserChart');
    if (!el) return;
    if (!data.length) { el.innerHTML = '<p class="text-body-md text-on-surface-variant italic text-center py-md">Keine Daten</p>'; return; }

    const sorted = [...data].sort((a, b) => n(b.catch_count) - n(a.catch_count));
    const top8 = sorted.slice(0, 8);
    const rest = sorted.slice(8);
    const maxVal = n(top8[0]?.catch_count) || 1;

    const heatColor = (val: number): string => {
      const pct = val / maxVal;
      if (pct > 0.66) return CSS.primary;
      if (pct > 0.33) return CSS.primaryDim;
      return CSS.outline;
    };

    let html = top8.map(d => {
      const count = n(d.catch_count);
      const pct = (count / maxVal * 100);
      return `<div class="flex items-center gap-sm text-body-md">
        <span class="w-[180px] text-right text-on-surface-variant truncate flex-shrink-0">${d.water_name || 'Unbekannt'}</span>
        <div class="flex-1 h-6 bg-surface-variant rounded-md overflow-hidden"><div class="h-full rounded-md min-w-[2px] transition-all duration-300" style="width:${pct}%;background:${heatColor(count)}"></div></div>
        <span class="w-10 font-bold text-on-surface text-right">${count}</span>
      </div>`;
    }).join('');

    if (rest.length) {
      html += `<details class="mt-sm"><summary class="cursor-pointer text-body-md text-primary-container font-semibold py-sm">Weitere anzeigen (${rest.length})</summary>`;
      html += rest.map(d => {
        const count = n(d.catch_count);
        const pct = (count / maxVal * 100);
        return `<div class="flex items-center gap-sm text-body-md mt-sm">
          <span class="w-[180px] text-right text-on-surface-variant truncate flex-shrink-0">${d.water_name || 'Unbekannt'}</span>
          <div class="flex-1 h-6 bg-surface-variant rounded-md overflow-hidden"><div class="h-full rounded-md min-w-[2px] transition-all duration-300" style="width:${pct}%;background:${heatColor(count)}"></div></div>
          <span class="w-10 font-bold text-on-surface text-right">${count}</span>
        </div>`;
      }).join('');
      html += '</details>';
    }

    el.innerHTML = html;
  }

  function renderVerlauf(data: any[]) {
    const el = document.getElementById('verlaufChart');
    if (!el) return;
    if (!data.length) { el.innerHTML = '<p class="text-body-md text-on-surface-variant italic text-center py-md">Keine Daten</p>'; return; }
    el.innerHTML = '';
    const months = data.map((d: any) => {
      const [y, m] = d.month.split('-');
      return Math.floor(new Date(+y, +m - 1, 15).getTime() / 1000);
    });
    const avgW = data.map((d: any) => n(d.avg_weight));
    const maxW = data.map((d: any) => n(d.max_weight));

    const opts: uPlot.Options = {
      width: el.clientWidth || 600,
      height: 320,
      cursor: { show: true },
      legend: { show: true },
      axes: [
        { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif',
          values: (_u: any, vals: any) => vals.map((v: number) => {
            const d = new Date(v * 1000);
            return d.toLocaleDateString('de-DE', { month: 'short', year: '2-digit' });
          }),
        },
        { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
      ],
      series: [
        {},
        { label: 'Ø Gewicht', stroke: CSS.primary, fill: 'rgba(108,122,87,0.18)', width: 2, points: { show: true, size: 4 } },
        { label: 'Max Gewicht', stroke: CSS.primaryDim, width: 2, dash: [6, 3] },
      ],
    };
    new uPlot(opts, [months, avgW, maxW], el);
  }

  function renderKombis(data: any[]) {
    const el = document.getElementById('kombiCards');
    if (!el) return;
    if (!data.length) { el.innerHTML = '<p class="text-body-md text-on-surface-variant italic text-center py-md col-span-full">Keine Daten</p>'; return; }

    const kombiLabels: Record<string, string> = {
      mond: '🌙', druck: '📊', wetter: '🌤️', koeder: '🎣',
      uhrzeit: '🌅', wassertemp: '🌡️', lufttemp: '🌡️', wind: '💨'
    };

    const sorted = [...data].sort((a, b) => n(b.fangzahl) - n(a.fangzahl));

    el.innerHTML = sorted.slice(0, 8).map((k: any, i: number) => {
      const rank = i + 1;
      const rankBorder = rank === 1 ? 'border-[#d4a843]' : rank === 2 ? 'border-[#b8b8b8]' : rank === 3 ? 'border-[#c4956a]' : 'border-outline-variant/20';
      const rankBg = rank === 1 ? 'bg-[#fdf8ef]' : rank === 2 ? 'bg-[#f7f7f7]' : rank === 3 ? 'bg-[#fbf4ee]' : 'bg-surface-variant';
      const rankBadge = rank === 1 ? 'bg-[#d4a843] text-white' : rank === 2 ? 'bg-[#b8b8b8] text-white' : rank === 3 ? 'bg-[#c4956a] text-white' : 'bg-primary-container text-on-primary-container';
      const parts = (k.kombi ?? '').split(' + ').map((p: string) => {
        const [key, val] = p.split('=');
        return `${kombiLabels[key] || key} ${val}`;
      });
      return `<div class="${rankBg} ${rankBorder} border-2 rounded-[16px] p-lg flex flex-col gap-sm relative">
        <div class="absolute -top-2 -left-2 w-6 h-6 rounded-full ${rankBadge} text-xs font-bold flex items-center justify-center">${rank}</div>
        <div class="flex justify-between items-center">
          <span class="text-headline-md text-primary-container font-bold">${n(k.fangzahl)} Fänge</span>
          <span class="text-body-md text-on-surface-variant opacity-60">Ø ${nf(k.avg_gewicht)} kg</span>
        </div>
        <div class="text-body-md text-on-surface opacity-80 leading-relaxed">${parts.join(' · ')}</div>
      </div>`;
    }).join('');
  }

  function renderDrilldown(data: any[]) {
    const tbody = document.getElementById('drilldownBody');
    const cardsContainer = document.getElementById('drilldownCards');
    if (!tbody) return;
    if (!data.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center py-lg text-on-surface-variant italic text-body-md">Keine Daten</td></tr>';
      if (cardsContainer) cardsContainer.innerHTML = '<p class="text-center py-lg text-on-surface-variant italic text-body-md">Keine Daten</p>';
      return;
    }

    const rows = data.map((d: any) => `
      <tr class="border-b border-outline-variant/20 hover:bg-surface-variant transition-colors">
        <td class="py-3 px-4 text-body-md text-on-surface">${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '–'}</td>
        <td class="py-3 px-4 text-body-md text-on-surface font-bold">${d.weight_kg ? nf(d.weight_kg) + ' kg' : '–'}</td>
        <td class="py-3 px-4 text-body-md text-on-surface">${speciesName(d.species)}</td>
        <td class="py-3 px-4 text-body-md text-on-surface-variant">${d.water_name ?? '–'}</td>
        <td class="py-3 px-4 text-body-md text-on-surface-variant">${d.bait ?? '–'}</td>
        <td class="py-3 px-4 text-body-md text-on-surface-variant">${d.length_cm ? n(d.length_cm) + ' cm' : '–'}</td>
      </tr>
    `).join('');
    tbody.innerHTML = rows;

    if (cardsContainer) {
      const cards = data.map((d: any) => `
        <div class="bg-surface-variant rounded-lg p-md border border-outline-variant/20">
          <div class="flex justify-between py-xs text-body-md"><span class="text-on-surface-variant font-semibold">Datum</span><span class="text-on-surface">${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '–'}</span></div>
          <div class="flex justify-between py-xs text-body-md"><span class="text-on-surface-variant font-semibold">Gewicht</span><span class="text-on-surface font-bold">${d.weight_kg ? nf(d.weight_kg) + ' kg' : '–'}</span></div>
          <div class="flex justify-between py-xs text-body-md"><span class="text-on-surface-variant font-semibold">Fischart</span><span class="text-on-surface">${speciesName(d.species)}</span></div>
          <div class="flex justify-between py-xs text-body-md"><span class="text-on-surface-variant font-semibold">Gewässer</span><span class="text-on-surface-variant">${d.water_name ?? '–'}</span></div>
          <div class="flex justify-between py-xs text-body-md"><span class="text-on-surface-variant font-semibold">Köder</span><span class="text-on-surface-variant">${d.bait ?? '–'}</span></div>
          <div class="flex justify-between py-xs text-body-md"><span class="text-on-surface-variant font-semibold">Länge</span><span class="text-on-surface-variant">${d.length_cm ? n(d.length_cm) + ' cm' : '–'}</span></div>
        </div>
      `).join('');
      cardsContainer.innerHTML = cards;
    }
  }

  function populateSelects(cond: any) {
    if (!cond?.buckets) return;
    const b = cond.buckets;
    function fillSelect(id: string, obj: Record<string, any> | undefined) {
      const sel = document.getElementById(id);
      if (!sel || !obj) return;
      const firstOpt = sel.options[0];
      sel.innerHTML = '';
      sel.appendChild(firstOpt);
      Object.keys(obj).forEach(k => {
        if (k && k !== 'Unbekannt') {
          const opt = document.createElement('option');
          opt.value = k; opt.textContent = k;
          sel.appendChild(opt);
        }
      });
    }
    fillSelect('gewaesser', b.gewaesser);
    fillSelect('koeder', b.koeder);
    fillSelect('mondphase', b.mond);
    fillSelect('wetter', b.wetter);
  }

  let refreshSeq = 0;

  async function refresh() {
    const mySeq = ++refreshSeq;
    const loadingEl = document.getElementById('loading-indicator');
    if (loadingEl) loadingEl.classList.remove('hidden');
    const filters = getFilters();

    const [
      { data: cond },
      { data: bestCond },
      { data: verl },
      { data: gewData },
      { data: mondData },
      { data: wetterData },
      { data: druckData },
      { data: windData },
      { data: tempData },
      { data: kombis },
      { data: drill },
    ] = await Promise.all([
      supabase.rpc('stats_conditions', { p_filters: filters }),
      supabase.rpc('stats_best_conditions', { p_filters: filters }),
      supabase.rpc('stats_gewichtsverlauf', { p_filters: filters }),
      supabase.rpc('stats_drilldown_by_water', { p_filters: filters }),
      supabase.rpc('stats_drilldown_by_mond', { p_filters: filters }),
      supabase.rpc('stats_wetter_korrelation', { p_filters: filters }),
      supabase.rpc('stats_luftdruck_korrelation', { p_filters: filters }),
      supabase.rpc('stats_wind_korrelation', { p_filters: filters }),
      supabase.rpc('stats_wassertemp_korrelation', { p_filters: filters }),
      supabase.rpc('stats_beste_kombis', { p_filters: filters, p_limit: 8 }),
      supabase.rpc('stats_drilldown', { p_filters: filters }),
    ]);

    if (mySeq !== refreshSeq) return;

    const kpiFang = document.getElementById('kpiFang');
    const kpiAvg = document.getElementById('kpiAvg');
    const kpiMax = document.getElementById('kpiMax');
    const kpiWater = document.getElementById('kpiWater');
    if (kpiFang) kpiFang.textContent = String(n(cond?.total?.fangzahl));
    if (kpiAvg) kpiAvg.textContent = nf(cond?.total?.avg_gewicht) + ' kg';
    if (kpiMax) kpiMax.textContent = nf(cond?.total?.max_gewicht) + ' kg';
    if (kpiWater) kpiWater.textContent = String(Object.keys(cond?.buckets?.gewaesser ?? {}).length);

    renderBestConditions(bestCond);

    const mondBarsData = Object.entries(cond?.buckets?.mond ?? {}).map(([label, v]: any) => ({
      mond_phase: label, catch_count: n(v?.fangzahl), avg_weight: n(v?.avg_gewicht)
    }));
    renderConditionBars('mondBars', mondBarsData, 'mond_phase', 'catch_count', 'avg_weight', 'mond', (l) => MOND_EMOJI[l] || '🌙');
    renderConditionBars('wetterBars', wetterData ?? [], 'weather_type', 'catch_count', 'avg_weight', 'wetter', (l) => WETTER_EMOJI[l] || '🌤️');
    const uhrzeitBarsData = Object.entries(cond?.buckets?.uhrzeit ?? {}).map(([label, v]: any) => ({ uhrzeit_bereich: label, catch_count: n(v?.fangzahl), avg_weight: n(v?.avg_gewicht) }));
    renderConditionBars('uhrzeitBars', uhrzeitBarsData, 'uhrzeit_bereich', 'catch_count', 'avg_weight', 'uhrzeit', uhrzeitEmoji);
    renderConditionBars('druckBars', druckData ?? [], 'druck_bereich', 'catch_count', 'avg_weight', 'druck', druckEmoji);
    renderConditionBars('tempBars', tempData ?? [], 'temp_bereich', 'catch_count', 'avg_weight', 'temp', () => '🌡️');
    renderConditionBars('windBars', windData ?? [], 'wind_bereich', 'catch_count', 'avg_weight', 'wind', () => '💨');

    renderVerlauf(verl ?? []);
    renderGewaesser(gewData ?? []);
    renderKombis(kombis ?? []);
    renderDrilldown(drill ?? []);
    populateSelects(cond);

    if (loadingEl) loadingEl.classList.add('hidden');
  }

  document.getElementById('zeitraumPills')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.pill') as HTMLElement;
    if (!btn) return;
    document.querySelectorAll('#zeitraumPills .pill').forEach(b => {
      b.classList.remove('active', 'bg-primary-container', 'text-on-primary-container');
      b.classList.add('text-on-surface-variant');
    });
    btn.classList.add('active', 'bg-primary-container', 'text-on-primary-container');
    btn.classList.remove('text-on-surface-variant');
    refresh();
  });

  document.getElementById('btnApply')?.addEventListener('click', () => refresh());

  const observer = new MutationObserver(() => {
    CSS = getCSS();
    refresh();
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  refresh();
</script>
