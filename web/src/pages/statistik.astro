---
import { createSSRClient } from '../lib/ssr-client';
import Layout from '../layouts/Layout.astro';

const supabase = createSSRClient(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) {
  return Astro.redirect('/login');
}
---

<Layout title="Statistik" active="statistik">
  <div class="stats-page">
    <aside class="filter-sidebar" id="filterSidebar">
      <h2>Filter</h2>

      <div class="filter-section">
        <label>Zeitraum</label>
        <div class="pills" id="zeitraumPills">
          <button class="pill active" data-value="all">Alle</button>
          <button class="pill" data-value="7d">7 Tage</button>
          <button class="pill" data-value="30d">30 Tage</button>
          <button class="pill" data-value="90d">90 Tage</button>
          <button class="pill" data-value="1y">1 Jahr</button>
        </div>
      </div>

      <div class="filter-section">
        <label>Fischart</label>
        <div class="pills" id="fischartPills">
          <button class="pill active" data-value="">Alle</button>
        </div>
      </div>

      <div class="filter-section">
        <label for="gewaesser">Gewässer</label>
        <select id="gewaesser"><option value="">Alle</option></select>
      </div>

      <div class="filter-section">
        <label for="koeder">Köder</label>
        <select id="koeder"><option value="">Alle</option></select>
      </div>

      <details class="filter-advanced">
        <summary>Weitere Filter</summary>
        <div class="filter-section">
          <label for="mondphase">Mondphase</label>
          <select id="mondphase"><option value="">Alle</option></select>
        </div>
        <div class="filter-section">
          <label for="wetter">Wetter</label>
          <select id="wetter"><option value="">Alle</option></select>
        </div>
        <div class="filter-section">
          <label for="druckTrend">Luftdruck</label>
          <select id="druckTrend">
            <option value="">Alle</option>
            <option value="niedrig">&lt;1005 hPa</option>
            <option value="mittel">1005–1015 hPa</option>
            <option value="hoch">&gt;=1015 hPa</option>
          </select>
        </div>
        <div class="filter-section">
          <label for="wind">Wind</label>
          <select id="wind">
            <option value="">Alle</option>
            <option value="windstill">&lt;5 km/h</option>
            <option value="leicht">5–10 km/h</option>
            <option value="maessig">10–20 km/h</option>
            <option value="stark">20+ km/h</option>
          </select>
        </div>
        <div class="filter-section">
          <label>Quick-Filters</label>
          <div class="pills" id="presetPills">
            <button class="pill" data-preset="vollmond">🌕 Vollmond</button>
            <button class="pill" data-preset="neumond">🌑 Neumond</button>
            <button class="pill" data-preset="regen">🌧️ Regen</button>
            <button class="pill" data-preset="wind">💨 Windig</button>
          </div>
        </div>
      </details>

      <button class="btn-apply" id="btnApply">Anwenden</button>
    </aside>

    <main class="stats-content">
      <h1>Fang-Statistiken</h1>
      <div id="loading-indicator" class="loading-indicator">Daten laden...</div>

      <!-- 1. KPIs -->
      <div class="kpi-row" id="kpiRow">
        <div class="kpi-card">
          <span class="kpi-value" id="kpiFang">0</span>
          <span class="kpi-label">FÄNGE</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value" id="kpiAvg">– kg</span>
          <span class="kpi-label">Ø GEWICHT</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value" id="kpiMax">– kg</span>
          <span class="kpi-label">MAX GEWICHT</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value" id="kpiWater">0</span>
          <span class="kpi-label">GEWÄSSER</span>
        </div>
      </div>

      <!-- 2. Beste Bedingungen -->
      <div class="chart-grid">
        <section class="chart-card wide" id="bestConditionsCard">
          <h3>⭐ Beste Bedingungen</h3>
          <div class="best-cond-content" id="bestConditions">
            <p class="best-cond-placeholder">Wird berechnet...</p>
          </div>
        </section>
      </div>

      <!-- 3. Bedingungen Matrix -->
      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>📊 Bedingungen-Matrix</h3>
          <div class="conditions-grid">
            <div class="condition-row">
              <h4>🌙 Mondphase</h4>
              <div id="mondBars" class="condition-bars"></div>
            </div>
            <div class="condition-row">
              <h4>🌤️ Wetter</h4>
              <div id="wetterBars" class="condition-bars"></div>
            </div>
            <div class="condition-row">
              <h4>📊 Luftdruck</h4>
              <div id="druckBars" class="condition-bars"></div>
            </div>
            <div class="condition-row">
              <h4>🌡️ Wassertemperatur</h4>
              <div id="tempBars" class="condition-bars"></div>
            </div>
            <div class="condition-row">
              <h4>💨 Wind</h4>
              <div id="windBars" class="condition-bars"></div>
            </div>
          </div>
        </section>
      </div>

      <!-- 4. Gewichtsverlauf -->
      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>📈 Gewichtsverlauf</h3>
          <div id="verlaufChart"></div>
        </section>
      </div>

      <!-- 5. Gewässer -->
      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>🏞️ Fänge nach Gewässer</h3>
          <div id="gewaesserChart"></div>
        </section>
      </div>

      <!-- 6. Kombi-Cards -->
      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>🏆 Top Kombinationen</h3>
          <div id="kombiCards" class="kombi-cards"></div>
        </section>
      </div>

      <!-- 7. Fangdetails -->
      <div class="chart-grid">
        <section class="chart-card wide">
          <h3>📋 Fangdetails</h3>
          <table class="detail-table">
            <thead>
              <tr><th>Datum</th><th>Gewicht</th><th>Fischart</th><th>Gewässer</th><th>Köder</th></tr>
            </thead>
            <tbody id="drilldownBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>

  <script>
    import { supabase } from '../lib/supabase-client';
    import uPlot from 'uplot';
    import 'uplot/dist/uPlot.min.css';

    const MONAT_NAMES = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
    function monatName(m: number) { return MONAT_NAMES[m - 1] ?? String(m); }

    function speciesName(s: string): string {
      const map: Record<string, string> = {
        karpfen: 'Karpfen', schlei: 'Schlei', barsch: 'Barsch',
        hecht: 'Hecht', zander: 'Zander', wels: 'Wels',
        amur: 'Amur', karausche: 'Karausche', rotfeder: 'Rotfeder',
        brasse: 'Brasse', aland: 'Aland', laube: 'Laube',
      };
      return map[s?.toLowerCase()] ?? s ?? '–';
    }

    function n(val: unknown): number {
      const v = Number(val);
      return Number.isFinite(v) ? v : 0;
    }

    function nf(val: unknown, digits = 1): string {
      const v = Number(val);
      return Number.isFinite(v) ? v.toFixed(digits) : '–';
    }

    function getCSS(): Record<string, string> {
      const s = getComputedStyle(document.documentElement);
      return {
        primary: s.getPropertyValue('--color-primary-container').trim() || '#6c7a57',
        primaryDim: s.getPropertyValue('--color-primary-fixed-dim').trim() || '#a3b18a',
        primaryFixed: s.getPropertyValue('--color-primary-fixed').trim() || '#dde5b6',
        surface: s.getPropertyValue('--color-surface-container-lowest').trim() || '#fff',
        outline: s.getPropertyValue('--color-outline-variant').trim() || '#c6c8bc',
        onSurface: s.getPropertyValue('--color-on-surface').trim() || '#181d14',
        onSurfaceVar: s.getPropertyValue('--color-on-surface-variant').trim() || '#45483f',
      };
    }

    let CSS = getCSS();

    function getFilters(): Record<string, any> {
      const f: Record<string, any> = {};
      const z = document.querySelector('#zeitraumPills .pill.active') as HTMLElement;
      if (z) {
        const val = z.dataset.value;
        const now = new Date();
        if (val && val !== 'all') {
          const d = new Date(now);
          if (val === '1y') d.setFullYear(d.getFullYear() - 1);
          else d.setDate(d.getDate() - parseInt(val));
          f.zeitraum = { von: d.toISOString().slice(0, 10), bis: now.toISOString().slice(0, 10) };
        }
      }
      const g = (document.getElementById('gewaesser') as HTMLSelectElement)?.value;
      if (g) f.gewaesser = g;
      const k = (document.getElementById('koeder') as HTMLSelectElement)?.value;
      if (k) f.koeder = k;
      const m = (document.getElementById('mondphase') as HTMLSelectElement)?.value;
      if (m) f.mond = m;
      const w = (document.getElementById('wetter') as HTMLSelectElement)?.value;
      if (w) f.wetter = w;
      const fa = (document.querySelector('#fischartPills .pill.active') as HTMLElement)?.dataset?.value;
      if (fa) f.art = fa;
      const dt = (document.getElementById('druckTrend') as HTMLSelectElement)?.value;
      if (dt) f.druck_trend = dt;
      const wi = (document.getElementById('wind') as HTMLSelectElement)?.value;
      if (wi) f.wind = wi;
      return f;
    }

    function renderConditionBars(containerId: string, data: any[], labelKey: string, valueKey: string, avgKey: string) {
      const el = document.getElementById(containerId);
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }
      const maxVal = Math.max(...data.map(d => n(d[valueKey])));
      el.innerHTML = data.map(d => {
        const pct = maxVal > 0 ? (n(d[valueKey]) / maxVal * 100) : 0;
        return `<div class="condition-bar">
          <span class="condition-bar-label">${d[labelKey] ?? '–'}</span>
          <div class="condition-bar-track"><div class="condition-bar-fill" style="width:${pct}%"></div></div>
          <span class="condition-bar-value">${n(d[valueKey])}</span>
          <span class="condition-bar-avg">Ø ${nf(d[avgKey])} kg</span>
        </div>`;
      }).join('');
    }

    function renderBestConditions(best: any) {
      const el = document.getElementById('bestConditions');
      if (!el) return;
      if (!best) { el.innerHTML = '<p class="best-cond-placeholder">Keine Daten</p>'; return; }

      const mondEmoji: Record<string, string> = {
        'Neumond': '🌑', 'Zunehmend': '🌒', 'Erstes Viertel': '🌓',
        'Zunehmender Gibbus': '🌔', 'Vollmond': '🌕', 'Abnehmender Gibbus': '🌖',
        'Letztes Viertel': '🌗', 'Abnehmend': '🌘'
      };

      const parts: string[] = [];
      if (best.mond) parts.push(`${mondEmoji[best.mond] || '🌙'} ${best.mond}`);
      if (best.wetter) parts.push(`🌤️ ${best.wetter}`);
      if (best.druck) parts.push(`📊 ${best.druck}`);
      if (best.wassertemp) parts.push(`🌡️ ${best.wassertemp}`);
      if (best.wind) parts.push(`💨 ${best.wind}`);
      if (best.koeder) parts.push(`🎣 ${best.koeder}`);

      const emoji = best.mond ? (mondEmoji[best.mond] || '🌙') : '⭐';

      el.innerHTML = `
        <div class="best-cond-main">
          <span class="best-cond-emoji">${emoji}</span>
          <div class="best-cond-stats">
            <span class="best-cond-weight">${nf(best.avg_gewicht)} kg</span>
            <span class="best-cond-label">Ø Gewicht</span>
          </div>
          <div class="best-cond-stats">
            <span class="best-cond-count">${n(best.fangzahl)}</span>
            <span class="best-cond-label">Fänge</span>
          </div>
        </div>
        <div class="best-cond-parts">${parts.map(p => `<span class="best-cond-tag">${p}</span>`).join('')}</div>
        <button class="btn-filter-best" id="btnFilterBest">Diese Bedingungen filtern</button>
      `;

      document.getElementById('btnFilterBest')?.addEventListener('click', () => {
        if (best.mond) (document.getElementById('mondphase') as HTMLSelectElement).value = best.mond;
        if (best.wetter) (document.getElementById('wetter') as HTMLSelectElement).value = best.wetter;
        if (best.koeder) (document.getElementById('koeder') as HTMLSelectElement).value = best.koeder;
        refresh();
      });
    }

    function renderGewaesser(data: any[]) {
      const el = document.getElementById('gewaesserChart');
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const labels = data.map((d: any) => d.water_name || 'Unbekannt');
      const counts = data.map((d: any) => n(d.catch_count));
      const indices = data.map((_: any, i: number) => i);

      const opts: uPlot.Options = {
        width: el.clientWidth || 600,
        height: Math.max(200, data.length * 36),
        axes: [
          { stroke: CSS.onSurfaceVar, grid: { show: false }, font: '12px "Source Sans 3", sans-serif',
            values: (_u: any, _vals: any) => labels },
          { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
        ],
        series: [
          {},
          { label: 'Fänge', stroke: CSS.primary, fill: CSS.primary + '40', width: 1 },
        ],
      };
      new uPlot(opts, [indices, counts], el);
    }

    function renderVerlauf(data: any[]) {
      const el = document.getElementById('verlaufChart');
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }
      el.innerHTML = '';
      const months = data.map((d: any) => {
        const [y, m] = d.month.split('-');
        return Math.floor(new Date(+y, +m - 1, 15).getTime() / 1000);
      });
      const avgW = data.map((d: any) => n(d.avg_weight));
      const maxW = data.map((d: any) => n(d.max_weight));

      const opts: uPlot.Options = {
        width: el.clientWidth || 600,
        height: 280,
        axes: [
          { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif',
            values: (_u: any, vals: any) => vals.map((v: number) => {
              const d = new Date(v * 1000);
              return d.toLocaleDateString('de-DE', { month: 'short', year: '2-digit' });
            }),
          },
          { stroke: CSS.onSurfaceVar, grid: { stroke: CSS.outline }, font: '12px "Source Sans 3", sans-serif' },
        ],
        series: [
          {},
          { label: 'Ø Gewicht', stroke: CSS.primary, width: 2, points: { show: true, size: 5 } },
          { label: 'Max Gewicht', stroke: CSS.primaryDim, width: 2, dash: [6, 3] },
        ],
      };
      new uPlot(opts, [months, avgW, maxW], el);
    }

    function renderKombis(data: any[]) {
      const el = document.getElementById('kombiCards');
      if (!el) return;
      if (!data.length) { el.innerHTML = '<p class="no-data">Keine Daten</p>'; return; }

      const kombiLabels: Record<string, string> = {
        mond: '🌙', druck: '📊', wetter: '🌤️', koeder: '🎣',
        uhrzeit: '⏰', wassertemp: '🌡️', lufttemp: '🌡️', wind: '💨'
      };

      el.innerHTML = data.slice(0, 8).map((k: any) => {
        const parts = (k.kombi ?? '').split(' + ').map((p: string) => {
          const [key, val] = p.split('=');
          return `${kombiLabels[key] || key} ${val}`;
        });
        const avg = nf(k.avg_gewicht);
        const stars = n(k.avg_gewicht) >= 10 ? '⭐⭐⭐' : n(k.avg_gewicht) >= 7 ? '⭐⭐' : '⭐';
        return `<div class="kombi-card">
          <div class="kombi-card-header">
            <span class="kombi-card-weight">${avg} kg</span>
            <span class="kombi-card-count">${n(k.fangzahl)} Fänge</span>
          </div>
          <div class="kombi-card-label">${parts.join(' · ')}</div>
          <div class="kombi-card-stars">${stars}</div>
        </div>`;
      }).join('');
    }

    function renderDrilldown(data: any[]) {
      const tbody = document.getElementById('drilldownBody');
      if (!tbody) return;
      if (!data.length) { tbody.innerHTML = '<tr><td colspan="5" class="no-data">Keine Daten</td></tr>'; return; }
      tbody.innerHTML = data.map((d: any) => `
        <tr>
          <td>${d.catch_ts ? new Date(d.catch_ts).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '–'}</td>
          <td>${d.weight_kg ? nf(d.weight_kg) + ' kg' : '–'}</td>
          <td>${speciesName(d.species)}</td>
          <td>${d.water_name ?? '–'}</td>
          <td>${d.bait ?? '–'}</td>
        </tr>
      `).join('');
    }

    function populateSelects(cond: any) {
      if (!cond?.buckets) return;
      const b = cond.buckets;
      function fillSelect(id: string, obj: Record<string, any> | undefined) {
        const sel = document.getElementById(id);
        if (!sel || !obj) return;
        while (sel.options.length > 1) sel.remove(1);
        Object.keys(obj).forEach(k => {
          if (k && k !== 'Unbekannt') {
            const opt = document.createElement('option');
            opt.value = k; opt.textContent = k;
            sel.appendChild(opt);
          }
        });
      }
      fillSelect('gewaesser', b.gewaesser);
      fillSelect('koeder', b.koeder);
      fillSelect('mondphase', b.mond);
      fillSelect('wetter', b.wetter);

      const fischartPills = document.getElementById('fischartPills');
      if (fischartPills && b.art) {
        fischartPills.innerHTML = '<button class="pill active" data-value="">Alle</button>';
        Object.keys(b.art).forEach(k => {
          if (k && k !== 'Unbekannt') {
            fischartPills.innerHTML += `<button class="pill" data-value="${k}">${k} (${n(b.art[k])})</button>`;
          }
        });
        fischartPills.querySelectorAll('.pill').forEach(p => p.addEventListener('click', () => {
          fischartPills.querySelectorAll('.pill').forEach(x => x.classList.remove('active'));
          p.classList.add('active');
          refresh();
        }));
      }
    }

    let refreshSeq = 0;

    async function refresh() {
      const mySeq = ++refreshSeq;
      const loadingEl = document.getElementById('loading-indicator');
      if (loadingEl) loadingEl.style.display = 'block';
      const filters = getFilters();

      const [
        { data: cond },
        { data: bestCond },
        { data: verl },
        { data: gewData },
        { data: mondData },
        { data: wetterData },
        { data: druckData },
        { data: windData },
        { data: tempData },
        { data: kombis },
        { data: drill },
      ] = await Promise.all([
        supabase.rpc('stats_conditions', { p_filters: filters }),
        supabase.rpc('stats_best_conditions', { p_filters: filters }),
        supabase.rpc('stats_gewichtsverlauf', { p_filters: filters }),
        supabase.rpc('stats_drilldown_by_water', { p_filters: filters }),
        supabase.rpc('stats_drilldown_by_mond', { p_filters: filters }),
        supabase.rpc('stats_wetter_korrelation', { p_filters: filters }),
        supabase.rpc('stats_luftdruck_korrelation', { p_filters: filters }),
        supabase.rpc('stats_wind_korrelation', { p_filters: filters }),
        supabase.rpc('stats_wassertemp_korrelation', { p_filters: filters }),
        supabase.rpc('stats_beste_kombis', { p_filters: filters, p_limit: 8 }),
        supabase.rpc('stats_drilldown', { p_filters: filters }),
      ]);

      if (mySeq !== refreshSeq) return;

      // KPIs
      const kpiFang = document.getElementById('kpiFang');
      const kpiAvg = document.getElementById('kpiAvg');
      const kpiMax = document.getElementById('kpiMax');
      const kpiWater = document.getElementById('kpiWater');
      if (kpiFang) kpiFang.textContent = String(n(cond?.total?.fangzahl));
      if (kpiAvg) kpiAvg.textContent = nf(cond?.total?.avg_gewicht) + ' kg';
      if (kpiMax) kpiMax.textContent = nf(cond?.total?.max_gewicht) + ' kg';
      if (kpiWater) kpiWater.textContent = String(Object.keys(cond?.buckets?.gewaesser ?? {}).length);

      // Beste Bedingungen
      renderBestConditions(bestCond);

      // Bedingungen Matrix (Mond from buckets, rest from RPCs)
      const mondBarsData = Object.entries(cond?.buckets?.mond ?? {}).map(([label, v]: any) => ({
        mond_phase: label, catch_count: n(v?.fangzahl), avg_weight: n(v?.avg_gewicht)
      }));
      renderConditionBars('mondBars', mondBarsData, 'mond_phase', 'catch_count', 'avg_weight');
      renderConditionBars('wetterBars', wetterData ?? [], 'weather_type', 'catch_count', 'avg_weight');
      renderConditionBars('druckBars', druckData ?? [], 'druck_bereich', 'catch_count', 'avg_weight');
      renderConditionBars('tempBars', tempData ?? [], 'temp_bereich', 'catch_count', 'avg_weight');
      renderConditionBars('windBars', windData ?? [], 'wind_bereich', 'catch_count', 'avg_weight');

      // Charts
      renderVerlauf(verl ?? []);
      renderGewaesser(gewData ?? []);

      // Kombi-Cards
      renderKombis(kombis ?? []);

      // Fangdetails
      renderDrilldown(drill ?? []);

      // Selects
      populateSelects(cond);

      if (loadingEl) loadingEl.style.display = 'none';
    }

    // Pills
    document.getElementById('zeitraumPills')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.pill') as HTMLElement;
      if (!btn) return;
      document.querySelectorAll('#zeitraumPills .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });

    document.getElementById('btnApply')?.addEventListener('click', () => refresh());

    document.getElementById('presetPills')?.querySelectorAll('.pill').forEach(p => {
      p.addEventListener('click', () => {
        const preset = (p as HTMLElement).dataset.preset;
        document.querySelectorAll('#zeitraumPills .pill').forEach(x => x.classList.remove('active'));
        document.querySelector('#zeitraumPills .pill[data-value="all"]')?.classList.add('active');
        ['gewaesser', 'koeder', 'mondphase', 'wetter', 'druckTrend', 'wind'].forEach(id => {
          const sel = document.getElementById(id) as HTMLSelectElement;
          if (sel) sel.value = '';
        });
        document.querySelectorAll('#fischartPills .pill').forEach(x => x.classList.remove('active'));
        document.querySelector('#fischartPills .pill[data-value=""]')?.classList.add('active');
        if (preset === 'vollmond') (document.getElementById('mondphase') as HTMLSelectElement).value = 'Vollmond';
        else if (preset === 'neumond') (document.getElementById('mondphase') as HTMLSelectElement).value = 'Neumond';
        else if (preset === 'regen') (document.getElementById('wetter') as HTMLSelectElement).value = 'Regen';
        else if (preset === 'wind') (document.getElementById('wind') as HTMLSelectElement).value = 'stark';
