---
import Layout from "../layouts/Layout.astro";
import { createServerClient } from "@supabase/ssr";

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const header = Astro.request.headers.get("cookie");
        if (!header) return [];
        return header
          .split(";")
          .map((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return null;
            return {
              name: pair.slice(0, idx).trim(),
              value: pair.slice(idx + 1).trim(),
            };
          })
          .filter(Boolean) as { name: string; value: string }[];
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          Astro.cookies.set(name, value, options);
        });
      },
    },
  }
);

const { data: { session } } = await supabase.auth.getSession();

let isPro = false;
let role = "USER";
let displayName = "";

if (session) {
  const { data: profile } = await supabase
    .from("profiles")
    .select("is_pro, role, display_name")
    .eq("id", session.user.id)
    .single();

  if (profile) {
    isPro = profile.is_pro ?? false;
    role = profile.role ?? "USER";
    displayName = profile.display_name ?? "";
  }
}

const isAdmin = role === "ADMIN";
const isPaid = isPro || isAdmin;

const statusLabel = isAdmin ? "ADMIN" : isPro ? "PRO" : "FREE";
const statusColor = isAdmin
  ? "bg-tertiary text-on-tertiary"
  : isPro
    ? "bg-primary text-on-primary"
    : "bg-surface-container-highest text-on-surface-variant";

const features = [
  { name: "KI-ANGELASSISTENT", desc: "Intelligente Fangberatung basierend auf deinen Daten.", pro: true },
  { name: "MARKTPLATZ", desc: "Ausrüstung kaufen und verkaufen in der Community.", pro: true },
  { name: "ERWEITERTE STATISTIK", desc: "Detaillierte Auswertungen, Trends und Gewässeranalysen.", pro: true },
];
---

<Layout title="Carp24 – Premium" active="preis">
  <main class="flex-grow flex flex-col items-center px-margin-mobile md:px-margin-desktop py-xl max-w-7xl mx-auto w-full">
    <div class="text-center mb-xl">
      <h1 class="text-display-lg text-on-surface mb-lg">PREMIUM</h1>
      <div class="flex items-center justify-center gap-3">
        <span class:list={["inline-block px-4 py-1 rounded-full font-label-sm text-label-sm uppercase tracking-widest", statusColor]}>
          {statusLabel}
        </span>
        {session && displayName && (
          <span class="text-body-md text-on-surface-variant">{displayName}</span>
        )}
      </div>
      {isAdmin && (
        <p class="text-body-md text-tertiary mt-sm">Alle Funktionen freigeschaltet</p>
      )}
    </div>

    {!session && (
      <div class="mb-xl text-center">
        <p class="text-body-lg text-on-surface-variant mb-md">Melde dich an, um deinen Status zu sehen.</p>
        <a href="/login" class="inline-block px-8 py-3 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-primary bg-primary hover:bg-primary-container transition-colors min-h-12">
          Anmelden
        </a>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter w-full max-w-5xl mb-xl">
      {features.map((f) => {
        const unlocked = !f.pro || isPaid;
        return (
          <div class:list={[
            "rounded-2xl p-lg flex flex-col border transition-opacity",
            unlocked
              ? "bg-surface-container-high border-primary/40"
              : "bg-surface-container-high border-outline/20 opacity-80",
          ]}>
            <div class="flex items-center gap-2 mb-md">
              {unlocked ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                  <path d="M5 12l5 5L20 7"/>
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              )}
              <h3 class="text-headline-sm text-on-surface">{f.name}</h3>
            </div>
            <p class="text-body-md text-on-surface-variant flex-grow">{f.desc}</p>
            {!unlocked && (
              <p class="text-label-sm text-primary font-label-sm uppercase tracking-widest mt-md">Mit Premium freischalten</p>
            )}
          </div>
        );
      })}
    </div>

    {session && !isPaid && (
      <div class="text-center">
        <button type="button" id="stripe-checkout" class="inline-block px-10 py-4 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-primary bg-primary hover:bg-primary-container transition-colors cursor-pointer min-h-12">
          JETZT UPGRADEN
        </button>
        <p class="text-body-sm text-on-surface-variant mt-sm">Sichere dir Zugang zu allen Premium-Funktionen.</p>
        <p id="stripe-error" class="text-body-sm text-error mt-sm hidden"></p>
      </div>
    )}

    {session && isPaid && (
      <div class="text-center">
        <span class="inline-block px-10 py-4 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-primary bg-primary min-h-12 flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
          Du bist Premium
        </span>
      </div>
    )}

    {!session && (
      <div class="text-center">
        <button type="button" disabled class="inline-block px-10 py-4 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant bg-surface-container-highest border border-outline/20 cursor-not-allowed opacity-70 min-h-12">
          Upgrade kommt bald
        </button>
        <p class="text-body-sm text-on-surface-variant mt-sm">Melde dich an, um Premium freizuschalten.</p>
      </div>
    )}
  </main>

  <script>
    const btn = document.getElementById("stripe-checkout");
    const errEl = document.getElementById("stripe-error");

    btn?.addEventListener("click", async () => {
      if (!(btn instanceof HTMLButtonElement)) return;
      btn.disabled = true;
      btn.textContent = "Wird geladen…";
      errEl?.classList.add("hidden");

      try {
        const res = await fetch("/api/stripe/checkout", { method: "POST" });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "Fehler beim Erstellen der Checkout-Session.");
        }

        if (data.url) {
          window.location.href = data.url;
        }
      } catch (e) {
        const msg = e instanceof Error ? e.message : "Unbekannter Fehler.";
        if (errEl) {
          errEl.textContent = msg;
          errEl.classList.remove("hidden");
        }
        btn.disabled = false;
        btn.textContent = "JETZT UPGRADEN";
      }
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get("status") === "success") {
      const box = document.createElement("div");
      box.className = "fixed top-4 left-1/2 -translate-x-1/2 bg-primary text-on-primary px-6 py-3 rounded-full font-label-sm text-label-sm uppercase tracking-widest shadow-lg z-50";
      box.textContent = "Abo erfolgreich aktiviert!";
      document.body.appendChild(box);
      setTimeout(() => box.remove(), 4000);
    }
  </script>
</Layout>
