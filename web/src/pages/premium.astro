---
import Layout from "../layouts/Layout.astro";
import { createSSRClient, createServiceClient } from "../lib/ssr-client";
import { t } from "../lib/i18n";

const supabase = createSSRClient(Astro);

const { data: { session } } = await supabase.auth.getSession();

let isPro = false;
let role = "USER";
let displayName = "";

if (session) {
  // display_name via authenticated client (safe column)
  const { data: safeProfile } = await supabase
    .from("profiles")
    .select("display_name")
    .eq("id", session.user.id)
    .single();
  if (safeProfile) displayName = safeProfile.display_name ?? "";

  // is_pro/role via service role (sensible columns, RLS-geschützt)
  const adminSb = createServiceClient();
  const { data: profile } = await adminSb
    .from("profiles")
    .select("is_pro, role")
    .eq("id", session.user.id)
    .single();

  if (profile) {
    isPro = profile.is_pro ?? false;
    role = profile.role ?? "USER";
  }
}

const isAdmin = role === "ADMIN";
const isPaid = isPro || isAdmin;

const statusLabel = isAdmin ? "ADMIN" : isPro ? "PRO" : "FREE";
const statusColor = isAdmin
  ? "bg-tertiary text-on-tertiary"
  : isPro
    ? "bg-primary text-on-primary"
    : "bg-surface-container-highest text-on-surface-variant";

const features = [
  { nameKey: "premium.ki", descKey: "premium.ki_desc", pro: true },
  { nameKey: "premium.marktplatz", descKey: "premium.marktplatz_desc", pro: true },
  { nameKey: "premium.stats", descKey: "premium.stats_desc", pro: true },
];
---

<Layout title="Carp24 – Premium" active="preis">
  <main class="flex-grow flex flex-col items-center px-margin-mobile md:px-margin-desktop py-xl max-w-7xl mx-auto w-full">
    <div class="text-center mb-xl">
      <h1 class="text-display-lg text-primary mb-lg i18n" data-de={t("premium.titel", "de")} data-en={t("premium.titel", "en")}>{t("premium.titel")}</h1>
      <div class="flex items-center justify-center gap-3">
        <span class:list={["inline-block px-4 py-1 rounded-full font-label-sm text-label-sm uppercase tracking-widest", statusColor]}>
          <span class="i18n" data-de={t("premium.status_" + statusLabel.toLowerCase(), "de")} data-en={t("premium.status_" + statusLabel.toLowerCase(), "en")}>{t("premium.status_" + statusLabel.toLowerCase())}</span>
        </span>
        {session && displayName && (
          <span class="text-body-md text-on-surface-variant">{displayName}</span>
        )}
      </div>
      {isAdmin && (
        <p class="text-body-md text-tertiary mt-sm i18n" data-de={t("premium.alle_funktionen", "de")} data-en={t("premium.alle_funktionen", "en")}>{t("premium.alle_funktionen")}</p>
      )}
    </div>

    {!session && (
      <div class="mb-xl text-center">
        <p class="text-body-lg text-on-surface-variant mb-md i18n" data-de={t("premium.anmelden_status", "de")} data-en={t("premium.anmelden_status", "en")}>{t("premium.anmelden_status")}</p>
        <a href="/login" class="inline-block px-8 py-3 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-primary bg-primary hover:bg-primary-container transition-colors min-h-12 i18n" data-de={t("premium.anmelden", "de")} data-en={t("premium.anmelden", "en")}>
          {t("premium.anmelden")}
        </a>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter w-full max-w-5xl mb-xl">
      {features.map((f) => {
        const unlocked = !f.pro || isPaid;
        return (
          <div class:list={[
            "rounded-2xl p-lg flex flex-col border transition-opacity",
            unlocked
              ? "bg-surface-container-high border-primary/40"
              : "bg-surface-container-high border-outline/20 opacity-80",
          ]}>
            <div class="flex items-center gap-2 mb-md">
              {unlocked ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                  <path d="M5 12l5 5L20 7"/>
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              )}
              <h3 class="text-headline-sm text-on-surface i18n" data-de={t(f.nameKey, "de")} data-en={t(f.nameKey, "en")}>{t(f.nameKey)}</h3>
            </div>
            <p class="text-body-md text-on-surface-variant flex-grow i18n" data-de={t(f.descKey, "de")} data-en={t(f.descKey, "en")}>{t(f.descKey)}</p>
            {!unlocked && (
              <p class="text-label-sm text-primary font-label-sm uppercase tracking-widest mt-md i18n" data-de={t("premium.mit_premium", "de")} data-en={t("premium.mit_premium", "en")}>{t("premium.mit_premium")}</p>
            )}
          </div>
        );
      })}
    </div>

    <section class="w-full max-w-5xl mb-xl">
      <h2 class="text-headline-sm text-on-surface text-center mb-lg i18n" data-de={t("premium.vgl_titel", "de")} data-en={t("premium.vgl_titel", "en")}>{t("premium.vgl_titel")}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
        <div class="rounded-2xl p-lg bg-surface-container-high border border-outline/20 flex flex-col">
          <div class="flex items-center gap-2 mb-sm">
            <h3 class="text-headline-sm text-on-surface i18n" data-de={t("premium.free", "de")} data-en={t("premium.free", "en")}>{t("premium.free")}</h3>
          </div>
          <p class="text-display-sm text-primary font-label-sm mb-xs i18n" data-de={t("premium.free_preis", "de")} data-en={t("premium.free_preis", "en")}>{t("premium.free_preis")}</p>
          <p class="text-body-md text-on-surface-variant mb-md i18n" data-de={t("premium.free_desc", "de")} data-en={t("premium.free_desc", "en")}>{t("premium.free_desc")}</p>
          <ul class="flex flex-col gap-2 mb-md flex-grow">
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_faenge", "de")} data-en={t("premium.vgl_faenge", "en")}>{t("premium.vgl_faenge")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_board", "de")} data-en={t("premium.vgl_board", "en")}>{t("premium.vgl_board")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_chat", "de")} data-en={t("premium.vgl_chat", "en")}>{t("premium.vgl_chat")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface-variant">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant shrink-0" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              <span class="i18n" data-de={t("premium.vgl_ki", "de")} data-en={t("premium.vgl_ki", "en")}>{t("premium.vgl_ki")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface-variant">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant shrink-0" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              <span class="i18n" data-de={t("premium.vgl_marktplatz", "de")} data-en={t("premium.vgl_marktplatz", "en")}>{t("premium.vgl_marktplatz")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface-variant">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant shrink-0" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              <span class="i18n" data-de={t("premium.vgl_stats", "de")} data-en={t("premium.vgl_stats", "en")}>{t("premium.vgl_stats")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface-variant">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant shrink-0" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              <span class="i18n" data-de={t("premium.vgl_export", "de")} data-en={t("premium.vgl_export", "en")}>{t("premium.vgl_export")}</span>
            </li>
          </ul>
          <div class="text-center">
            <span class="inline-block px-6 py-3 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant bg-surface-container-highest border border-outline/20 min-h-12 flex items-center justify-center i18n" data-de={t("premium.free", "de")} data-en={t("premium.free", "en")}>{t("premium.free")}</span>
          </div>
        </div>

        <div class:list={["rounded-2xl p-lg bg-surface-container-high border flex flex-col", isPaid ? "border-outline/20" : "border-primary/40"]}>
          <div class="flex items-center gap-2 mb-sm">
            <h3 class="text-headline-sm text-primary i18n" data-de={t("premium.status_pro", "de")} data-en={t("premium.status_pro", "en")}>{t("premium.status_pro")}</h3>
          </div>
          <p class="text-display-sm text-primary font-label-sm mb-xs whitespace-nowrap i18n" data-de={t("premium.pro_preis", "de")} data-en={t("premium.pro_preis", "en")}>{t("premium.pro_preis")}</p>
          <p class="text-body-md text-on-surface-variant mb-md i18n" data-de={t("premium.pro_desc", "de")} data-en={t("premium.pro_desc", "en")}>{t("premium.pro_desc")}</p>
          <ul class="flex flex-col gap-2 mb-md flex-grow">
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_faenge", "de")} data-en={t("premium.vgl_faenge", "en")}>{t("premium.vgl_faenge")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_board", "de")} data-en={t("premium.vgl_board", "en")}>{t("premium.vgl_board")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_chat", "de")} data-en={t("premium.vgl_chat", "en")}>{t("premium.vgl_chat")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_ki", "de")} data-en={t("premium.vgl_ki", "en")}>{t("premium.vgl_ki")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_marktplatz", "de")} data-en={t("premium.vgl_marktplatz", "en")}>{t("premium.vgl_marktplatz")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_stats", "de")} data-en={t("premium.vgl_stats", "en")}>{t("premium.vgl_stats")}</span>
            </li>
            <li class="flex items-center gap-2 text-body-md text-on-surface">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span class="i18n" data-de={t("premium.vgl_export", "de")} data-en={t("premium.vgl_export", "en")}>{t("premium.vgl_export")}</span>
            </li>
          </ul>
          <div class="text-center">
            {session && !isPaid ? (
              <button type="button" data-checkout="true" class="inline-block px-6 py-3 rounded-full bg-primary-container hover:bg-primary text-on-primary-container font-label-sm text-label-sm uppercase tracking-widest transition-colors cursor-pointer min-h-12 w-full i18n" data-de={t("premium.jetzt_buchen", "de")} data-en={t("premium.jetzt_buchen", "en")}>
                {t("premium.jetzt_buchen")}
              </button>
            ) : session && isPaid ? (
              <span class="inline-block px-6 py-3 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-primary bg-primary min-h-12 w-full flex items-center justify-center gap-2 i18n" data-de={t("premium.du_bist_premium", "de")} data-en={t("premium.du_bist_premium", "en")}>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                {t("premium.du_bist_premium")}
              </span>
            ) : (
              <a href="/login" class="inline-block px-6 py-3 rounded-full bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm uppercase tracking-widest transition-colors min-h-12 w-full flex items-center justify-center i18n" data-de={t("premium.anmelden", "de")} data-en={t("premium.anmelden", "en")}>
                {t("premium.anmelden")}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    {session && !isPaid && (
      <div class="text-center">
        <button type="button" id="stripe-checkout" class="inline-block px-10 py-4 rounded-full bg-primary-container hover:bg-primary text-on-primary-container font-nav-item text-nav-item uppercase tracking-widest transition-colors cursor-pointer min-h-12 i18n" data-de={t("premium.upgrade", "de")} data-en={t("premium.upgrade", "en")}>
          {t("premium.upgrade")}
        </button>
        <p class="text-body-sm text-on-surface-variant mt-sm i18n" data-de={t("premium.sicher_dir", "de")} data-en={t("premium.sicher_dir", "en")}>{t("premium.sicher_dir")}</p>
        <p id="stripe-error" class="text-body-sm text-error mt-sm hidden"></p>
      </div>
    )}

    {session && isPaid && (
      <div class="text-center">
        <div class="flex items-center justify-center gap-4 flex-wrap">
          <span class="inline-block px-10 py-4 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-primary bg-primary min-h-12 flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
            <span class="i18n" data-de={t("premium.du_bist_premium", "de")} data-en={t("premium.du_bist_premium", "en")}>{t("premium.du_bist_premium")}</span>
          </span>
          <button type="button" id="stripe-portal" class="inline-block px-6 py-3 rounded-full bg-surface-container-highest hover:bg-surface-container-high text-on-surface border border-outline/20 font-label-sm text-label-sm uppercase tracking-widest transition-colors cursor-pointer min-h-12">
            Billing verwalten
          </button>
        </div>
        <p id="portal-error" class="text-body-sm text-error mt-sm hidden"></p>
      </div>
    )}

    {!session && (
      <div class="text-center">
        <button type="button" disabled class="inline-block px-10 py-4 rounded-full font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant bg-surface-container-highest border border-outline/20 cursor-not-allowed opacity-70 min-h-12 i18n" data-de={t("premium.bald", "de")} data-en={t("premium.bald", "en")}>
          {t("premium.bald")}
        </button>
        <p class="text-body-sm text-on-surface-variant mt-sm i18n" data-de={t("premium.anmelden_premium", "de")} data-en={t("premium.anmelden_premium", "en")}>{t("premium.anmelden_premium")}</p>
      </div>
    )}
  </main>

  <script>
    const errEl = document.getElementById("stripe-error");
    const portalBtn = document.getElementById("stripe-portal");
    const portalErrEl = document.getElementById("portal-error");

    const checkoutButtons = Array.from(
      document.querySelectorAll<HTMLElement>("#stripe-checkout, [data-checkout='true']")
    );

    const startCheckout = async (btn: HTMLButtonElement) => {
      btn.disabled = true;
      const orig = btn.dataset.de ?? btn.textContent ?? "";
      btn.textContent = "Wird geladen…";
      errEl?.classList.add("hidden");

      try {
        const res = await fetch("/api/stripe/checkout", { method: "POST" });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "Fehler beim Erstellen der Checkout-Session.");
        }

        if (data.url) {
          window.location.href = data.url;
        }
      } catch (e) {
        const msg = e instanceof Error ? e.message : "Unbekannter Fehler.";
        if (errEl) {
          errEl.textContent = msg;
          errEl.classList.remove("hidden");
        }
        btn.disabled = false;
        btn.textContent = orig;
      }
    };

    checkoutButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn instanceof HTMLButtonElement) startCheckout(btn);
      });
    });

    portalBtn?.addEventListener("click", async () => {
      if (!(portalBtn instanceof HTMLButtonElement)) return;
      portalBtn.disabled = true;
      portalBtn.textContent = "Wird geladen…";
      portalErrEl?.classList.add("hidden");

      try {
        const res = await fetch("/api/stripe/portal", { method: "POST" });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "Fehler beim Öffnen des Billing-Portals.");
        }

        if (data.url) {
          window.location.href = data.url;
        }
      } catch (e) {
        const msg = e instanceof Error ? e.message : "Unbekannter Fehler.";
        if (portalErrEl) {
          portalErrEl.textContent = msg;
          portalErrEl.classList.remove("hidden");
        }
        portalBtn.disabled = false;
        portalBtn.textContent = "BILLING VERWALTEN";
      }
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get("status") === "success") {
      const box = document.createElement("div");
      box.className = "fixed top-4 left-1/2 -translate-x-1/2 bg-primary text-on-primary px-6 py-3 rounded-full font-label-sm text-label-sm uppercase tracking-widest shadow-lg z-50";
      box.textContent = "Abo erfolgreich aktiviert!";
      document.body.appendChild(box);
      setTimeout(() => box.remove(), 4000);
    }
  </script>
</Layout>
