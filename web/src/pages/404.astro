---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carp24 – Seite nicht gefunden" description="Diese Seite gibt es bei Carp24 nicht – zurück zum Fangbuch geht es hier.">
  <main class="flex flex-col items-center justify-center text-center py-24 px-4">
    <div class="text-[120px] font-bold text-primary leading-none mb-4">404</div>
    <h1 class="text-headline-lg text-on-surface mb-4 i18n" data-de="SEITE NICHT GEFUNDEN" data-en="PAGE NOT FOUND">SEITE NICHT GEFUNDEN</h1>
    <p class="text-body-lg text-on-surface-variant max-w-md mb-8 i18n" data-de="Die Seite existiert nicht oder wurde verschoben." data-en="The page does not exist or has been moved.">Die Seite existiert nicht oder wurde verschoben.</p>
    <div class="w-32 h-32 rounded-full border-2 border-primary/40 flex items-center justify-center mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#7B9496" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="7"></line>
  <path d="M12 7v3.5a2 2 0 0 0 2 2 2 2 0 0 0 2-2v-1.5l-1 .8"></path>
  <path d="M12 11.5c-3 1.5-4 5-3.5 8.5 2 1.5 5 1.5 7 0 .5-3.5-.5-7-3.5-8.5z"></path>
  <path d="M10.5 20l-2.5 3h8l-2.5-3"></path>
  <path d="M15.5 14c1 .5 1.8 1.8 1.8 3"></path>
  <path d="M10.5 14.5c.8.8 1.2 1.8 1 2.8"></path>
  <circle cx="11.2" cy="13" fill="currentColor" r="0.5"></circle></svg>
    </div>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/faenge/" class="bg-primary text-white font-nav-item text-nav-item uppercase tracking-widest rounded-full px-8 py-4 min-h-12 flex items-center justify-center i18n" data-de="ZUM FANGBUCH" data-en="TO CATCH LOG">ZUM FANGBUCH</a>
      <a href="/" class="border border-primary/40 text-on-surface font-nav-item text-nav-item uppercase tracking-widest rounded-full px-8 py-4 min-h-12 flex items-center justify-center i18n" data-de="STARTSEITE" data-en="HOME">STARTSEITE</a>
    </div>
  </main>
</Layout>
