---
import Layout from "../layouts/Layout.astro";
import img1 from "../assets/stitch/catch-list-0.jpg?url";
import img2 from "../assets/stitch/catch-list-1.jpg?url";
import img3 from "../assets/stitch/onboarding-2.jpg?url";

const catches = [
  {
    id: "silbersee-spiegelkarpfen",
    art: "Spiegelkarpfen",
    gewicht: "18,4 KG",
    gewaesser: "Silbersee",
    datum: "12. OKT 2025",
    tags: [{ t: "Boilie", c: "tertiary" }, { t: "Nebel", c: "secondary" }], img: img1,
  },
  {
    id: "linch-hill-schuppenkarpfen",
    art: "Schuppenkarpfen",
    gewicht: "14,2 KG",
    gewaesser: "Linch Hill",
    datum: "28. SEP 2025",
    tags: [{ t: "Tigernuss", c: "tertiary" }, { t: "Klar", c: "secondary" }], img: img2,
  },
  {
    id: "silbersee-graskarpfen",
    art: "Graskarpfen",
    gewicht: "21,0 KG",
    gewaesser: "Silbersee",
    datum: "15. SEP 2025",
    tags: [{ t: "Pop-Up", c: "tertiary" }, { t: "Regen", c: "secondary" }], img: img3,
  },
];

const tagClasses: Record<string, string> = {
  tertiary: "bg-tertiary/10 text-tertiary",
  secondary: "bg-secondary/10 text-secondary",
};
---

<Layout title="Carp24 – Fangbuch" active="fangbuch">
  <main class="flex-grow w-full max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-xl flex flex-col gap-xl">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-md">
      <div>
        <h1 class="text-display-lg text-on-surface mb-2">FANGBUCH</h1>
        <p class="font-nav-item text-nav-item text-secondary uppercase tracking-widest">72 FÄNGE GESAMT</p>
      </div>
      <a href="/fang-erfassen" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm flex items-center gap-2 min-h-12">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        NEUER FANG
      </a>
    </div>

    <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col lg:flex-row gap-md items-end">
      <div class="w-full lg:w-1/4 flex flex-col gap-2">
        <label class="font-label-sm text-label-sm uppercase text-secondary" for="search">Suche</label>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary/60" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="search" type="text" placeholder="Nach Datum, Ort..." class="w-full bg-surface-container-lowest border border-primary/20 rounded-md py-2 pl-10 pr-3 text-body-md text-on-surface placeholder:text-on-surface-variant min-h-11" />
        </div>
      </div>
      <div class="w-full lg:w-1/4 flex flex-col gap-2">
        <label class="font-label-sm text-label-sm uppercase text-secondary" for="filter-art">Art</label>
        <select id="filter-art" class="w-full bg-surface-container-lowest border border-primary/20 rounded-md py-2 px-3 text-body-md text-on-surface appearance-none min-h-11">
          <option>Alle Arten</option>
          <option>Spiegelkarpfen</option>
          <option>Schuppenkarpfen</option>
          <option>Graskarpfen</option>
        </select>
      </div>
      <div class="w-full lg:w-1/4 flex flex-col gap-2">
        <label class="font-label-sm text-label-sm uppercase text-secondary" for="filter-gewaesser">Gewässer</label>
        <select id="filter-gewaesser" class="w-full bg-surface-container-lowest border border-primary/20 rounded-md py-2 px-3 text-body-md text-on-surface appearance-none min-h-11">
          <option>Alle Gewässer</option>
          <option>Silbersee</option>
          <option>Linch Hill</option>
          <option>Vereinssee</option>
        </select>
      </div>
      <div class="w-full lg:w-1/4 flex flex-col gap-2">
        <span class="font-label-sm text-label-sm uppercase text-secondary">Sortierung</span>
        <div class="w-full bg-surface-container-lowest border border-primary/20 rounded-md flex overflow-hidden p-1 min-h-11">
          <button type="button" class="flex-1 py-1.5 px-3 bg-surface-container-high text-secondary rounded font-nav-item text-nav-item">Datum</button>
          <button type="button" class="flex-1 py-1.5 px-3 text-on-surface-variant hover:text-secondary rounded font-nav-item text-nav-item transition-colors">Gewicht</button>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-0 bg-transparent">
      <div class="hidden md:flex items-center px-lg py-4 border-b border-primary/20 text-secondary font-label-sm text-label-sm uppercase tracking-widest">
        <div class="w-16 mr-6"></div>
        <div class="flex-1">Art &amp; Details</div>
        <div class="w-32 text-right">Gewicht</div>
        <div class="w-40 text-right">Gewässer</div>
        <div class="w-32 text-right">Datum</div>
      </div>

      {catches.map((c) => (
        <a href={`/faenge/${c.id}`} class="flex flex-col md:flex-row items-start md:items-center p-lg border-b border-primary/20 hover:bg-surface-container-high/50 transition-colors group">
          <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0 mr-0 md:mr-6 mb-4 md:mb-0 border border-primary/20 relative bg-surface-container-high">
            <img src={c.img} alt={`Fang ${c.art}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="flex-1 w-full flex flex-col md:flex-row md:items-center justify-between gap-4 md:gap-0">
            <div class="flex flex-col">
              <span class="text-headline-md text-on-surface mb-1">{c.art}</span>
              <div class="flex items-center gap-2 flex-wrap">
                {c.tags.map((tag) => (
                  <span class:list={["font-label-sm text-label-sm px-2 py-0.5 rounded-full uppercase", tagClasses[tag.c]]}>{tag.t}</span>
                ))}
              </div>
            </div>
            <div class="w-full md:w-auto flex md:contents border-t border-primary/10 md:border-none pt-4 md:pt-0 mt-4 md:mt-0">
              <div class="flex-1 md:w-32 md:text-right font-nav-item text-nav-item text-secondary">
                <span class="md:hidden text-on-surface-variant block mb-1">Gewicht</span>
                {c.gewicht}
              </div>
              <div class="flex-1 md:w-40 md:text-right font-nav-item text-nav-item text-tertiary">
                <span class="md:hidden text-on-surface-variant block mb-1">Gewässer</span>
                {c.gewaesser}
              </div>
              <div class="flex-1 md:w-32 md:text-right font-nav-item text-nav-item text-on-surface/80">
                <span class="md:hidden text-on-surface-variant block mb-1">Datum</span>
                {c.datum}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="flex justify-center mt-4">
      <button type="button" class="font-nav-item text-nav-item uppercase tracking-widest text-secondary hover:text-primary transition-colors flex items-center gap-2 min-h-11">
        Weitere laden
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>
  </main>
</Layout>
