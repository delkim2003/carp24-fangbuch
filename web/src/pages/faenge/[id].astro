---
import Layout from "../../layouts/Layout.astro";
import { createSSRClient, createServiceClient } from "../../lib/ssr-client";

const supabase = createSSRClient(Astro);
const adminClient = createServiceClient();

// SSR: Fang-Detail ist user-abhängig (Session), nicht vorab generierbar
export const prerender = false;

const id = Astro.params.id ?? "";
const { data: { session } } = await supabase.auth.getSession();
let catchData: any = null;
let notFound = false;
if (session) {
  const { data, error } = await supabase.from("catches").select("*").eq("id", id).is("deleted_at", null).single();
  catchData = data ?? null;
  if (error || !data) notFound = true;
}
let signedPhotoUrl: string | null = null;
if (catchData && Array.isArray(catchData.photos) && catchData.photos[0]) {
  const photoRef = catchData.photos[0] as string;
  if (photoRef.startsWith("foto:")) {
    const { data: signedData } = await adminClient.storage.from("catch-photos").createSignedUrl(photoRef.slice(5), 3600);
    // Rewrite signed URL to use Astro proxy (browser can't reach Supabase directly)
    signedPhotoUrl = signedData?.signedUrl ? signedData.signedUrl.replace(process.env.PUBLIC_SUPABASE_URL || 'http://supabase-kong:8000', '/supabase') : null;
  } else if (photoRef.startsWith("http")) {
    signedPhotoUrl = photoRef;
  }
}
const speciesMap: Record<string, string> = { SPIEGEL: "Spiegelkarpfen", LEDER: "Lederkarpfen", SCHUPPEN: "Schuppenkarpfen", AMUR: "Amurkarpfen", ANDERE: "Andere" };
---
<Layout title={`Carp24 – ${catchData ? "Fang-Detail" : "Nicht gefunden"}`} active="fangbuch">
  <main class="flex-grow w-full max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-xl flex flex-col gap-xl">
    {!session ? (
      <div class="text-center py-24">
        <p class="text-body-lg text-on-surface-variant mb-8">Melde dich an, um Fänge zu sehen.</p>
        <a href="/login" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase px-6 py-3 rounded-full min-h-12">ANMELDEN</a>
      </div>
    ) : notFound ? (
      <div class="text-center py-24 flex flex-col items-center gap-lg">
        <h1 class="text-display-lg text-primary">FANG NICHT GEFUNDEN</h1>
        <p class="text-body-lg text-on-surface-variant">Dieser Fang existiert nicht oder wurde gelöscht.</p>
        <a href="/faenge" class="bg-primary text-on-primary font-nav-item text-nav-item uppercase px-6 py-3 rounded-full min-h-12">ZUR FANGLISTE</a>
      </div>
    ) : catchData ? (
      <>
        <a href="/faenge" class="inline-flex items-center font-nav-item text-nav-item uppercase text-primary tracking-widest hover:opacity-80 transition-opacity"><svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19L5 12M12 5L5 12"/></svg> ZURÜCK</a>
        <div class="bg-surface-container-high rounded-xl border border-primary/40 overflow-hidden">
          {signedPhotoUrl && <img src={signedPhotoUrl} alt="Fang" loading="lazy" class="w-full max-h-96 object-cover" />}
          <div class="p-xl flex flex-col gap-lg">
            <div class="font-mono text-display-xl text-primary font-bold">{(Number(catchData.weight_kg) ?? 0).toLocaleString("de-DE", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} KG</div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-md">
              <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">ART</div><div class="font-headline-md text-headline-md text-on-surface">{speciesMap[catchData.species] ?? catchData.species}</div></div>
              <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">GEWÄSSER</div><div class="font-headline-md text-headline-md text-on-surface">{catchData.water_name ?? "—"}</div></div>
              <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">DATUM</div><div class="font-headline-md text-headline-md text-on-surface">{new Date(catchData.catch_ts).toLocaleDateString("de-DE", { day: "2-digit", month: "long", year: "numeric" })}</div></div>
              {catchData.length_cm && <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">LÄNGE</div><div class="font-headline-md text-headline-md text-on-surface">{catchData.length_cm} cm</div></div>}
              {catchData.bait && <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">KÖDER</div><div class="font-headline-md text-headline-md text-on-surface">{catchData.bait}</div></div>}
              {catchData.method && <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">METHODE</div><div class="font-headline-md text-headline-md text-on-surface">{catchData.method}</div></div>}
            </div>
            {catchData.notes && <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest mb-1">NOTIZEN</div><div class="text-body-md text-on-surface-variant">{catchData.notes}</div></div>}
            <div class="bg-surface-container rounded-xl border border-primary/30 p-lg">
              <div class="font-label-sm text-label-sm uppercase text-primary mb-md">WETTER & BEDINGUNGEN</div>
              {catchData.weather && Object.keys(catchData.weather).length > 0 ? (
                <div class="grid grid-cols-2 md:grid-cols-4 gap-md">
                  <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">TEMPERATUR</div><div class="font-mono text-body-lg">{catchData.weather.temp_c != null ? catchData.weather.temp_c + " °C" : "—"}</div></div>
                  <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">LUFTDRUCK</div><div class="font-mono text-body-lg">{catchData.weather.pressure_hpa != null ? catchData.weather.pressure_hpa + " hPa" : "—"}</div></div>
                  <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">WIND</div><div class="font-mono text-body-lg">{catchData.weather.wind_speed_kmh != null ? catchData.weather.wind_speed_kmh + " km/h" : "—"}</div></div>
                  <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">WETTER</div><div class="font-mono text-body-lg">{catchData.weather.weather_text ?? "—"}</div></div>
                  <div><div class="font-mono text-xs uppercase text-primary/70 tracking-widest">MOND</div><div class="font-mono text-body-lg">{catchData.weather.moon_text ?? "—"}</div></div>
                </div>
              ) : (
                <p class="text-body-md text-on-surface-variant italic">Wetterdaten für diesen Fang nicht verfügbar.</p>
              )}
              <div class="border-t border-primary/20 mt-md pt-md" data-testid="water-temp-display">
                <div class="font-mono text-xs uppercase text-primary/70 tracking-widest">WASSERTEMPERATUR</div>
                <div class="font-mono text-body-lg">{catchData.water_temp_c != null ? catchData.water_temp_c + " °C" : "—"}</div>
              </div>
            </div>
          </div>
        </div>
      </>
    ) : null}
  </main>
</Layout>