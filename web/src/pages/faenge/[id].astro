---
import Layout from "../../layouts/Layout.astro";
import { createServerClient } from "@supabase/ssr";

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const header = Astro.request.headers.get("cookie");
        if (!header) return [];
        return header
          .split(";")
          .map((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return null;
            return {
              name: pair.slice(0, idx).trim(),
              value: pair.slice(idx + 1).trim(),
            };
          })
          .filter(Boolean) as { name: string; value: string }[];
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          Astro.cookies.set(name, value, options);
        });
      },
    },
  }
);

// SSR: Fang-Detail ist user-abhängig (Session), nicht vorab generierbar
export const prerender = false;

const id = Astro.params.id ?? "";
const { data: { session } } = await supabase.auth.getSession();
let catchData: any = null;
let notFound = false;
if (session) {
  const { data, error } = await supabase.from("catches").select("*").eq("id", id).is("deleted_at", null).single();
  catchData = data ?? null;
  if (error || !data) notFound = true;
}
let signedPhotoUrl: string | null = null;
if (catchData && Array.isArray(catchData.photos) && catchData.photos[0]) {
  const photoRef = catchData.photos[0] as string;
  if (photoRef.startsWith("foto:")) {
    const { data: signedData } = await supabase.storage.from("catch-photos").createSignedUrl(photoRef.slice(5), 3600);
    signedPhotoUrl = signedData?.signedUrl ?? null;
  } else if (photoRef.startsWith("http")) {
    signedPhotoUrl = photoRef;
  }
}
const speciesMap: Record<string, string> = { SPIEGEL: "Spiegelkarpfen", LEDER: "Lederkarpfen", SCHUPPEN: "Schuppenkarpfen", AMUR: "Amurkarpfen", ANDERE: "Andere" };
---
<Layout title={`Carp24 – ${catchData ? "Fang-Detail" : "Nicht gefunden"}`} active="fangbuch">
  <main class="flex-grow w-full max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-xl flex flex-col gap-xl">
    {!session ? (
      <div class="text-center py-24">
        <p class="text-body-lg text-on-surface-variant mb-8">Melde dich an, um Fänge zu sehen.</p>
        <a href="/login" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase px-6 py-3 rounded-full min-h-12">ANMELDEN</a>
      </div>
    ) : notFound ? (
      <div class="text-center py-24 flex flex-col items-center gap-lg">
        <h1 class="text-display-lg text-primary">FANG NICHT GEFUNDEN</h1>
        <p class="text-body-lg text-on-surface-variant">Dieser Fang existiert nicht oder wurde gelöscht.</p>
        <a href="/faenge" class="bg-primary text-on-primary font-nav-item text-nav-item uppercase px-6 py-3 rounded-full min-h-12">ZUR FANGLISTE</a>
      </div>
    ) : catchData ? (
      <>
        <a href="/faenge" class="font-nav-item text-nav-item uppercase text-secondary tracking-widest">← ZURÜCK</a>
        <div class="bg-surface-container-high rounded-xl border border-primary/40 overflow-hidden">
          {signedPhotoUrl && <img src={signedPhotoUrl} alt="Fang" class="w-full max-h-96 object-cover" />}
          <div class="p-xl flex flex-col gap-lg">
            <div class="font-mono text-display-xl text-primary font-bold">{(Number(catchData.weight_kg) ?? 0).toLocaleString("de-DE", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} KG</div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-md">
              <div><div class="font-label-sm text-label-sm uppercase text-secondary">ART</div><div class="text-body-lg">{speciesMap[catchData.species] ?? catchData.species}</div></div>
              <div><div class="font-label-sm text-label-sm uppercase text-secondary">GEWÄSSER</div><div class="text-body-lg">{catchData.water_name ?? "—"}</div></div>
              <div><div class="font-label-sm text-label-sm uppercase text-secondary">DATUM</div><div class="text-body-lg">{new Date(catchData.catch_ts).toLocaleDateString("de-DE", { day: "2-digit", month: "long", year: "numeric" })}</div></div>
              {catchData.length_cm && <div><div class="font-label-sm text-label-sm uppercase text-secondary">LÄNGE</div><div class="text-body-lg">{catchData.length_cm} cm</div></div>}
              {catchData.bait && <div><div class="font-label-sm text-label-sm uppercase text-secondary">KÖDER</div><div class="text-body-lg">{catchData.bait}</div></div>}
              {catchData.method && <div><div class="font-label-sm text-label-sm uppercase text-secondary">METHODE</div><div class="text-body-lg">{catchData.method}</div></div>}
            </div>
            {catchData.notes && <div><div class="font-label-sm text-label-sm uppercase text-secondary mb-1">NOTIZEN</div><div class="text-body-md text-on-surface-variant">{catchData.notes}</div></div>}
            {catchData.weather && (
              <div class="bg-surface-container rounded-xl border border-primary/30 p-lg">
                <div class="font-label-sm text-label-sm uppercase text-primary mb-md">WETTER-SNAPSHOT</div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-md">
                  <div><div class="font-label-sm text-label-sm uppercase text-secondary">TEMPERATUR</div><div class="font-mono text-body-lg">{catchData.weather.temp_c != null ? catchData.weather.temp_c + " °C" : "—"}</div></div>
                  <div><div class="font-label-sm text-label-sm uppercase text-secondary">LUFTDRUCK</div><div class="font-mono text-body-lg">{catchData.weather.pressure_hpa != null ? catchData.weather.pressure_hpa + " hPa" : "—"}</div></div>
                  <div><div class="font-label-sm text-label-sm uppercase text-secondary">WIND</div><div class="font-mono text-body-lg">{catchData.weather.wind_kmh != null ? catchData.weather.wind_kmh + " km/h" : "—"}</div></div>
                  <div><div class="font-label-sm text-label-sm uppercase text-secondary">MOND</div><div class="font-mono text-body-lg">{catchData.weather.moon_text ?? "—"}</div></div>
                </div>
              </div>
            )}
          </div>
        </div>
      </>
    ) : null}
  </main>
</Layout>