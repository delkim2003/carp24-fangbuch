---
import Layout from "../layouts/Layout.astro";
import { createServerClient } from "@supabase/ssr";
import { t } from "../lib/i18n";

export const prerender = false;

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const header = Astro.request.headers.get("cookie");
        if (!header) return [];
        return header
          .split(";")
          .map((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return null;
            return {
              name: pair.slice(0, idx).trim(),
              value: pair.slice(idx + 1).trim(),
            };
          })
          .filter(Boolean) as { name: string; value: string }[];
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          Astro.cookies.set(name, value, options);
        });
      },
    },
  }
);

const { data: { session } } = await supabase.auth.getSession();

let threads: any[] = [];
let loadError: string | null = null;
if (session) {
  const { data, error } = await supabase
    .from("forum_threads")
    .select("*, profiles(display_name), forum_posts(count)")
    .order("updated_at", { ascending: false })
    .limit(50);
  threads = data ?? [];
  if (error) loadError = error.message;
}

const threadsJson = JSON.stringify(threads);
const userId = session?.user?.id ?? null;
---
<Layout title="Carp24 – Forum" active="forum">
  <main class="flex-grow w-full max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-xl flex flex-col gap-xl">
    {!session ? (
      <div class="text-center py-24">
        <p class="font-kicker text-kicker uppercase tracking-widest text-secondary mb-2 i18n" data-de={t("kicker", "de")} data-en={t("kicker", "en")}>{t("kicker")}</p>
        <h1 class="text-display-lg text-primary mb-4 i18n" data-de={t("forum.titel", "de")} data-en={t("forum.titel", "en")}>{t("forum.titel")}</h1>
        <p class="text-body-lg text-on-surface-variant mb-8 i18n" data-de={t("forum.anmelden_text", "de")} data-en={t("forum.anmelden_text", "en")}>{t("forum.anmelden_text")}</p>
        <a href="/login" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full min-h-12 i18n" data-de={t("forum.anmelden", "de")} data-en={t("forum.anmelden", "en")}>{t("forum.anmelden")}</a>
      </div>
    ) : (
      <>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-md">
          <div>
            <p class="font-kicker text-kicker uppercase tracking-widest text-secondary mb-2 i18n" data-de={t("kicker", "de")} data-en={t("kicker", "en")}>{t("kicker")}</p>
            <h1 class="text-display-lg text-on-surface mb-2 i18n" data-de={t("forum.titel", "de")} data-en={t("forum.titel", "en")}>{t("forum.titel")}</h1>
            {threads.length > 0 && (
              <p class="font-nav-item text-nav-item text-secondary uppercase tracking-widest"><span class="i18n" data-de={threads.length + " " + t("forum.themen", "de")} data-en={threads.length + " " + t("forum.themen", "en")}>{threads.length} {t("forum.themen")}</span></p>
            )}
          </div>
          <button id="toggle-new-thread" type="button" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full hover:bg-surface-tint transition-colors shadow-sm flex items-center gap-2 min-h-12 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <span class="i18n" data-de={t("forum.neuer_thread", "de")} data-en={t("forum.neuer_thread", "en")}>{t("forum.neuer_thread")}</span>
          </button>
        </div>

        <form id="new-thread-form" class="hidden bg-surface-container-high rounded-xl border border-primary/40 p-lg md:p-xl shadow-sm">
          <h2 class="font-headline-md text-headline-md text-primary mb-lg i18n" data-de={t("forum.neuen_erstellen", "de")} data-en={t("forum.neuen_erstellen", "en")}>{t("forum.neuen_erstellen")}</h2>
          <div class="flex flex-col gap-sm mb-md">
            <label class="font-label-sm text-label-sm uppercase text-secondary i18n" for="thread-title" data-de={t("forum.titel_label", "de")} data-en={t("forum.titel_label", "en")}>{t("forum.titel_label")}<span class="text-primary" aria-hidden="true">*</span></label>
            <input
              class="w-full bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-3 px-4 min-h-12"
              id="thread-title" name="title" type="text" placeholder="Thema des Threads…" required minlength="3" maxlength="120"
            />
          </div>
          <div class="flex flex-col gap-sm mb-lg">
            <label class="font-label-sm text-label-sm uppercase text-secondary i18n" for="thread-body" data-de={t("forum.text_label", "de")} data-en={t("forum.text_label", "en")}>{t("forum.text_label")}<span class="text-primary" aria-hidden="true">*</span></label>
            <textarea
              class="w-full bg-surface-container-lowest rounded border-b border-primary/20 focus:ring-0 focus:border-primary text-body-md py-3 px-4 resize-none min-h-24"
              id="thread-body" name="body" rows="4" maxlength="4000" placeholder="Beschreibe dein Thema…" required
            ></textarea>
          </div>
          <div id="thread-error" class="hidden p-md bg-error-container text-on-error-container rounded-lg text-body-md mb-md" role="alert"></div>
          <div class="flex justify-end gap-sm">
            <button type="button" id="cancel-new-thread" class="font-nav-item text-nav-item uppercase py-3 px-6 rounded-full border border-primary/40 text-on-surface-variant hover:bg-surface-container-high transition-colors min-h-12 cursor-pointer i18n" data-de={t("forum.abbrechen", "de")} data-en={t("forum.abbrechen", "en")}>
              {t("forum.abbrechen")}
            </button>
            <button type="submit" id="thread-submit-btn" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase py-3 px-6 rounded-full hover:bg-surface-tint transition-colors shadow-sm min-h-12 disabled:opacity-50 disabled:cursor-not-allowed i18n" data-de={t("forum.thread_erstellen", "de")} data-en={t("forum.thread_erstellen", "en")}>
              {t("forum.thread_erstellen")}
            </button>
          </div>
        </form>

        {loadError && <div class="text-red-700 bg-red-50 border border-red-200 rounded-lg px-lg py-md">{loadError}</div>}

        <div id="threads-list" class="flex flex-col gap-md">
          {threads.length === 0 ? (
            <div class="text-center py-24 flex flex-col items-center gap-lg">
              <div class="w-32 h-32 rounded-full border-2 border-primary/40 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#7B9496" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <h2 class="text-display-md text-primary i18n" data-de={t("forum.keine_themen", "de")} data-en={t("forum.keine_themen", "en")}>{t("forum.keine_themen")}</h2>
              <p class="text-body-lg text-on-surface-variant max-w-md i18n" data-de={t("forum.starte_erstes", "de")} data-en={t("forum.starte_erstes", "en")}>{t("forum.starte_erstes")}</p>
            </div>
          ) : (
            threads.map((thread: any) => {
              const replyCount = thread.forum_posts?.[0]?.count ?? 0;
              const userName = thread.profiles?.display_name ?? "Anonym";
              const datum = new Date(thread.created_at).toLocaleDateString("de-DE", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase().replace(/\./g, ".");
              return (
                <a href={`/forum/${thread.id}`} class="block bg-surface-container-high rounded-xl border border-primary/40 p-lg hover:bg-surface-container-highest transition-colors shadow-sm">
                  <div class="flex items-start justify-between gap-md">
                    <div class="flex-1 min-w-0">
                      <h3 class="font-headline-md text-headline-md text-primary truncate">{thread.title}</h3>
                      <p class="text-body-md text-on-surface-variant mt-sm line-clamp-2">{thread.body}</p>
                    </div>
                    <div class="flex flex-col items-end gap-sm shrink-0">
                      <span class="font-mono text-body-md text-primary font-bold">{replyCount} {replyCount === 1 ? t("forum.antwort") : t("forum.antworten")}</span>
                      <span class="font-label-sm text-label-sm uppercase text-secondary">{datum}</span>
                    </div>
                  </div>
                  <div class="mt-md pt-md border-t border-primary/10 flex items-center gap-md">
                    <span class="text-body-md text-secondary">von {userName}</span>
                  </div>
                </a>
              );
            })
          )}
        </div>
      </>
    )}
  </main>
</Layout>

<script is:inline define:vars={{ threadsJson, userId }}>
(function () {
  var threads = [];
  try { threads = JSON.parse(threadsJson); } catch (e) { threads = []; }

  var SUPABASE_URL = document.body.dataset.supabaseUrl || "";
  var SUPABASE_ANON_KEY = document.body.dataset.supabaseAnonKey || "";

  function getSupabase() {
    if (window.__supabase) return window.__supabase;
    if (typeof window.supabase !== 'undefined' && window.supabase.createClient) {
      window.__supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true }
      });
      return window.__supabase;
    }
    return null;
  }

  var toggleBtn = document.getElementById('toggle-new-thread');
  var form = document.getElementById('new-thread-form');
  var cancelBtn = document.getElementById('cancel-new-thread');

  if (toggleBtn && form) {
    toggleBtn.addEventListener('click', function () {
      form.classList.toggle('hidden');
      if (!form.classList.contains('hidden')) {
        toggleBtn.textContent = 'ABBRECHEN';
      } else {
        toggleBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> NEUER THREAD';
      }
    });
  }

  if (cancelBtn && form && toggleBtn) {
    cancelBtn.addEventListener('click', function () {
      form.classList.add('hidden');
      toggleBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> NEUER THREAD';
    });
  }

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var errorDiv = document.getElementById('thread-error');
      var submitBtn = document.getElementById('thread-submit-btn');
      errorDiv.classList.add('hidden');

      var title = document.getElementById('thread-title').value.trim();
      var body = document.getElementById('thread-body').value.trim();

      if (title.length < 3) {
        errorDiv.textContent = 'Titel muss mindestens 3 Zeichen lang sein.';
        errorDiv.classList.remove('hidden');
        return;
      }
      if (body.length < 1) {
        errorDiv.textContent = 'Text darf nicht leer sein.';
        errorDiv.classList.remove('hidden');
        return;
      }

      var sb = getSupabase();
      if (!sb) {
        errorDiv.textContent = 'Supabase nicht initialisiert.';
        errorDiv.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'WIRD ERSTELLT…';

      sb.from("forum_threads").insert({
        title: title,
        body: body,
        user_id: userId
      }).select().single().then(function (res) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'THREAD ERSTELLEN';
        if (res.error) {
          errorDiv.textContent = 'Fehler: ' + res.error.message;
          errorDiv.classList.remove('hidden');
        } else {
          window.location.href = '/forum/' + res.data.id;
        }
      });
    });
  }
})();
</script>
