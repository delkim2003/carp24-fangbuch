---
import Layout from "../layouts/Layout.astro";
import { createServerClient } from "@supabase/ssr";
import { t } from "../lib/i18n";

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const header = Astro.request.headers.get("cookie");
        if (!header) return [];
        return header
          .split(";")
          .map((pair) => {
            const idx = pair.indexOf("=");
            if (idx === -1) return null;
            return {
              name: pair.slice(0, idx).trim(),
              value: pair.slice(idx + 1).trim(),
            };
          })
          .filter(Boolean) as { name: string; value: string }[];
      },
      setAll(cookiesToSet) {
        cookiesToSet.forEach(({ name, value, options }) => {
          Astro.cookies.set(name, value, options);
        });
      },
    },
  }
);

const { data: { session } } = await supabase.auth.getSession();

let catches: any[] = [];
let loadError: string | null = null;
if (session) {
  const { data, error } = await supabase.from("catches").select("*").is("deleted_at", null).order("catch_ts", { ascending: false });
  catches = data ?? [];
  if (error) loadError = error.message;
}

const speciesDE: Record<string, string> = {
  SPIEGEL: "Spiegelkarpfen",
  LEDER: "Lederkarpfen",
  SCHUPPEN: "Schuppenkarpfen",
  AMUR: "Amurkarpfen",
  ANDERE: "Andere",
};

const monthNamesDE = ["Jan", "Feb", "Mär", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"];

function fmtWeight(kg: number): string {
  return kg.toLocaleString("de-DE", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
}

function fmtDateShort(ts: string): string {
  const d = new Date(ts);
  const raw = d.toLocaleDateString("de-DE", { day: "2-digit", month: "short" });
  return raw.replace(".", "");
}

const currentYear = new Date().getFullYear();

const total = catches.length;
const heaviest = catches.reduce((max: any, c: any) => {
  const w = Number(c.weight_kg) || 0;
  const mw = Number(max?.weight_kg) || 0;
  return w > mw ? c : max;
}, null);
const thisYear = catches.filter((c: any) => c.catch_ts && new Date(c.catch_ts).getFullYear() === currentYear).length;
const activeWaters = new Set(catches.filter((c: any) => c.water_name).map((c: any) => c.water_name)).size;

const monthlyMap = new Map<number, number>();
catches.forEach((c: any) => {
  if (!c.catch_ts) return;
  const m = new Date(c.catch_ts).getMonth();
  monthlyMap.set(m, (monthlyMap.get(m) || 0) + 1);
});
const monthly = Array.from(monthlyMap.entries())
  .sort((a, b) => a[0] - b[0])
  .map(([month, count]) => ({ month, count }));
const maxCount = monthly.reduce((mx, m) => Math.max(mx, m.count), 0);

const top5 = [...catches]
  .filter((c: any) => Number(c.weight_kg) > 0)
  .sort((a: any, b: any) => Number(b.weight_kg) - Number(a.weight_kg))
  .slice(0, 5);

const trend = [...catches]
  .filter((c: any) => c.catch_ts && Number(c.weight_kg) > 0)
  .sort((a: any, b: any) => new Date(a.catch_ts).getTime() - new Date(b.catch_ts).getTime());

const svgW = 880;
const svgH = 340;
const barPL = 48;
const barPR = 20;
const barPT = 28;
const barPB = 44;
const barPW = svgW - barPL - barPR;
const barPH = svgH - barPT - barPB;

const barSvgParts: string[] = [];
if (monthly.length > 0 && maxCount > 0) {
  const bandW = barPW / monthly.length;
  monthly.forEach((m, i) => {
    const cx = barPL + bandW * i + bandW / 2;
    const bw = bandW * 0.55;
    const h = (m.count / maxCount) * barPH;
    const y = barPT + barPH - h;
    barSvgParts.push(`<rect x="${cx - bw / 2}" y="${y}" width="${bw}" height="${h}" rx="3" fill="var(--color-primary-container)"/>`);
    barSvgParts.push(`<text x="${cx}" y="${y - 6}" text-anchor="middle" style="font-family:var(--font-label-sm);font-size:11px;fill:var(--color-on-surface-variant)">${m.count}</text>`);
    barSvgParts.push(`<text x="${cx}" y="${barPT + barPH + 20}" text-anchor="middle" style="font-family:var(--font-label-sm);font-size:11px;fill:var(--color-on-surface-variant)">${monthNamesDE[m.month]}</text>`);
  });
  for (let t = 0; t <= maxCount; t++) {
    const y = barPT + barPH - (t / maxCount) * barPH;
    barSvgParts.push(`<line x1="${barPL}" y1="${y}" x2="${svgW - barPR}" y2="${y}" stroke="var(--color-outline)" stroke-opacity="0.2" stroke-width="1"/>`);
    barSvgParts.push(`<text x="${barPL - 8}" y="${y + 4}" text-anchor="end" style="font-family:var(--font-label-sm);font-size:10px;fill:var(--color-on-surface-variant)">${t}</text>`);
  }
}

const trendW = 880;
const trendH = 300;
const tPL = 52;
const tPR = 20;
const tPT = 24;
const tPB = 48;
const tPW = trendW - tPL - tPR;
const tPH = trendH - tPT - tPB;

const trendSvgParts: string[] = [];
if (trend.length > 0) {
  const weights = trend.map((c: any) => Number(c.weight_kg));
  const wMin = Math.max(0, Math.floor(Math.min(...weights) - 1));
  const wMax = Math.ceil(Math.max(...weights) + 1);
  const wRange = wMax - wMin || 1;

  const gridSteps = 5;
  for (let i = 0; i <= gridSteps; i++) {
    const val = wMin + (wRange / gridSteps) * i;
    const y = tPT + tPH - ((val - wMin) / wRange) * tPH;
    trendSvgParts.push(`<line x1="${tPL}" y1="${y}" x2="${trendW - tPR}" y2="${y}" stroke="var(--color-outline)" stroke-opacity="0.25" stroke-width="1"/>`);
    trendSvgParts.push(`<text x="${tPL - 8}" y="${y + 4}" text-anchor="end" style="font-family:var(--font-label-sm);font-size:10px;fill:var(--color-on-surface-variant)">${fmtWeight(val)}</text>`);
  }

  const n = trend.length;
  const labelEvery = n <= 10 ? 1 : Math.ceil(n / 6);
  const points: string[] = [];
  trend.forEach((c: any, i: number) => {
    const x = n <= 1 ? tPL + tPW / 2 : tPL + (tPW / (n - 1)) * i;
    const y = tPT + tPH - ((Number(c.weight_kg) - wMin) / wRange) * tPH;
    points.push(`${x},${y}`);
    trendSvgParts.push(`<circle cx="${x}" cy="${y}" r="3.5" fill="var(--color-primary)"/>`);
    if (i % labelEvery === 0 || i === n - 1) {
      trendSvgParts.push(`<text x="${x}" y="${tPT + tPH + 20}" text-anchor="middle" style="font-family:var(--font-label-sm);font-size:10px;fill:var(--color-on-surface-variant)">${fmtDateShort(c.catch_ts)}</text>`);
    }
  });
  trendSvgParts.unshift(`<polyline points="${points.join(" ")}" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>`);
}
---

<Layout title="Carp24 – Dashboard" active="statistik" noindex>
  <main class="flex-grow px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto w-full py-xl flex flex-col gap-xl">
    {loadError && (
      <div class="text-red-700 bg-red-50 border border-red-200 rounded-lg px-lg py-md">{loadError}</div>
    )}
    {!session ? (
      <div class="text-center py-24">
        <h1 class="text-display-lg text-primary mb-4 i18n" data-de={t("dashboard.titel", "de")} data-en={t("dashboard.titel", "en")}>{t("dashboard.titel")}</h1>
        <p class="text-body-lg text-on-surface-variant mb-8 i18n" data-de={t("faenge.anmelden_text", "de")} data-en={t("faenge.anmelden_text", "en")}>{t("faenge.anmelden_text")}</p>
        <a href="/login" class="bg-primary-container text-on-primary-container font-nav-item text-nav-item uppercase tracking-widest px-6 py-3 rounded-full min-h-12 i18n" data-de={t("faenge.anmelden", "de")} data-en={t("faenge.anmelden", "en")}>{t("faenge.anmelden")}</a>
      </div>
    ) : catches.length === 0 ? (
      <div class="text-center py-24 flex flex-col items-center gap-lg">
        <div class="w-32 h-32 rounded-full border-2 border-primary/40 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#7B9496" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 12c5-2 12-4 14-9.5-5.5 2-9 6.5-10.5 10-1 2-2 5-4 6.5.5-3 1-5 .5-7z"/></svg>
        </div>
        <h2 class="text-display-md text-primary i18n" data-de={t("dashboard.keine_faenge", "de")} data-en={t("dashboard.keine_faenge", "en")}>{t("dashboard.keine_faenge")}</h2>
        <p class="text-body-lg text-on-surface-variant max-w-md i18n" data-de={t("dashboard.keine_faenge_text", "de")} data-en={t("dashboard.keine_faenge_text", "en")}>{t("dashboard.keine_faenge_text")}</p>
        <a href="/fang-erfassen" class="bg-primary text-on-primary font-nav-item text-nav-item uppercase tracking-widest px-8 py-4 rounded-full min-h-12 i18n" data-de={t("dashboard.ersten_eintragen", "de")} data-en={t("dashboard.ersten_eintragen", "en")}>{t("dashboard.ersten_eintragen")}</a>
      </div>
    ) : (
      <>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
          <div>
            <h1 class="text-display-lg text-primary mb-2 i18n" data-de={t("dashboard.begruessung", "de")} data-en={t("dashboard.begruessung", "en")}>{t("dashboard.begruessung")}</h1>
            <p class="text-body-lg text-on-surface-variant i18n" data-de={t("dashboard.ueberblick_saison", "de").replace("{year}", String(currentYear))} data-en={t("dashboard.ueberblick_saison", "en").replace("{year}", String(currentYear))}>{t("dashboard.ueberblick_saison").replace("{year}", String(currentYear))}</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/fang-erfassen" class="bg-primary-container text-on-primary-container px-6 py-3 rounded-full font-nav-item text-nav-item uppercase tracking-widest hover:bg-surface-tint transition-colors duration-200 flex items-center gap-2 min-h-12">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              <span class="i18n" data-de={t("dashboard.neuer_fang", "de")} data-en={t("dashboard.neuer_fang", "en")}>{t("dashboard.neuer_fang")}</span>
            </a>
            <a href="/statistik" class="border border-primary/40 text-primary rounded-full px-6 py-3 font-nav-item text-nav-item uppercase tracking-widest hover:bg-primary hover:text-white transition-colors min-h-12 flex items-center i18n" data-de={t("dashboard.statistik_studio", "de")} data-en={t("dashboard.statistik_studio", "en")}>
              {t("dashboard.statistik_studio")}
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
          <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
            <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest i18n" data-de={t("dashboard.gesamt_faenge", "de")} data-en={t("dashboard.gesamt_faenge", "en")}>{t("dashboard.gesamt_faenge")}</span>
            <span class="text-display-lg text-primary">{total}</span>
          </div>
          <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
            <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest i18n" data-de={t("dashboard.schwerster", "de")} data-en={t("dashboard.schwerster", "en")}>{t("dashboard.schwerster")}</span>
            <span class="text-display-lg text-primary">{heaviest ? fmtWeight(Number(heaviest.weight_kg)) : "–"}<span class="text-headline-md"> KG</span></span>
          </div>
          <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
            <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest i18n" data-de={t("dashboard.faenge_jahr", "de")} data-en={t("dashboard.faenge_jahr", "en")}>{t("dashboard.faenge_jahr")}</span>
            <span class="text-display-lg text-primary">{thisYear}</span>
          </div>
          <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col justify-between min-h-32">
            <span class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest i18n" data-de={t("dashboard.aktive_gewaesser", "de")} data-en={t("dashboard.aktive_gewaesser", "en")}>{t("dashboard.aktive_gewaesser")}</span>
            <span class="text-display-lg text-primary">{activeWaters}</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
          <div class="lg:col-span-2 bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col">
            <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4 i18n" data-de={t("dashboard.faenge_monat", "de")} data-en={t("dashboard.faenge_monat", "en")}>{t("dashboard.faenge_monat")}</h3>
            {monthly.length > 0 && maxCount > 0 ? (
              <svg viewBox={`0 0 ${svgW} ${svgH}`} class="w-full h-auto" style="min-height:260px" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Balkendiagramm Fänge pro Monat" set:html={barSvgParts.join("")} />
            ) : (
              <div class="flex items-center justify-center text-on-surface-variant text-body-md py-12 i18n" data-de={t("dashboard.keine_monatsdaten", "de")} data-en={t("dashboard.keine_monatsdaten", "en")}>{t("dashboard.keine_monatsdaten")}</div>
            )}
          </div>

          <div class="lg:col-span-1 bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col">
            <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4 i18n" data-de={t("dashboard.top_faenge", "de")} data-en={t("dashboard.top_faenge", "en")}>{t("dashboard.top_faenge")}</h3>
            <div class="flex flex-col">
              {top5.map((c: any, i: number) => (
                <div class={`flex items-start gap-4 p-4 ${i < top5.length - 1 ? 'border-b border-primary/20' : ''}`}>
                  <div class="flex flex-col">
                    <span class="font-mono text-display-sm text-primary font-bold">{fmtWeight(Number(c.weight_kg))} KG</span>
                    <span class="font-nav-item text-label-sm text-on-surface-variant uppercase">{speciesDE[c.species] || c.species || '–'}</span>
                    <span class="font-body-md text-label-sm text-[#7B9496]">{c.water_name || '–'}{c.catch_ts ? ` • ${fmtDateShort(c.catch_ts)}` : ''}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="bg-surface-container-high border border-primary/40 rounded-2xl p-lg flex flex-col">
          <h3 class="font-nav-item text-nav-item text-primary-container uppercase tracking-widest mb-4 i18n" data-de={t("dashboard.gewichtsverlauf", "de")} data-en={t("dashboard.gewichtsverlauf", "en")}>{t("dashboard.gewichtsverlauf")}</h3>
          {trend.length > 0 ? (
            <svg viewBox={`0 0 ${trendW} ${trendH}`} class="w-full h-auto" style="min-height:300px" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Liniendiagramm Gewichtsverlauf" set:html={trendSvgParts.join("")} />
          ) : (
            <div class="flex items-center justify-center text-on-surface-variant text-body-md py-12 i18n" data-de={t("dashboard.keine_gewichtsdaten", "de")} data-en={t("dashboard.keine_gewichtsdaten", "en")}>{t("dashboard.keine_gewichtsdaten")}</div>
          )}
        </div>
      </>
    )}
  </main>
</Layout>
