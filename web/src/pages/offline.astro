---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carp24 – Offline" bare>
  <!-- offline-fallback-page -->
  <div class="flex flex-col items-center justify-center text-center py-24 px-4 min-h-screen">
    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-on-surface-variant mb-6">
      <path d="M1 1l22 22"/>
      <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/>
      <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/>
      <path d="M10.71 5.05A16 16 0 0 1 22.58 9"/>
      <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/>
      <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
      <circle cx="12" cy="20" r="1"/>
    </svg>
    <h1 class="text-headline-lg text-on-surface mb-4">OFFLINE</h1>
    <p class="text-body-lg text-on-surface-variant max-w-md mb-4">Keine Verbindung zum Netzwerk. Deine Fänge werden lokal gespeichert und später synchronisiert.</p>
    <p class="text-body-md text-on-surface-variant max-w-md mb-8">Offline erfasste Fänge warten in der Warteschlange.</p>
    <div class="flex flex-col sm:flex-row gap-4">
      <button onclick="location.reload()" class="border border-primary/40 text-on-surface font-nav-item text-nav-item uppercase tracking-widest rounded-full px-8 py-4 min-h-12 cursor-pointer">ERNEUT VERSUCHEN</button>
      <a href="/faenge" class="bg-primary text-white font-nav-item text-nav-item uppercase tracking-widest rounded-full px-8 py-4 min-h-12 flex items-center justify-center">ZUM FANGBUCH</a>
    </div>
  </div>
</Layout>
